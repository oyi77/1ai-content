# ==========================================
# 1AI CONTENT FACTORY - PRODUCTION CONFIG
# ==========================================

# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username
WEBHOOK_URL=https://api-saas.aitradepulse.com/webhook/telegram
WEB_APP_URL=https://your-domain.com
PORT=3000
NODE_ENV=production

# Admin panel auth — REQUIRED by src/config/env.ts (zod, min length 1)
ADMIN_PASSWORD=
# JWT signing secret — REQUIRED by src/config/env.ts (zod, min length 32)
JWT_SECRET=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/1ai_content
REDIS_URL=redis://localhost:6379

# ==========================================
# VIDEO GENERATION PROVIDERS (9-Tier Fallback)
# ==========================================

# Tier 1: Primary - BytePlus Seedance
BYTEPLUS_API_KEY=bp_live_xxxxxxxxxxxxxxxx
BYTEPLUS_TIMEOUT=30000

# Tier 2: Fallback 1 - XAI Grok Aurora
XAI_API_KEY=xai_live_xxxxxxxxxxxxxxxx
XAI_TIMEOUT=25000

# Tier 3: Fallback 2 - LaoZhang
LAOZHANG_API_KEY=lz_xxxxxxxxxxxxxxxx
LAOZHANG_TIMEOUT=35000

# Tier 4: Fallback 3 - EvoLink
EVOLINK_API_KEY=evo_xxxxxxxxxxxxxxxx
EVOLINK_TIMEOUT=40000

# Tier 5: Fallback 4 - Hypereal
HYPEREAL_API_KEY=hyp_xxxxxxxxxxxxxxxx
HYPEREAL_TIMEOUT=35000

# Tier 6: Fallback 5 - SiliconFlow
SILICONFLOW_API_KEY=sf_xxxxxxxxxxxxxxxx
SILICONFLOW_TIMEOUT=30000

# Tier 7: Fallback 6 - Fal.ai Video
FALAI_VIDEO_KEY=fal_live_xxxxxxxxxxxxxxxx
FALAI_VIDEO_TIMEOUT=45000

# Tier 8: Fallback 7 - Kie.ai
KIE_API_KEY=kie_xxxxxxxxxxxxxxxx
KIE_TIMEOUT=50000

# Together.ai (Image - FLUX Schnell, cheapest text2img)
TOGETHER_API_KEY=key_xxxxxxxxxxxxxxxx

# PiAPI (Image + Video - Flux Dev, Kling, Midjourney)
PIAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# D-ID (Talking Photo / Lip Sync)
D_ID_API_KEY=your_d_id_api_key_here

# Tier 9: Last Resort - Local Remotion
REMOTION_ENABLED=true
FFMPEG_PATH=/usr/bin/ffmpeg

# ==========================================
# IMAGE GENERATION PROVIDERS (untuk /skip)
# ==========================================

# Tier 1: Primary - GeminiGen
GEMINIGEN_API_KEY=gem_xxxxxxxxxxxxxxxx
GEMINIGEN_TIMEOUT=20000

# Tier 2: Fallback - NVIDIA Flux
NVIDIA_API_KEY=nvda_xxxxxxxxxxxxxxxx
NVIDIA_TIMEOUT=15000

# Tier 3: Fallback - Fal.ai Image
FALAI_IMAGE_KEY=fal_img_xxxxxxxxxxxxxxxx
FALAI_IMAGE_TIMEOUT=25000

# ==========================================
# AI PROMPT MODELS
# ==========================================

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
GEMINI_API_KEY=gemini-xxxxxxxxxxxxxxxx

# ==========================================
# CIRCUIT BREAKER & FALLBACK
# ==========================================

CIRCUIT_BREAKER_THRESHOLD=3
MAX_PROVIDER_RETRY=2
FALLBACK_CHAIN_MAX=8

# ==========================================
# QUEUE CONFIGURATION
# ==========================================

BULLMQ_CONCURRENCY=5
VIDEO_QUEUE_NAME=video-generation
IMAGE_QUEUE_NAME=image-generation

# ==========================================
# UNIFIED PAYMENT GATEWAY (1ai-payment)
# ==========================================

# 1ai-payment API endpoint (localhost for development, https://pay.1ai.dev for production)
1AI_PAYMENT_URL=http://localhost:3100

# 1ai-payment API key for authentication with /api/payments endpoints
1AI_PAYMENT_API_KEY=test-key

# 1ai-payment webhook secret for signature verification (HMAC-SHA256)
1AI_PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# LEGACY GATEWAY CREDENTIALS (deprecated — migrate to 1ai-payment)
# ==========================================

MIDTRANS_ENVIRONMENT=production
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx

TRIPAY_API_KEY=xxxxxxxxxxxxxxxx
TRIPAY_PRIVATE_KEY=xxxxxxxxxxxxxxxx
TRIPAY_MERCHANT_CODE=Txxxxxxxx

DUITKU_MERCHANT_CODE=Dxxxxxxxx
DUITKU_API_KEY=xxxxxxxxxxxxxxxx

# NOWPayments Crypto
NOWPAYMENTS_API_KEY=your_nowpayments_api_key

# Telegram Stars (no token needed, Stars uses empty provider_token)
# Stars are enabled automatically when provider_token is empty string

# ==========================================
# POST-BRIDGE SOCIAL INTEGRATION
# ==========================================

POSTBRIDGE_API_KEY=pb_xxxxxxxxxxxxxxxx

# ==========================================
# FEATURE FLAGS
# ==========================================

DEMO_MODE=false

# ==========================================
# ANALYTICS & TRACKING PIXELS
# ==========================================

FACEBOOK_PIXEL_ID=your_fb_pixel_id
GA4_TRACKING_ID=G-XXXXXXXXXX
TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# ==========================================
# EBOOK GENERATION (absorbed into media-api :8767)
# ==========================================

# DEPRECATED alias — ebook generation is now part of media-api (services/api.py, :8767).
# Same backend as CONTENT_FACTORY_URL. Default: http://localhost:8767
EBOOK_API_URL=http://localhost:8767

# Media/Content Factory API (services/run_api.py, port 8767).
# Serves /audio/*, /text/*, /image/*, /video/*, /text/ebook, etc.
CONTENT_FACTORY_URL=http://localhost:8767

# Optional API key if the media-api service requires authentication
EBOOK_API_KEY=

# OmniRoute AI Router (multi-provider LLM routing, local dev default)
OMNIROUTE_URL=http://localhost:20128/v1

# VidBee self-hosted downloader (services/download cascade provider; see services/download/AGENTS.md)
VIDBEE_URL=http://localhost:3101

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=info
LOG_FILE=/var/log/1ai-content/app.log

# ==========================================
# 4K/60FPS VIDEO PROVIDERS (NEW - 2026)
# ==========================================

# Tier 0: Google Veo 3.1 (4K, Audio Sync)
# Best for: Cinematic 16:9, high-end branding
# Pricing: $0.03–$0.50/sec
VEO_API_KEY=your_google_ai_api_key
VEO_API_URL=https://generativelanguage.googleapis.com/v1beta
VEO_MODEL=veo-3.1
VEO_MAX_DURATION=60
VEO_SUPPORTS_4K=true

# Tier 0: Kling AI 3.0 (60fps, Realistic Motion)
# Best for: Social media, vertical content, budget-friendly
# Pricing: Credit-based
KLING_API_KEY=your_kling_api_key
KLING_API_URL=https://api.klingai.com/v1
KLING_MODEL=kling-3.0
KLING_MAX_DURATION=120
KLING_SUPPORTS_60FPS=true

# ==========================================
# AUDIO GENERATION (ElevenLabs TTS)
# ==========================================

# Enable audio generation for videos
AUDIO_GENERATION_ENABLED=false

# ElevenLabs API
# Pricing: $0.30/1K characters (standard), $0.24/1K (scale)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_API_URL=https://api.elevenlabs.io/v1

# Default voice (Rachel - warm, professional)
# Get voice IDs: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ==========================================
# ECOSYSTEM INTEGRATION
# ==========================================

# Inter-service authentication (shared between 1ai-content, 1ai-social, 1ai-affiliate)
ECOSYSTEM_API_KEY=your_ecosystem_api_key_here

# 1ai-social service
SOCIAL_SERVICE_URL=http://127.0.0.1:8200
SOCIAL_SERVICE_KEY=your_ecosystem_api_key_here

# 1ai-affiliate service
AFFILIATE_SERVICE_URL=http://127.0.0.1:3001
AFFILIATE_SERVICE_KEY=your_ecosystem_api_key_here

# Tracking URL (for affiliate links)
TRACKING_URL=https://track.aitradepulse.com