<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f0f23; color: #e0e0e0; padding: 24px; }
    h1 { color: #ff4757; margin-bottom: 24px; }
    .stats { display: flex; gap: 16px; margin-bottom: 24px; }
    .stat-card { background: #1a1a2e; border: 1px solid #333; border-radius: 8px; padding: 16px; min-width: 150px; }
    .stat-value { font-size: 28px; font-weight: bold; color: #ff6b81; }
    .stat-label { font-size: 12px; color: #888; margin-top: 4px; }
    table { width: 100%; border-collapse: collapse; background: #1a1a2e; border-radius: 8px; overflow: hidden; }
    th { background: #16213e; color: #ff4757; padding: 12px 16px; text-align: left; font-size: 12px; text-transform: uppercase; }
    td { padding: 10px 16px; border-bottom: 1px solid #222; font-size: 14px; }
    tr:hover td { background: #16213e; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; }
    .badge-monitoring { background: #2ed573; color: #000; }
    .badge-breakout { background: #ff4757; color: #fff; }
    .badge-quarantine { background: #ffa502; color: #000; }
    .badge-deleted { background: #555; color: #aaa; }
    .badge-growing { background: #1e90ff; color: #fff; }
  </style>
</head>
<body>
  <h1>📺 <%= title %></h1>

  <div class="stats">
    <div class="stat-card">
      <div class="stat-value"><%= channels.length %></div>
      <div class="stat-label">Active Channels</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= totalVideos %></div>
      <div class="stat-label">Total Videos</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= quarantined %></div>
      <div class="stat-label">In Quarantine</div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Channel ID</th>
        <th>Niche</th>
        <th>Format</th>
        <th>Tier</th>
        <th>Status</th>
        <th>Videos</th>
        <th>Age (days)</th>
      </tr>
    </thead>
    <tbody>
      <% channels.forEach(ch => { %>
      <tr>
        <td><code><%= ch.channelId %></code></td>
        <td><%= ch.nicheVertical %></td>
        <td><%= ch.productionFormat %></td>
        <td><%= ch.tier %></td>
        <td><span class="badge badge-<%= ch.trafficStatus %>"><%= ch.trafficStatus %></span></td>
        <td><%= ch.totalPublished %></td>
        <td><%= ch.channelAgeDays %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>
