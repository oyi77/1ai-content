<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BerkahKarya — Dashboard</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="manifest" href="/manifest.json">
  <link rel="stylesheet" href="/public/design-system.css">
  <style>
    :root {
      /* Public color overrides (base tokens in design-system.css) */
      --color-bg: #0a0a1a;
      --color-bg-elevated: #111127;
      --color-card: rgba(255,255,255,0.04);
      --color-card-hover: rgba(255,255,255,0.08);
      --color-border: rgba(255,255,255,0.08);
      --color-border-strong: rgba(255,255,255,0.15);
      --color-green: #22c55e;
      --color-red: #ef4444;
      --color-yellow: #fbbf24;
      --color-blue: #3b82f6;
      --color-pink: #ec4899;
      --color-text: #f1f5f9;
      --color-dim: rgba(255,255,255,0.55);
      --color-muted: rgba(255,255,255,0.35);
      --sidebar-w: 240px;

      /* Legacy aliases not yet in design-system.css */
      --bg2: var(--color-bg-elevated);
      --accent2: var(--color-accent-2);
      --danger: var(--color-red);
      --warn: var(--color-yellow);
      --ok: var(--color-green);
    }
    
    /* Surface-specific overrides for design system */
    .btn-primary {
      background: var(--color-grad);
      color: #0a0a1a;
      box-shadow: var(--shadow-glow);
    }
    .btn-primary:hover:not(.btn-disabled):not(:disabled) {
      background: var(--color-grad-hover);
      transform: translateY(-1px);
      box-shadow: var(--shadow-glow-hover);
    }
    .btn-primary:active:not(.btn-disabled):not(:disabled) {
      transform: translateY(0) scale(0.98);
    }
    
    .btn-outline {
      background: transparent;
      color: var(--color-text);
      border: 1px solid var(--color-border);
    }
    .btn-outline:hover:not(.btn-disabled):not(:disabled) {
      background: var(--color-card-hover);
      border-color: var(--color-accent);
    }
    
    .btn-ghost {
      background: transparent;
      color: var(--color-text);
      border: 1px solid transparent;
    }
    .btn-ghost:hover:not(.btn-disabled):not(:disabled) {
      background: var(--color-card);
    }
    
    .btn-secondary {
      background: var(--color-card);
      color: var(--color-text);
      border: 1px solid var(--color-border);
    }
    .btn-secondary:hover:not(.btn-disabled):not(:disabled) {
      background: var(--color-card-hover);
      border-color: var(--color-border-strong);
    }
    
    .btn-danger {
      background: rgba(239,68,68,0.15);
      color: var(--color-red);
      border: 1px solid rgba(239,68,68,0.2);
    }
    .btn-danger:hover:not(.btn-disabled):not(:disabled) {
      background: var(--color-red);
      color: #fff;
      border-color: var(--color-red);
    }
    
    .input {
      background: var(--color-bg-elevated);
      border-color: var(--color-border);
    }
    .input:focus {
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px rgba(168,85,247,0.15);
    }
    
    .chip {
      background: var(--color-card);
      border-color: var(--color-border);
      color: var(--color-dim);
    }
    .chip:hover {
      border-color: var(--color-accent);
      background: rgba(168,85,247,0.1);
      color: var(--color-accent);
    }
    .chip.active {
      background: var(--color-accent);
      color: #fff;
      border-color: var(--color-accent);
    }
    
    .card {
      background: var(--color-card);
      border-color: var(--color-border);
      border-radius: var(--radius);
    }
    .card:active {
      background: var(--color-card-hover);
      transform: scale(0.98);
    }
    
    .stat { background: var(--color-card); border-color: var(--color-border); }
    .stat .value { 
      background: var(--color-grad); 
      -webkit-background-clip: text; 
      background-clip: text; 
      -webkit-text-fill-color: transparent; 
    }
    
    .action-btn { background: var(--color-card); border-color: var(--color-border); }
    .action-btn:active { transform: scale(0.95); background: var(--color-card-hover); }
    
    .nav-item.active { color: var(--color-accent); }
    
    .progress-bar .fill { background: var(--color-grad); }
    
    .generating { animation: pulse-ring 1.5s ease-out infinite; }
    
    @keyframes pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(168,85,247,0.4); }
      70% { box-shadow: 0 0 0 10px rgba(168,85,247,0); }
      100% { box-shadow: 0 0 0 0 rgba(168,85,247,0); }
    }
    
    .empty .title { color: var(--color-text); }
    .empty .desc { color: var(--color-muted); }
    
    .modal { background: var(--color-bg-elevated); border-color: var(--color-border); }
    .modal-handle { background: var(--color-border); }
    .modal-close:hover { background: var(--color-card); color: var(--color-text); }
    
    /* Focus visible for all interactive elements */
    :focus-visible {
      outline: 2px solid var(--color-accent);
      outline-offset: 2px;
    }
    
    
    /* Version badge */
    #version-badge { z-index: 999; }
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;flex-direction:column}
    a{color:inherit;text-decoration:none}

    /* LAYOUT */
    .app{display:flex;flex:1;min-height:100vh}
    .sidebar{width:var(--sidebar-w);background:rgba(0,0,0,0.25);border-right:1px solid var(--border);padding:20px 0;display:flex;flex-direction:column;position:fixed;top:0;bottom:0;left:0;overflow-y:auto;z-index:50}
    .sidebar-logo{padding:0 20px 24px;font-size:18px;font-weight:800;background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;border-bottom:1px solid var(--border);margin-bottom:12px}
    .nav-item{display:flex;align-items:center;gap:10px;padding:11px 20px;color:var(--dim);cursor:pointer;transition:all .2s;font-size:14px;font-weight:500;border-left:3px solid transparent}
    .nav-item:hover{color:var(--text);background:rgba(255,255,255,0.03)}
    .nav-item.active{color:var(--accent);border-left-color:var(--accent);background:rgba(168,85,247,0.05)}
    .sidebar-bottom{margin-top:auto;padding:16px 20px;border-top:1px solid var(--border)}
    .credits-pill{background:var(--grad);color:#0a0a1a;padding:8px 16px;border-radius:20px;font-weight:700;font-size:13px;display:inline-block;cursor:pointer;white-space:nowrap}

    .main{margin-left:var(--sidebar-w);flex:1;padding:32px;min-height:100vh}
    .page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}
    .page-title{font-size:24px;font-weight:800}
    .user-greeting{font-size:13px;color:var(--dim)}

    /* VIEWS */
    .view{display:none;animation:fadeIn .25s ease}
    .view.active{display:block}
    @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

    /* CARDS */
    .card{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:24px}
    .grid-2, .grid-3, .grid-4 { display: grid; gap: 16px; }
    .grid-2 { grid-template-columns: repeat(2, 1fr); }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    .grid-4 { grid-template-columns: repeat(4, 1fr); }

    @media(max-width: 1024px) {
      .grid-4 { grid-template-columns: repeat(3, 1fr); }
    }
    @media(max-width: 768px) {
      .grid-4 { grid-template-columns: repeat(2, 1fr); }
      .grid-3 { grid-template-columns: repeat(2, 1fr); }
    }
    @media(max-width: 480px) {
      .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
    }

    /* STATS CARDS */
    .stat-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px}
    .stat-card .label{font-size:12px;color:var(--dim);margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px}
    .stat-card .value{font-size:28px;font-weight:800;background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
    .stat-card .sub{font-size:12px;color:var(--dim);margin-top:4px}

    /* ACTION CARDS */
    .action-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px;text-align:center;cursor:pointer;transition:all .25s}
    .action-card:hover{background:rgba(255,255,255,0.07);transform:translateY(-3px);border-color:rgba(168,85,247,0.25)}
    .action-card .icon{font-size:28px;margin-bottom:10px}
    .action-card h3{font-size:14px;font-weight:600}

    /* FORM */
    .form-group{margin-bottom:20px}
    .form-label{display:block;font-size:13px;color:var(--dim);margin-bottom:8px;font-weight:500}
    input,select,textarea{width:100%;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:12px;padding:12px 16px;color:var(--text);font-family:inherit;font-size:14px;transition:border-color .2s;outline:none}
    input:focus,select:focus,textarea:focus{border-color:var(--accent)}
    textarea{resize:vertical;min-height:90px}
    select option{background:#111127}

    /* BUTTONS */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:11px 22px;border-radius:12px;font-size:14px;font-weight:600;border:none;cursor:pointer;transition:all .25s;text-decoration:none}
    .btn-primary{background:var(--grad);color:#0a0a1a}
    .btn-primary:hover{transform:translateY(-1px);box-shadow:0 6px 24px rgba(168,85,247,0.3)}
    .btn-primary:disabled{opacity:.5;cursor:not-allowed;transform:none;box-shadow:none}
    .btn-outline{background:transparent;color:var(--text);border:1px solid var(--border)}
    .btn-outline:hover{background:var(--card);border-color:var(--accent)}
    .btn-danger{background:rgba(255,71,87,0.1);color:var(--danger);border:1px solid rgba(255,71,87,0.2)}
    .btn-sm{padding:7px 14px;font-size:12px;border-radius:8px}
    .btn-full{width:100%}

    /* NICHE GRID */
    .niche-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px}
    .niche-btn{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:16px 10px;text-align:center;cursor:pointer;transition:all .2s;font-size:13px;font-weight:600}
    .niche-btn:hover{border-color:var(--accent);background:rgba(168,85,247,0.05)}
    .niche-btn.selected{border-color:var(--accent);background:rgba(168,85,247,0.12);color:var(--accent)}
    .niche-btn .ni{font-size:24px;display:block;margin-bottom:6px}

    /* STYLE CHIPS */
    .chip-group{display:flex;gap:10px;flex-wrap:wrap}
    .chip{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:8px 18px;font-size:13px;font-weight:500;cursor:pointer;transition:all .2s}
    .chip:hover{border-color:var(--accent)}
    .chip.selected{background:rgba(168,85,247,0.12);border-color:var(--accent);color:var(--accent)}

    /* DURATION BUTTONS */
    .dur-group{display:flex;gap:10px;flex-wrap:wrap}
    .dur-btn{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:10px 20px;font-size:14px;font-weight:600;cursor:pointer;transition:all .2s}
    .dur-btn:hover{border-color:var(--accent)}
    .dur-btn.selected{background:rgba(168,85,247,0.12);border-color:var(--accent);color:var(--accent)}

    /* STEPS */
    .step-indicator{display:flex;gap:6px;margin-bottom:28px}
    .step-dot{width:28px;height:4px;background:var(--border);border-radius:2px;transition:background .3s}
    .step-dot.done{background:var(--accent)}
    .step-header{font-size:18px;font-weight:700;margin-bottom:6px}
    .step-sub{font-size:13px;color:var(--dim);margin-bottom:20px}

    /* SCENES */
    .scene-card{background:rgba(0,0,0,0.2);border:1px solid var(--border);border-radius:12px;padding:14px 18px;margin-bottom:8px}
    .scene-card .scene-num{font-size:11px;color:var(--accent);font-weight:600;text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
    .scene-card p{font-size:14px;color:var(--dim);line-height:1.5}

    /* VIDEO CARDS */
    .video-card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:all .25s}
    .video-card:hover{transform:translateY(-3px);box-shadow:0 8px 30px rgba(0,0,0,0.3)}
    .video-thumb{background:linear-gradient(135deg,#111,#1a1a2e);aspect-ratio:9/16;display:flex;align-items:center;justify-content:center;font-size:40px;max-height:180px;overflow:hidden;position:relative}
    .video-thumb video{width:100%;height:100%;object-fit:cover}
    .video-info{padding:14px}
    .video-title{font-size:13px;font-weight:600;margin-bottom:6px}
    .video-meta{font-size:12px;color:var(--dim);margin-bottom:10px}

    /* PRICING */
    .price-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}
    .price-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:24px;transition:all .3s;position:relative}
    .price-card.popular{border-color:var(--accent)}
    .popular-tag{position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:var(--grad);color:#0a0a1a;padding:4px 16px;border-radius:20px;font-size:11px;font-weight:700;white-space:nowrap}
    .price-card h3{font-size:16px;font-weight:700}
    .price-card .price{font-size:26px;font-weight:800;margin:12px 0 4px}
    .price-card .cred{font-size:13px;color:var(--dim);margin-bottom:16px}
    .price-card .btn{width:100%;margin-top:8px}

    /* TRANSACTIONS */
    .txn-table{width:100%;border-collapse:collapse}
    .txn-table th{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;padding:8px 12px;text-align:left;border-bottom:1px solid var(--border)}
    .txn-table td{padding:12px;font-size:13px;border-bottom:1px solid rgba(255,255,255,0.04)}
    .txn-table tr:last-child td{border-bottom:none}

    /* LOADING */
    .skeleton{background:linear-gradient(90deg,rgba(255,255,255,0.04) 25%,rgba(255,255,255,0.08) 50%,rgba(255,255,255,0.04) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:8px}
    @keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
    .spinner{width:20px;height:20px;border:2px solid rgba(255,255,255,0.2);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;display:inline-block}
    @keyframes spin{to{transform:rotate(360deg)}}
    .loading-overlay{position:fixed;inset:0;background:rgba(10,10,26,0.85);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:999;gap:16px}
    .loading-overlay .big-spinner{width:48px;height:48px;border-width:4px}
    .loading-overlay p{color:var(--dim);font-size:14px}

    /* TOAST */
    #toast{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none}
    .toast-msg{background:#1a1a2e;border:1px solid var(--border);border-radius:12px;padding:12px 18px;font-size:13px;font-weight:500;opacity:0;transform:translateY(12px);transition:all .3s;pointer-events:auto;max-width:300px;display:flex;align-items:center;gap:8px}
    .toast-msg.show{opacity:1;transform:translateY(0)}
    .toast-ok{border-color:var(--ok);color:var(--ok)}
    .toast-err{border-color:var(--danger);color:var(--danger)}
    .toast-info{border-color:var(--accent);color:var(--accent)}

    /* EMPTY STATE */
    .empty{text-align:center;padding:60px 20px;color:var(--dim)}
    .empty .icon{font-size:48px;margin-bottom:16px}
    .empty h3{font-size:16px;font-weight:600;margin-bottom:8px;color:var(--text)}

    /* PROGRESS BAR */
    .progress-bar{height:6px;background:rgba(255,255,255,0.08);border-radius:3px;overflow:hidden;margin:12px 0}
    .progress-fill{height:100%;background:var(--grad);border-radius:3px;transition:width .4s ease}

    /* VIDEO GRID */
    .video-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:16px}

    /* TABLET BREAKPOINT */
    @media(max-width:1024px) and (min-width:769px){
      .sidebar{width:200px}
      .main{margin-left:200px}
    }

    /* MOBILE */
    @media(max-width:768px){
      .sidebar{display:none}
      .main{margin-left:0;padding:16px;padding-bottom:100px}
      .mobile-nav{display:flex!important}
      .page-header{margin-bottom:20px}
      .page-title{font-size:20px}
      .stat-card .value{font-size:22px}
    }
    .mobile-nav{display:none;position:fixed;bottom:0;left:0;right:0;background:#111127;border-top:1px solid var(--border);z-index:100;padding:8px 0}
    .mobile-nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;cursor:pointer;color:var(--dim);font-size:12px;font-weight:500;padding:12px 4px;transition:color .2s}
    .mobile-nav-item.active{color:var(--accent)}
    .mobile-nav-item .mni{font-size:22px}
  </style>
</head>
<body>
<div id="loading-overlay" class="loading-overlay"><div class="spinner big-spinner"></div><p id="loading-text">Memuat...</p></div>
<div id="toast"></div>

<div class="app" id="app" style="display:none">
  <%- include('partials/sidebar') %>

  <!-- Main -->
  <main class="main">
    <div class="page-header">
      <div>
        <div class="page-title" id="page-title">Dashboard</div>
        <div class="user-greeting" id="user-greeting">Selamat datang!</div>
      </div>
      <div id="header-credits" class="credits-pill" style="cursor:pointer" onclick="nav('billing')">⏳</div>
    </div>

    <%- include('partials/dashboard') %>
    <%- include('partials/view-create') %>
    <%- include('partials/view-videos') %>
    <%- include('partials/view-billing') %>
    <%- include('partials/view-subscription') %>
    <%- include('partials/view-referral') %>
    <%- include('partials/view-send') %>
    <%- include('partials/view-profile') %>
    <%- include('partials/view-settings') %>
    <%- include('partials/view-image') %>
  </main>
</div>

<!-- Mobile Bottom Nav -->
<div class="mobile-nav">
  <div class="mobile-nav-item active" onclick="nav('dashboard')" id="mnav-dashboard"><span class="mni">🏠</span>Home</div>
  <div class="mobile-nav-item" onclick="nav('create')" id="mnav-create"><span class="mni">🎬</span>Buat</div>
  <div class="mobile-nav-item" onclick="nav('videos')" id="mnav-videos"><span class="mni">📁</span>Video</div>
  <div class="mobile-nav-item" onclick="nav('billing')" id="mnav-billing"><span class="mni">💳</span>Billing</div>
</div>

<script>
const API = '';
let token = localStorage.getItem('token');
let currentUser = null;
let createState = { step: 1, niche: '', style: '', duration: 30, customPrompt: '', storyboard: null };
let pollInterval = null;

// ── UTILS ─────────────────────────────────────────────────
function esc(str) {
  if (!str) return '';
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

// ── AUTH ──────────────────────────────────────────────────
async function apiFetch(path, opts = {}) {
  const controller = new AbortController();
  const tid = setTimeout(() => controller.abort(), 15000);
  try {
    const res = await fetch(API + path, {
      ...opts,
      signal: controller.signal,
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token, ...(opts.headers || {}) },
    });
    clearTimeout(tid);
    if (!res.ok) return null;
    return await res.json();
  } catch(e) {
    clearTimeout(tid);
    return null;
  }
}

async function loadUser() {
  const u = await apiFetch('/api/user');
  if (!u) { window.location.href='/admin/login'; return; }
  currentUser = u;
  document.getElementById('user-greeting').textContent = 'Selamat datang, ' + u.firstName + '!';
  document.getElementById('stat-credits').textContent = u.credits || 0;
  document.getElementById('stat-videos').textContent = u.total_videos || 0;
  document.getElementById('stat-ref').textContent = u.refCode || '—';
  document.getElementById('stat-tier').textContent = u.tier || 'Free';
  document.getElementById('billing-credits').textContent = u.credits || 0;
  document.getElementById('header-credits').innerHTML = '⏳ ' + (u.credits || 0);
  document.getElementById('sidebar-credits').innerHTML = '⏳ ' + (u.credits || 0) + ' Credits';
  if (u.refCode) {
    document.getElementById('ref-link').value = window.location.origin + '/ref/' + u.refCode;
  }
  // referral stats
  document.getElementById('ref-tier1').textContent = u.refTier1 || 0;
  document.getElementById('ref-tier2').textContent = u.refTier2 || 0;
  document.getElementById('ref-tier3').textContent = u.refTier3 || 0;
  document.getElementById('ref-balance').textContent = 'IDR ' + (u.refBalance || 0).toLocaleString();
  // profile
  const pi = document.getElementById('profile-info');
  if (pi) pi.innerHTML = '<div style="margin-bottom:12px"><strong>Username:</strong> ' + esc(u.username) + '</div><div><strong>Nama:</strong> ' + esc(u.firstName) + '</div><div><strong>Language:</strong> ' + esc(u.language) + '</div><div><strong>Joined:</strong> ' + (u.createdAt ? new Date(u.createdAt).toLocaleDateString() : '—') + '</div>';
  // lang select
  const langs = ['settings-lang', 'edit-lang'];
  for (const id of langs) {
    const el = document.getElementById(id);
    if (el) el.value = u.language || 'id';
  }
  document.getElementById('settings-notif').value = u.notifications !== false ? '1' : '0';
  updateCreditsDisplay(u.credits);
}

function updateCreditsDisplay(credits) {
  document.getElementById('stat-credits').textContent = credits || 0;
  document.getElementById('billing-credits').textContent = credits || 0;
  document.getElementById('header-credits').innerHTML = '⏳ ' + (credits || 0);
  document.getElementById('sidebar-credits').innerHTML = '⏳ ' + (credits || 0) + ' Credits';
}

// ── NAVIGATION ────────────────────────────────────────────
const unitPricing = { IMAGE_UNIT: 25, VIDEO_15S: 100, VIDEO_30S: 150, VIDEO_60S: 250, VIDEO_120S: 400 };

// The page title map (for nav function)
const pageTitles = {
  dashboard: 'Dashboard',
  create: 'Buat Video',
  image: 'Buat Gambar AI',
  videos: 'Video Saya',
  billing: 'Billing',
  subscription: 'Langganan',
  referral: 'Referral',
  send: 'Kirim Saldo',
  profile: 'Profil',
  settings: 'Pengaturan'
};

function nav(page) {
  // hide all views
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  const view = document.getElementById('view-' + page);
  if (view) view.classList.add('active');

  // update title
  document.getElementById('page-title').textContent = pageTitles[page] || page;

  // update sidebar active
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const navItem = document.getElementById('nav-' + page);
  if (navItem) navItem.classList.add('active');

  // update mobile nav active
  document.querySelectorAll('.mobile-nav-item').forEach(n => n.classList.remove('active'));
  const mnav = document.getElementById('mnav-' + page);
  if (mnav) mnav.classList.add('active');

  // lazy loads
  if (page === 'videos') loadVideos();
  if (page === 'billing') loadPackages();
  if (page === 'subscription') loadSubscriptions();
}

// ── CREATE WIZARD ────────────────────────────────────────
const NICHES = ['F&B','Fashion','Tech','Health','Beauty','Travel','Edukasi','Produk','Lainnya'];
const STYLES = ['Viral Hook','Testimonial','Tutorial','Showcase'];
const DURATIONS = [5,15,30,60];

function initCreate() {
  createState = { step:1, niche:'', style:'', duration:30, customPrompt:'', storyboard:null };
  renderCreateStep();
}

function renderCreateStep() {
  // update dots
  const dot = document.getElementById('step-dots');
  if (!dot) return;
  dot.innerHTML = Array.from({length:6}, (_,i) => '<div class="step-dot ' + (i+1 <= createState.step ? 'done' : '') + '"></div>').join('');

  const c = document.getElementById('create-step-container');
  if (createState.step === 1) {
    c.innerHTML = '<div class="step-header">Pilih Niche Bisnis</div><div class="step-sub">Kategori konten akan menentukan gaya video</div><div class="niche-grid">' +
      NICHES.map(n => '<div class="niche-btn' + (createState.niche === n ? ' selected' : '') + '" onclick="selectNiche(\''+n+'\')"><span class="ni">'+ (['🍔','👗','💻','💊','💄','✈️','📚','🛍️','🎯'][NICHES.indexOf(n)] || '📦') +'</span>' + n + '</div>').join('') +
      '</div><div style="margin-top:24px"><button class="btn btn-primary" onclick="nextStep()" ' + (createState.niche ? '' : 'disabled') + '>Lanjut →</button></div>';
  } else if (createState.step === 2) {
    c.innerHTML = '<div class="step-header">Pilih Style Video</div><div class="step-sub">Gaya penyampaian konten</div><div class="chip-group">' +
      STYLES.map(s => '<div class="chip' + (createState.style === s ? ' selected' : '') + '" onclick="selectStyle(\''+s+'\')">' + s + '</div>').join('') +
      '</div><div style="margin-top:24px;display:flex;gap:12px"><button class="btn btn-outline" onclick="prevStep()">← Kembali</button><button class="btn btn-primary" onclick="nextStep()">Lanjut →</button></div>';
  } else if (createState.step === 3) {
    c.innerHTML = '<div class="step-header">Pilih Durasi</div><div class="step-sub">Durasi video output</div><div class="dur-group">' +
      DURATIONS.map(d => '<div class="dur-btn' + (createState.duration === d ? ' selected' : '') + '" onclick="selectDur('+d+')">' + d + 's</div>').join('') +
      '</div><div style="margin-top:24px;display:flex;gap:12px"><button class="btn btn-outline" onclick="prevStep()">← Kembali</button><button class="btn btn-primary" onclick="nextStep()">Lanjut →</button></div>';
  } else if (createState.step === 4) {
    c.innerHTML = '<div class="step-header">Advanced Setup (Opsional)</div><div class="step-sub">Deskripsikan produkmu dan atur parameter video</div>' +
      '<div class="form-group"><label class="form-label">Custom Prompt / Promo</label><textarea id="custom-prompt" placeholder="Contoh: Kopi arabika single origin dari Aceh..." rows="3">'+esc(createState.customPrompt)+'</textarea></div>' +
      '<div class="form-group" style="background:var(--card); padding:16px; border-radius:12px; border:1px solid var(--border);">' +
      '<label class="form-label" style="margin-bottom:12px; font-weight:700;">Pengaturan Video</label>' +
      '<div style="display:flex; flex-direction:column; gap:12px;">' +
      '<label style="display:flex; align-items:center; gap:8px; cursor:pointer;"><input type="checkbox" id="adv-no-watermark" style="width:auto;"> Hapus Watermark <span style="font-size:11px;color:var(--warn);background:rgba(255,165,2,0.15);padding:2px 6px;border-radius:4px;">-10 Credits</span></label>' +
      '<label style="display:flex; align-items:center; gap:8px; cursor:pointer;"><input type="checkbox" id="adv-subtitles" style="width:auto;" checked> Auto Subtitle</label>' +
      '<label style="display:flex; align-items:center; gap:8px; cursor:pointer;"><input type="checkbox" id="adv-voiceover" style="width:auto;" checked> Voice Over AI</label>' +
      '</div></div>' +
      '<div style="display:flex;gap:12px;margin-top:24px;"><button class="btn btn-outline" onclick="prevStep()">← Kembali</button><button class="btn btn-primary" style="flex:1" onclick="saveAdvAndNext()">Preview Storyboard →</button></div>';
  } else if (createState.step === 5) {
    c.innerHTML = '<div class="step-header">Preview Storyboard</div><div class="step-sub">AI sedang generate storyboard...</div><div style="display:flex;align-items:center;gap:12px;padding:20px 0"><div class="spinner"></div><span style="color:var(--dim);font-size:14px">Generating storyboard...</span></div>';
    generateStoryboardPreview();
  } else if (createState.step === 6) {
    const scenes = createState.storyboard?.scenes || [];
    const creditCost = createState.duration <= 5 ? unitPricing.IMAGE_UNIT : createState.duration <= 15 ? unitPricing.VIDEO_15S : createState.duration <= 30 ? unitPricing.VIDEO_30S : createState.duration <= 60 ? unitPricing.VIDEO_60S : unitPricing.VIDEO_120S;
    const canAfford = Number(currentUser?.credits || 0) >= creditCost;
    c.innerHTML = '<div class="step-header">Konfirmasi & Generate</div><div class="step-sub">'+scenes.length+' scene · '+createState.duration+'s · '+createState.niche+' · '+createState.style+'</div>' +
      '<div style="margin-bottom:20px">' + scenes.map(s => '<div class="scene-card"><div class="scene-num">Scene '+s.scene+' · '+s.duration+'s</div><p>'+esc(s.description)+'</p></div>').join('') + '</div>' +
      (createState.storyboard?.caption ? '<div class="card" style="margin-bottom:20px"><div style="font-size:12px;color:var(--dim);margin-bottom:6px">📝 Caption</div><p style="font-size:14px;line-height:1.6">'+esc(createState.storyboard.caption)+'</p></div>' : '') +
      '<div class="card" style="margin-bottom:20px"><div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:14px">Biaya</span><span style="font-size:18px;font-weight:700;color:var(--accent)">'+creditCost+' Credits</span></div>' +
      (!canAfford ? '<div style="margin-top:12px;color:var(--danger);font-size:13px">⚠️ Credits tidak cukup. <a href="#" onclick="nav(\'billing\')" style="color:var(--accent)">Top Up sekarang</a></div>' : '') +
      '</div><div style="display:flex;gap:12px"><button class="btn btn-outline" onclick="createState.step=4;renderCreateStep()">← Kembali</button><button class="btn btn-primary" onclick="startGeneration()" ' + (!canAfford ? 'disabled' : '') + ' id="gen-btn">🎬 Generate Video</button></div>';
  }
}

function selectNiche(n) { createState.niche = n; renderCreateStep(); }
function selectStyle(s) { createState.style = s; renderCreateStep(); }
function selectDur(d) { createState.duration = d; renderCreateStep(); }
function nextStep() { createState.step++; renderCreateStep(); }
function prevStep() { createState.step--; renderCreateStep(); }
function saveAdvAndNext() {
  createState.customPrompt = document.getElementById('custom-prompt')?.value || '';
  createState.noWatermark = document.getElementById('adv-no-watermark')?.checked || false;
  createState.subtitles = document.getElementById('adv-subtitles')?.checked !== false;
  createState.voiceover = document.getElementById('adv-voiceover')?.checked !== false;
  nextStep();
}

async function generateStoryboardPreview() {
  try {
    const data = await apiFetch('/api/storyboard', { method:'POST', body:JSON.stringify({ niche:createState.niche, duration:createState.duration, customPrompt:createState.customPrompt||undefined }) });
    if (!data || data.error) { toast('Gagal generate storyboard: '+(data?.error||'Unknown'),'err'); createState.step=4; renderCreateStep(); return; }
    createState.storyboard = data;
    createState.step = 6;
    renderCreateStep();
  } catch(e) { toast('Error: '+e.message,'err'); createState.step=4; renderCreateStep(); }
}

async function startGeneration() {
  const btn = document.getElementById('gen-btn');
  if (btn) { btn.disabled = true; btn.innerHTML = '<div class="spinner"></div> Memulai...'; }
  try {
    const data = await apiFetch('/api/video/create', { method:'POST', body:JSON.stringify({
      niche:createState.niche, style:createState.style, duration:createState.duration, platform:'tiktok',
      customPrompt:createState.customPrompt||undefined, customScenes:createState.storyboard?.scenes||undefined,
      noWatermark:createState.noWatermark, subtitles:createState.subtitles, voiceover:createState.voiceover
    })});
    if (!data || data.error) { toast('Gagal: '+(data?.error||'Server error'),'err'); if(btn){btn.disabled=false;btn.innerHTML='🎬 Generate Video';} return; }
    toast('✅ Video mulai diproses! Cek di "Video Saya"', 'ok');
    const u = await apiFetch('/api/user');
    if (u) { currentUser = u; updateCreditsDisplay(u.credits); }
    nav('videos');
    startPolling();
  } catch(e) { toast('Error: '+e.message,'err'); if(btn){btn.disabled=false;btn.innerHTML='🎬 Generate Video';} }
}

// ── VIDEOS ────────────────────────────────────────────────
let videosCursor = null;

async function loadVideos(cursor) {
  const c = document.getElementById('videos-container');
  if (!cursor) c.innerHTML = '<div class="skeleton" style="height:200px"></div>';
  const path = '/api/videos' + (cursor ? '?cursor=' + cursor : '');
  const data = await apiFetch(path);
  if (!data) { c.innerHTML = '<div class="empty"><div class="icon">📁</div><h3>Gagal memuat video</h3></div>'; return; }
  const list = data.videos || data.results || data.data || [];
  if (!cursor) { c.innerHTML = ''; }
  if (list.length === 0 && !cursor) {
    c.innerHTML = '<div class="empty"><div class="icon">🎬</div><h3>Belum ada video</h3><p class="desc">Buat video pertama kamu!</p></div>';
    return;
  }
  videosCursor = data.nextCursor || null;
  document.getElementById('load-more-videos-btn').style.display = videosCursor ? 'block' : 'none';
  for (const v of list) {
    const card = document.createElement('div');
    card.className = 'video-card';
    card.innerHTML = '<div class="video-thumb">' + (v.videoUrl ? '<video src="'+esc(v.videoUrl)+'" preload="metadata" controls playsinline></video>' : '🎬') + '</div>' +
      '<div class="video-info"><div class="video-title">'+esc(v.title||v.prompt||'Video')+'</div>' +
      '<div class="video-meta">'+(v.duration||'—')+'s · '+(v.niche||'—')+'</div>' +
      '<span class="status-badge status-'+((v.status||'pending').toLowerCase())+'">'+(v.status||'Pending')+'</span></div>';
    c.appendChild(card);
  }
}

function startPolling() {
  if (pollInterval) clearInterval(pollInterval);
  pollInterval = setInterval(async () => {
    const data = await apiFetch('/api/videos?limit=1');
    if (data && data.videos && data.videos.length > 0) {
      const v = data.videos[0];
      if (v.status === 'completed' || v.status === 'failed') {
        clearInterval(pollInterval);
        pollInterval = null;
        loadVideos();
      }
    }
  }, 5000);
}

// ── BILLING ───────────────────────────────────────────────
const PACKAGES = [
  { key:'starter', label:'Starter', price:15000, credits:25, popular:false },
  { key:'basic', label:'Basic', price:35000, credits:65, popular:true },
  { key:'pro', label:'Pro', price:75000, credits:150, popular:false },
  { key:'enterprise', label:'Enterprise', price:150000, credits:350, popular:false },
];

async function loadPackages() {
  const c = document.getElementById('packages-container');
  if (!c) return;
  c.innerHTML = PACKAGES.map(p => '<div class="price-card' + (p.popular ? ' popular' : '') + '">' +
    (p.popular ? '<div class="popular-tag">⭐ POPULER</div>' : '') +
    '<h3>' + p.label + '</h3>' +
    '<div class="price">IDR ' + p.price.toLocaleString() + '</div>' +
    '<div class="cred">' + p.credits + ' Credits</div>' +
    '<button class="btn btn-primary" onclick="payQris(\''+p.key+'\','+p.price+','+p.credits+')">Beli Sekarang</button></div>').join('');
}

async function payQris(key, price, credits) {
  toast('Membuka pembayaran QRIS...', 'info');
  const data = await apiFetch('/api/pay/qris', { method:'POST', body:JSON.stringify({ package:key, amount:price, credits:credits }) });
  if (!data || !data.qrUrl) { toast('Gagal membuat pembayaran','err'); return; }
  if (data.qrUrl.startsWith('http')) { window.open(data.qrUrl, '_blank'); }
  toast('✅ Pembayaran diproses: IDR '+price.toLocaleString(), 'ok');
}

async function payStars() { toast('Pembayaran Telegram Stars belum tersedia','info'); }
async function payCrypto() {
  const data = await apiFetch('/api/pay/crypto', { method:'POST' });
  if (data && data.address) { toast('💎 Kirim USDT/BNB ke: '+data.address,'info'); } else { toast('Gagal memuat alamat crypto','err'); }
}

// ── REFERRAL ──────────────────────────────────────────────
async function shareRef() {
  const link = document.getElementById('ref-link')?.value;
  if (link) {
    try { await navigator.clipboard.writeText(link); toast('✅ Link referral disalin!','ok'); } catch(e) { toast('Link: ' + link, 'info'); }
  }
  nav('referral');
}

async function withdrawReferral() {
  toast('Pengajuan penarikan komisi dikirim ke admin','info');
}

// ── SEND CREDITS ─────────────────────────────────────────
async function sendCredits() {
  const username = document.getElementById('send-username')?.value;
  const amount = parseInt(document.getElementById('send-amount')?.value);
  if (!username || !amount || amount < 50) { toast('Isi username dan jumlah (min 50)','err'); return; }
  const data = await apiFetch('/api/transfer', { method:'POST', body:JSON.stringify({ username, amount }) });
  if (!data || data.error) { toast('Gagal: '+(data?.error||'Unknown'),'err'); return; }
  toast('✅ '+amount+' credits dikirim ke @'+username,'ok');
  const u = await apiFetch('/api/user');
  if (u) { currentUser = u; updateCreditsDisplay(u.credits); }
}

// ── PROFILE ───────────────────────────────────────────────
let editMode = false;
function toggleEditProfile() {
  editMode = !editMode;
  document.getElementById('edit-profile-form').style.display = editMode ? 'block' : 'none';
  document.getElementById('edit-profile-btn').textContent = editMode ? '✏️ Tutup' : '✏️ Edit Profil';
  if (editMode && currentUser) {
    document.getElementById('edit-firstName').value = currentUser.firstName || '';
  }
}

async function saveProfile() {
  const firstName = document.getElementById('edit-firstName')?.value;
  const language = document.getElementById('edit-lang')?.value;
  const data = await apiFetch('/api/user/profile', { method:'PUT', body:JSON.stringify({ firstName, language }) });
  if (!data || data.error) { toast('Gagal update profil','err'); return; }
  toast('✅ Profil diupdate','ok');
  toggleEditProfile();
  loadUser();
}

// ── SETTINGS ──────────────────────────────────────────────
async function saveSettings() {
  const lang = document.getElementById('settings-lang')?.value;
  const notif = document.getElementById('settings-notif')?.value === '1';
  const data = await apiFetch('/api/user/settings', { method:'PUT', body:JSON.stringify({ language:lang, notifications:notif }) });
  if (!data || data.error) { toast('Gagal simpan pengaturan','err'); return; }
  toast('✅ Pengaturan disimpan','ok');
}

function changeLang(val) {
  document.getElementById('settings-lang').value = val;
  document.getElementById('edit-lang').value = val;
}

async function deleteAccount() {
  if (!confirm('Yakin ingin menghapus akun? Semua data akan hilang!')) return;
  const data = await apiFetch('/api/user', { method:'DELETE' });
  if (!data || data.error) { toast('Gagal hapus akun','err'); return; }
  localStorage.removeItem('token');
  window.location.href = '/admin/login';
}

// ── IMAGE GENERATION ─────────────────────────────────────
async function generateImage() {
  const prompt = document.getElementById('image-prompt')?.value;
  if (!prompt) { toast('Masukkan prompt gambar','err'); return; }
  const btn = document.getElementById('gen-image-btn');
  btn.disabled = true; btn.innerHTML = '<div class="spinner"></div> Generating...';
  try {
    const data = await apiFetch('/api/image/generate', { method:'POST', body:JSON.stringify({ prompt }) });
    if (!data || data.error) { toast('Gagal: '+(data?.error||'Unknown'),'err'); return; }
    const r = document.getElementById('image-result');
    if (data.imageUrl) { r.innerHTML = '<img src="'+data.imageUrl+'" alt="Generated Image" style="max-width:100%;border-radius:12px">'; }
    else { r.innerHTML = '<div class="empty"><div class="icon">🖼️</div><h3>Gambar siap!</h3></div>'; }
    toast('✅ Gambar selesai!','ok');
    const u = await apiFetch('/api/user');
    if (u) { currentUser = u; updateCreditsDisplay(u.credits); }
  } catch(e) { toast('Error: '+e.message,'err'); }
  finally { btn.disabled = false; btn.innerHTML = 'Generate Gambar'; }
}

// ── TOAST ─────────────────────────────────────────────────
function toast(msg, type) {
  const t = document.getElementById('toast');
  const el = document.createElement('div');
  el.className = 'toast-msg toast-'+ (type||'info');
  el.textContent = msg;
  t.appendChild(el);
  requestAnimationFrame(() => el.classList.add('show'));
  setTimeout(() => { el.classList.remove('show'); setTimeout(() => el.remove(), 300); }, 3000);
}

// ── SUBSCRIPTIONS ─────────────────────────────────────────
async function loadSubscriptions() {
  const c = document.getElementById('subscription-plans');
  if (!c) return;
  const data = await apiFetch('/api/subscriptions');
  const plans = data?.plans || [{name:'Free',price:0,credits:25},{name:'Basic',price:35000,credits:65},{name:'Pro',price:75000,credits:150}];
  c.innerHTML = plans.map(p => '<div class="price-card"><h3>'+p.name+'</h3><div class="price">IDR '+(p.price||0).toLocaleString()+'</div><div class="cred">'+p.credits+' credits/bln</div><button class="btn btn-primary btn-full">Pilih</button></div>').join('');
}

// ── INIT ──────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
  if (!token) { window.location.href='/admin/login'; return; }
  document.getElementById('app').style.display = 'flex';
  document.getElementById('loading-overlay').style.display = 'none';
  await loadUser();
  initCreate();
  
  // Check URL params for deep link
  const params = new URLSearchParams(window.location.search);
  if (params.get('page')) nav(params.get('page'));
});
</script>

<div id="version-badge">v4</div>
