<div id="view-send" class="view">
  <div class="card" style="text-align:center;padding:40px">
    <div style="font-size:48px;margin-bottom:16px">💸</div>
    <h2 style="margin-bottom:8px">Kirim Saldo (P2P)</h2>
    <p style="color:var(--dim);margin-bottom:24px">Kirim credits ke pengguna lain (biaya admin 0.5%)</p>
    <div class="form-group" style="text-align:left; max-width:400px; margin:0 auto 16px;">
      <label class="form-label">Username Penerima (tanpa @)</label>
      <input type="text" id="send-username" placeholder="Contoh: agus_setiawan">
    </div>
    <div class="form-group" style="text-align:left; max-width:400px; margin:0 auto 24px;">
      <label class="form-label">Jumlah Credits</label>
      <input type="number" id="send-amount" placeholder="Minimal 50">
    </div>
    <button class="btn btn-primary" style="max-width:400px; width:100%" onclick="sendCredits()">Kirim Sekarang</button>
  </div>
</div>