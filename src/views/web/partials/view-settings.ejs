<div id="view-settings" class="view">
  <div class="card" style="padding:40px">
    <h2 style="margin-bottom:24px">⚙️ Pengaturan</h2>
    <div class="form-group">
      <label class="form-label">Bahasa</label>
      <select id="settings-lang" onchange="changeLang(this.value)">
        <option value="id">🇮🇩 Indonesia</option>
        <option value="en">🇺🇸 English</option>
        <option value="ru">🇷🇺 Русский</option>
        <option value="zh">🇨🇳 中文</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Notifikasi</label>
      <select id="settings-notif">
        <option value="1">Aktif</option>
        <option value="0">Nonaktif</option>
      </select>
    </div>
    <button class="btn btn-primary btn-full" onclick="saveSettings()" style="margin-bottom:12px">Simpan Pengaturan</button>
    <button class="btn btn-danger btn-full" onclick="deleteAccount()" style="margin-top:24px">Hapus Akun</button>
  </div>
</div>