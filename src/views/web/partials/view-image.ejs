<div id="view-image" class="view">
  <div class="card" style="text-align:center;padding:40px">
    <div style="font-size:48px;margin-bottom:16px">🖼️</div>
    <h2 style="margin-bottom:8px">Buat Gambar AI</h2>
    <p style="color:var(--dim);margin-bottom:24px">Generate gambar dari prompt teks</p>
    <div class="form-group">
      <textarea id="image-prompt" placeholder="Deskripsikan gambar yang Anda inginkan..." rows="3"></textarea>
    </div>
    <button id="gen-image-btn" class="btn btn-primary btn-full" onclick="generateImage()">Generate Gambar</button>
    <div id="image-result" style="margin-top:24px"></div>
  </div>
</div>