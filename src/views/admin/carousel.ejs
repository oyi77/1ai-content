<!-- Carousel Generator Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">🖼️ Carousel Generator</h1>
    <p class="section-sub">Create TikTok/Instagram carousels with AI-generated content</p>
  </div>
  <div style="display:flex;gap:8px;">
    <button class="btn btn-ghost" onclick="loadTemplates()">📋 Templates</button>
  </div>
</div>

<!-- Generate Form -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generate Carousel</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Topic</label>
      <input class="input" id="car-topic" placeholder="Tips hemat belanja online untuk pemula" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Style</label>
      <select class="input" id="car-style" style="width:100%;">
        <option value="outline">📋 Outline / Bullet</option>
        <option value="educational">🎓 Educational</option>
        <option value="storytelling">📖 Storytelling</option>
        <option value="minimal">✨ Minimal</option>
        <option value="bold">🎨 Bold & Vibrant</option>
        <option value="dark">🌙 Dark Mode</option>
      </select>
    </div>
    <div class="form-group">
      <label>Slides</label>
      <select class="input" id="car-slides" style="width:100%;">
        <option value="5">5 slides</option>
        <option value="7" selected>7 slides (recommended)</option>
        <option value="10">10 slides</option>
      </select>
    </div>
    <div class="form-group">
      <label>Platform</label>
      <select class="input" id="car-platform" style="width:100%;">
        <option value="tiktok">🎵 TikTok (9:16)</option>
        <option value="instagram">📸 Instagram (4:5)</option>
        <option value="square">⬛ Square (1:1)</option>
      </select>
    </div>
    <div class="form-group">
      <label>Language</label>
      <select class="input" id="car-lang" style="width:100%;">
        <option value="id">🇮🇩 Indonesia</option>
        <option value="en">🇬🇧 English</option>
      </select>
    </div>
  </div>
  <button class="btn btn-gold" style="margin-top:20px;" onclick="generateCarousel()">🖼️ Generate Carousel</button>
</div>

<!-- Result -->
<div id="result-section" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generated Carousel</h3>
  <div id="result-content"></div>
</div>

<!-- Templates -->
<div id="templates-section" class="card" style="display:none;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">📋 Available Templates</h3>
  <div id="templates-list"></div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type='success') {
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'success' ? 'success' : 'error'}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function generateCarousel() {
  const topic = document.getElementById('car-topic').value.trim();
  if (!topic) return showToast('Enter a topic', 'error');

  const btn = document.querySelector('.btn-gold');
  btn.textContent = '⏳ Generating...';
  btn.disabled = true;

  try {
    const r = await fetch(`${PY_API}/carousel/create`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        topic,
        num_slides: parseInt(document.getElementById('car-slides').value),
        style: document.getElementById('car-style').value,
        platform: document.getElementById('car-platform').value,
        language: document.getElementById('car-lang').value,
      }),
    });
    const data = await r.json();

    const section = document.getElementById('result-section');
    section.style.display = 'block';

    if (data.success) {
      const content = data.content || {};
      const slides = content.slides || [];
      let html = `<div style="margin-bottom:16px;">
        <span class="badge badge-green">✅ ${data.slide_count || slides.length} slides generated</span>
        <span style="margin-left:8px;font-size:12px;color:var(--muted);">Job: ${data.job_id || '—'}</span>
      </div>`;

      if (content.title) html += `<div style="font-size:18px;font-weight:700;margin-bottom:12px;">${content.title}</div>`;

      if (slides.length) {
        html += '<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-bottom:16px;">';
        slides.forEach((s, i) => {
          const bgColor = s.type === 'cover' ? '#1a2a4a' : s.type === 'closing' ? '#2a1a4a' : '#1a1a24';
          html += `<div style="background:${bgColor};border:1px solid var(--border);border-radius:10px;padding:16px;">
            <div style="font-size:10px;color:var(--muted);text-transform:uppercase;margin-bottom:6px;">${s.type || 'content'} ${i+1}</div>
            <div style="font-size:14px;font-weight:600;margin-bottom:6px;">${s.icon || ''} ${s.headline || ''}</div>
            <div style="font-size:12px;color:var(--muted);">${s.body || ''}</div>
          </div>`;
        });
        html += '</div>';
      }

      if (data.slides?.length) {
        html += `<div style="margin-top:12px;font-size:12px;color:var(--muted);">📁 Files: ${data.slides.length} PNG files saved</div>`;
      }

      if (data.caption) {
        html += `<div style="margin-top:16px;padding:16px;background:var(--bg);border-radius:10px;">
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;margin-bottom:8px;">Caption</div>
          <div style="font-size:13px;white-space:pre-wrap;">${data.caption}</div>
        </div>`;
      }

      if (data.hashtags?.length) {
        html += `<div style="margin-top:8px;font-size:13px;color:var(--gold);">${data.hashtags.join(' ')}</div>`;
      }

      document.getElementById('result-content').innerHTML = html;
      showToast(`✅ ${data.slide_count || slides.length} slides generated!`);
    } else {
      document.getElementById('result-content').innerHTML = `<div style="color:var(--red);">❌ ${data.error || 'Generation failed'}</div>`;
      showToast('❌ ' + (data.error || 'Failed'), 'error');
    }
  } catch (e) {
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '🖼️ Generate Carousel';
  btn.disabled = false;
}

async function loadTemplates() {
  const section = document.getElementById('templates-section');
  section.style.display = section.style.display === 'none' ? 'block' : 'none';
  if (section.style.display === 'none') return;

  try {
    const r = await fetch(`${PY_API}/carousel/templates`);
    const data = await r.json();
    const templates = data.templates || [];
    const niches = data.niches || [];

    let html = `<div style="margin-bottom:16px;">Niches: ${niches.map(n => `<span class="badge badge-blue" style="margin:2px;">${n}</span>`).join(' ')}</div>`;
    templates.forEach(t => {
      html += `<div style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--border);">
        <div>
          <div style="font-weight:600;">${t.name}</div>
          <div style="font-size:12px;color:var(--muted);">${t.niche} · ${t.slides} slides · ${t.style}</div>
        </div>
        <span class="badge badge-green">${t.success_rate || 0}%</span>
      </div>`;
    });
    document.getElementById('templates-list').innerHTML = html;
  } catch (e) {
    document.getElementById('templates-list').innerHTML = `<div style="color:var(--red);">❌ ${e.message}</div>`;
  }
}
</script>
