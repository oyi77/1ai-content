<!-- Video Tools Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">🎬 Video Tools</h1>
    <p class="section-sub">Search for videos by URL, refresh cookies, regenerate content</p>
  </div>
</div>

<!-- URL Search -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">🔍 Search Video by URL</h3>
  <div class="form-group">
    <label>Video URL</label>
    <input class="input" id="vt-url" placeholder="https://www.tiktok.com/@user/video/123456789" style="width:100%;">
  </div>
  <button class="btn btn-ghost" onclick="searchVideo()">🔍 Search</button>
  <div id="search-result" style="margin-top:16px;"></div>
</div>

<!-- Refresh Cookies -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">🍪 Refresh TikTok Cookies</h3>
  <p style="font-size:13px;color:var(--muted);margin-bottom:12px;">
    Extract fresh cookies from the configured Chromium profile. Required before video downloading if cookies are stale.
  </p>
  <button class="btn btn-gold" onclick="refreshCookies()">🔄 Refresh Cookies</button>
  <div id="cookie-result" style="margin-top:16px;"></div>
</div>

<!-- Regenerate (alias for repurpose) -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">🔄 Regenerate Content</h3>
  <p style="font-size:13px;color:var(--muted);margin-bottom:12px;">
    Fully regenerate a video — redownload, re‑caption, re‑voice. (<strong>Alias:</strong> uses the <code>/repurpose</code> pipeline.)
  </p>
  <div class="form-group">
    <label>Video URL</label>
    <input class="input" id="vt-regenerate-url" placeholder="https://www.tiktok.com/@user/video/123456789" style="width:100%;">
  </div>
  <button class="btn btn-ghost" onclick="regenerateVideo()">🔄 Regenerate</button>
  <div id="regenerate-result" style="margin-top:16px;"></div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type) {
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'success' ? 'success' : 'error'}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

function showResult(id, html) {
  document.getElementById(id).innerHTML = html;
}

async function searchVideo() {
  const url = document.getElementById('vt-url').value.trim();
  if (!url) return showToast('Enter a video URL', 'error');

  const btn = document.querySelector('button[onclick="searchVideo()"]');
  btn.textContent = '⏳ Searching...';
  btn.disabled = true;

  try {
    const r = await fetch(`${PY_API}/video/search`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url }),
    });
    const data = await r.json();
    showResult('search-result',
      data.success
        ? `<div style="padding:12px;background:var(--bg);border-radius:8px;font-size:13px;">
             <pre style="white-space:pre-wrap;margin:0;">${JSON.stringify(data, null, 2)}</pre>
           </div>`
        : `<div style="color:var(--red);">❌ ${data.error || 'Search failed'}</div>`
    );
  } catch (e) {
    showResult('search-result', `<div style="color:var(--red);">❌ ${e.message}</div>`);
  }

  btn.textContent = '🔍 Search';
  btn.disabled = false;
}

async function refreshCookies() {
  const btn = document.querySelector('button[onclick="refreshCookies()"]');
  btn.textContent = '⏳ Refreshing...';
  btn.disabled = true;

  try {
    const r = await fetch(`${PY_API}/video/refresh-cookies`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
    });
    const data = await r.json();
    showResult('cookie-result',
      data.success
        ? `<div style="padding:12px;background:var(--success-bg, #163822);border-radius:8px;font-size:13px;color:var(--success, #4ade80);">✅ ${data.message || 'Cookies refreshed'}</div>`
        : `<div style="color:var(--red);">❌ ${data.error || 'Refresh failed'}</div>`
    );
    if (data.success) showToast('✅ Cookies refreshed');
  } catch (e) {
    showResult('cookie-result', `<div style="color:var(--red);">❌ ${e.message}</div>`);
  }

  btn.textContent = '🔄 Refresh Cookies';
  btn.disabled = false;
}

async function regenerateVideo() {
  const url = document.getElementById('vt-regenerate-url').value.trim();
  if (!url) return showToast('Enter a video URL', 'error');

  const btn = document.querySelector('button[onclick="regenerateVideo()"]');
  btn.textContent = '⏳ Regenerating... (can take a while)';
  btn.disabled = true;

  try {
    const r = await fetch(`${PY_API}/video/regenerate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url }),
    });
    const data = await r.json();
    showResult('regenerate-result',
      data.success
        ? `<div style="padding:12px;background:var(--bg);border-radius:8px;font-size:13px;">
             <pre style="white-space:pre-wrap;margin:0;">${JSON.stringify(data, null, 2)}</pre>
           </div>`
        : `<div style="color:var(--red);">❌ ${data.error || 'Regeneration failed'}</div>`
    );
    if (data.success) showToast('✅ Regeneration started');
  } catch (e) {
    showResult('regenerate-result', `<div style="color:var(--red);">❌ ${e.message}</div>`);
  }

  btn.textContent = '🔄 Regenerate';
  btn.disabled = false;
}
</script>
