<!-- TTS Generator Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">🔊 Text-to-Speech Generator</h1>
    <p class="section-sub">Convert text to natural speech using Edge TTS voices</p>
  </div>
</div>

<!-- Generate Form -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generate Speech</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Text to Speak</label>
      <textarea class="input" id="tts-text" placeholder="Enter the text you want to convert to speech..." style="width:100%;min-height:120px;resize:vertical;padding:12px;font-family:inherit;line-height:1.6;"></textarea>
    </div>
    <div class="form-group">
      <label>Language</label>
      <select class="input" id="tts-language" style="width:100%;">
        <option value="id">🇮🇩 Indonesia</option>
        <option value="en">🇬🇧 English</option>
        <option value="zh-CN">🇨🇳 Chinese</option>
        <option value="ja">🇯🇵 Japanese</option>
        <option value="ko">🇰🇷 Korean</option>
        <option value="ms">🇲🇾 Malay</option>
      </select>
    </div>
    <div class="form-group">
      <label>Voice</label>
      <select class="input" id="tts-voice" style="width:100%;">
        <option value="">— Loading voices... —</option>
      </select>
    </div>
    <div class="form-group">
      <label>Rate</label>
      <input class="input" id="tts-rate" type="text" value="+0%" placeholder="e.g. +0%, -50%, +50%" style="width:100%;">
      <div style="font-size:11px;color:var(--muted);margin-top:4px;">Speed: slower (-) or faster (+)</div>
    </div>
    <div class="form-group">
      <label>Pitch</label>
      <input class="input" id="tts-pitch" type="text" value="+0Hz" placeholder="e.g. +0Hz, -20Hz, +20Hz" style="width:100%;">
      <div style="font-size:11px;color:var(--muted);margin-top:4px;">Lower (-) or higher (+) pitch</div>
    </div>
  </div>
  <button class="btn btn-primary" style="margin-top:20px;" onclick="generateSpeech()">🔊 Generate Speech</button>
</div>

<!-- Result -->
<div id="result-section" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generated Audio</h3>
  <div id="result-content"></div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type) {
  const t = document.createElement('div');
  t.className = 'toast toast-' + (type === 'success' ? 'success' : 'error');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function loadVoices(language) {
  const select = document.getElementById('tts-voice');
  select.innerHTML = '<option value="">— Loading voices... —</option>';
  select.disabled = true;

  try {
    const r = await fetch(PY_API + '/tts/voices' + (language ? '?language=' + encodeURIComponent(language) : ''), {
      credentials: 'include'
    });
    if (!r.ok) throw new Error('Failed to load voices (' + r.status + ')');
    const data = await r.json();

    select.innerHTML = '<option value="">— Select a voice —</option>';

    if (Array.isArray(data)) {
      data.forEach(function(v) {
        const shortName = v.ShortName || v.short_name || v.name || '';
        const displayName = v.DisplayName || v.display_name || v.Name || shortName;
        const locale = v.Locale || v.locale || language || '';
        const gender = v.Gender || v.gender || '';
        const label = displayName + (locale ? ' (' + locale + ')' : '') + (gender ? ' - ' + gender : '');
        const opt = document.createElement('option');
        opt.value = shortName;
        opt.textContent = label;
        select.appendChild(opt);
      });
    } else if (data.voices && Array.isArray(data.voices)) {
      data.voices.forEach(function(v) {
        const shortName = v.ShortName || v.short_name || v.name || '';
        const displayName = v.DisplayName || v.display_name || v.Name || shortName;
        const locale = v.Locale || v.locale || language || '';
        const gender = v.Gender || v.gender || '';
        const label = displayName + (locale ? ' (' + locale + ')' : '') + (gender ? ' - ' + gender : '');
        const opt = document.createElement('option');
        opt.value = shortName;
        opt.textContent = label;
        select.appendChild(opt);
      });
    }

    if (select.options.length === 1) {
      select.innerHTML = '<option value="">— No voices found —</option>';
    }
  } catch (e) {
    select.innerHTML = '<option value="">— Failed to load voices —</option>';
    showToast('❌ ' + e.message, 'error');
  }

  select.disabled = false;
}

async function generateSpeech() {
  const text = document.getElementById('tts-text').value.trim();
  if (!text) return showToast('Please enter text to speak', 'error');

  const btn = document.querySelector('.btn-primary');
  const origText = btn.textContent;
  btn.textContent = '⏳ Generating...';
  btn.disabled = true;

  try {
    const r = await fetch(PY_API + '/tts/synthesize', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({
        text: text,
        language: document.getElementById('tts-language').value,
        voice: document.getElementById('tts-voice').value || undefined,
        rate: document.getElementById('tts-rate').value || '+0%',
        pitch: document.getElementById('tts-pitch').value || '+0Hz',
      }),
    });
    const data = await r.json();

    const section = document.getElementById('result-section');
    section.style.display = 'block';

    if (data.success && data.filename) {
      const audioUrl = PY_API + '/tts/audio/' + encodeURIComponent(data.filename);
      const html = '<div style="margin-bottom:16px;">' +
        '<span class="badge badge-green">✅ Speech generated</span>' +
        (data.file_path ? '<span style="margin-left:8px;font-size:12px;color:var(--muted);">' + data.file_path + '</span>' : '') +
        '</div>' +
        '<div style="margin-bottom:16px;">' +
        '<audio controls style="width:100%;max-width:600px;" src="' + audioUrl + '"></audio>' +
        '</div>' +
        '<a href="' + audioUrl + '" class="btn btn-ghost" download target="_blank">⬇️ Download Audio</a>';
      document.getElementById('result-content').innerHTML = html;
      showToast('✅ Speech generated!');
    } else {
      document.getElementById('result-content').innerHTML = '<div style="color:var(--red);">❌ ' + (data.error || 'Generation failed') + '</div>';
      showToast('❌ ' + (data.error || 'Failed'), 'error');
    }
  } catch (e) {
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = origText;
  btn.disabled = false;
}

// Load voices on page load and when language changes
document.addEventListener('DOMContentLoaded', function() {
  loadVoices('id');
});

document.getElementById('tts-language').addEventListener('change', function() {
  loadVoices(this.value);
});
</script>
