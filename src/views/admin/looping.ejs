<!-- Loop Video Generator Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">🔄 Loop Video Generator</h1>
    <p class="section-sub">Create looping videos from audio files with visual effects</p>
  </div>
</div>

<!-- Generate Form -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generate Loop Video</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Audio File Path <span style="color:var(--red);">*</span></label>
      <input class="input" id="loop-audio-path" placeholder="/path/to/audio.mp3" style="width:100%;font-family:monospace;">
      <div style="font-size:11px;color:var(--muted);margin-top:4px;">Path to an audio file on the server (MP3, WAV, M4A)</div>
    </div>
    <div class="form-group">
      <label>Duration (minutes)</label>
      <input class="input" type="number" id="loop-duration" value="60" min="1" max="360" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Resolution</label>
      <select class="input" id="loop-resolution" style="width:100%;">
        <option value="1920x1080">📺 1920x1080 (Full HD)</option>
        <option value="1080x1920">📱 1080x1920 (Portrait)</option>
        <option value="1280x720">💻 1280x720 (HD)</option>
        <option value="720x1280">📱 720x1280 (Portrait HD)</option>
      </select>
    </div>
    <div class="form-group">
      <label>Visual Type</label>
      <select class="input" id="loop-visual-type" onchange="onVisualTypeChange()" style="width:100%;">
        <option value="gradient">🌈 Gradient</option>
        <option value="waves">🌊 Waves</option>
        <option value="particles">✨ Particles</option>
        <option value="image">🖼️ Image</option>
      </select>
    </div>
    <div class="form-group">
      <label>Colors</label>
      <input class="input" id="loop-colors" placeholder="#ff0000,#00ff00,#0000ff" style="width:100%;font-family:monospace;">
      <div style="font-size:11px;color:var(--muted);margin-top:4px;">Comma-separated hex values (optional)</div>
    </div>
    <div class="form-group" id="loop-image-group" style="display:none;">
      <label>Image Path</label>
      <input class="input" id="loop-image-path" placeholder="/path/to/background.png" style="width:100%;font-family:monospace;">
      <div style="font-size:11px;color:var(--muted);margin-top:4px;">Path to background image for visual_type='image'</div>
    </div>
  </div>
  <button class="btn btn-primary" id="loop-btn" style="margin-top:20px;" onclick="generateLoop()">🎬 Generate Loop Video</button>
</div>

<!-- Result -->
<div id="result-section" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generated Video</h3>
  <div id="result-content"></div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type='success') {
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'success' ? 'success' : 'error'}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

function onVisualTypeChange() {
  const vt = document.getElementById('loop-visual-type').value;
  const group = document.getElementById('loop-image-group');
  group.style.display = vt === 'image' ? 'block' : 'none';
}

async function generateLoop() {
  const audioPath = document.getElementById('loop-audio-path').value.trim();
  if (!audioPath) return showToast('Enter an audio file path', 'error');

  const btn = document.getElementById('loop-btn');
  btn.textContent = '⏳ Generating...';
  btn.disabled = true;

  const body = {
    audio_path: audioPath,
    duration_minutes: parseInt(document.getElementById('loop-duration').value) || 60,
    visual_type: document.getElementById('loop-visual-type').value,
    resolution: document.getElementById('loop-resolution').value,
  };

  const colors = document.getElementById('loop-colors').value.trim();
  if (colors) body.colors = colors;

  if (body.visual_type === 'image') {
    const imgPath = document.getElementById('loop-image-path').value.trim();
    if (imgPath) body.image_path = imgPath;
  }

  try {
    const r = await fetch(`${PY_API}/loop/create`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (!r.ok) {
      const errData = await r.json().catch(() => ({}));
      throw new Error(errData.detail || errData.error || `HTTP ${r.status}`);
    }

    const data = await r.json();
    const section = document.getElementById('result-section');
    section.style.display = 'block';

    if (data.success && data.filename) {
      const videoUrl = `${PY_API}/loop/video/${data.filename}`;
      const dims = body.resolution.split('x');
      const statsHtml = `
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
          <span class="badge badge-blue">📐 ${body.resolution}</span>
          <span class="badge badge-green">⏱️ ${body.duration_minutes} min</span>
          <span class="badge badge-purple">🎨 ${body.visual_type}</span>
          ${data.file_size ? `<span class="badge badge-orange">💾 ${(data.file_size / 1024 / 1024).toFixed(1)} MB</span>` : ''}
        </div>`;

      let html = statsHtml;
      html += `<video controls style="width:100%;max-width:720px;border-radius:10px;margin-bottom:16px;background:#000;">
        <source src="${videoUrl}" type="video/mp4">
        Your browser does not support the video tag.
      </video>`;
      html += `<div><a href="${videoUrl}" class="btn btn-primary" download style="text-decoration:none;">⬇️ Download Video</a></div>`;

      if (data.file_path) {
        html += `<div style="margin-top:12px;font-size:11px;color:var(--muted);font-family:monospace;">📁 ${data.file_path}</div>`;
      }

      document.getElementById('result-content').innerHTML = html;
      showToast(`✅ Loop video generated!`);
    } else {
      document.getElementById('result-content').innerHTML = `<div style="color:var(--red);">❌ ${data.detail || data.error || 'Generation failed'}</div>`;
      showToast('❌ ' + (data.detail || data.error || 'Failed'), 'error');
    }
  } catch (e) {
    const section = document.getElementById('result-section');
    section.style.display = 'block';
    document.getElementById('result-content').innerHTML = `<div style="color:var(--red);">❌ ${e.message}</div>`;
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '🎬 Generate Loop Video';
  btn.disabled = false;
}
</script>
