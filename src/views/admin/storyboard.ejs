<!-- Storyboard Creator Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">🎬 Storyboard Creator</h1>
    <p class="section-sub">Generate AI storyboards from text prompts with scene images and layout preview</p>
  </div>
</div>

<!-- Creation form -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">New Storyboard</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Video Concept / Prompt</label>
      <textarea class="input" id="sb-prompt" rows="3" placeholder="E.g., A romantic sunset beach proposal, cinematic drone shots..." style="width:100%;resize:vertical;"></textarea>
    </div>
    <div class="form-group">
      <label>Visual Style</label>
      <select class="input" id="sb-style" style="width:100%;">
        <option value="cinematic">🎥 Cinematic</option>
        <option value="anime">🌸 Anime</option>
        <option value="realistic">📸 Realistic</option>
        <option value="product">🛍️ Product</option>
        <option value="dark">🌑 Dark & Moody</option>
        <option value="vibrant">🌈 Vibrant</option>
      </select>
    </div>
    <div class="form-group">
      <label>Aspect Ratio</label>
      <select class="input" id="sb-aspect" style="width:100%;">
        <option value="16:9">🖥️ 16:9 (Widescreen)</option>
        <option value="9:16">📱 9:16 (Vertical/Reels)</option>
        <option value="1:1">⬛ 1:1 (Square)</option>
        <option value="4:3">📺 4:3 (Classic)</option>
      </select>
    </div>
    <div class="form-group">
      <label>Number of Scenes</label>
      <input class="input" id="sb-scenes" type="number" value="4" min="2" max="6" style="width:100%;">
    </div>
  </div>
  <button class="btn btn-gold" style="margin-top:20px;" onclick="createStoryboard()">🎬 Generate Storyboard</button>
</div>

<!-- Loading indicator -->
<div id="sb-loading" style="display:none;text-align:center;padding:40px;">
  <div style="font-size:18px;margin-bottom:12px;">🎬 Creating your storyboard...</div>
  <div class="loading-spinner" style="width:32px;height:32px;border:3px solid var(--border);border-top-color:var(--gold);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto;"></div>
  <div style="font-size:13px;color:var(--muted);margin-top:12px;">Generating scenes & AI images</div>
</div>

<!-- Results -->
<div id="sb-result" style="display:none;">
  <!-- Header info -->
  <div class="card" style="margin-bottom:20px;">
    <div style="display:flex;justify-content:space-between;align-items:center;">
      <div>
        <h3 style="font-size:16px;font-weight:700;">Storyboard Preview</h3>
        <div id="sb-meta" style="font-size:13px;color:var(--muted);margin-top:4px;"></div>
      </div>
      <button class="btn btn-ghost" onclick="window.location.reload()">🔄 New Storyboard</button>
    </div>
  </div>

  <!-- Scene cards -->
  <div id="sb-scenes" style="display:grid;gap:20px;"></div>
</div>

<!-- Error display -->
<div id="sb-error" class="card" style="display:none;margin-bottom:20px;border-color:var(--red);">
  <div id="sb-error-msg" style="color:var(--red);"></div>
</div>

<style>
@keyframes spin { to { transform: rotate(360deg); } }
.scene-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
}
.scene-card .scene-img {
  width: 100%;
  aspect-ratio: 16/9;
  object-fit: cover;
  display: block;
  background: var(--bg);
}
.scene-card .scene-body {
  padding: 16px;
}
.scene-card .scene-title {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 4px;
}
.scene-card .scene-duration {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 10px;
}
.scene-card .scene-desc {
  font-size: 13px;
  line-height: 1.5;
  margin-bottom: 10px;
  color: var(--text);
}
.scene-card .scene-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.scene-card .scene-tag {
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 4px;
  background: rgba(255,215,0,0.1);
  color: var(--gold);
}
.scene-card .scene-notes {
  font-size: 12px;
  color: var(--muted);
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--border);
}
</style>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type='success') {
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'success' ? 'success' : 'error'}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function createStoryboard() {
  const prompt = document.getElementById('sb-prompt').value.trim();
  if (!prompt) return showToast('Enter a video concept prompt', 'error');

  // Show loading
  document.getElementById('sb-loading').style.display = 'block';
  document.getElementById('sb-result').style.display = 'none';
  document.getElementById('sb-error').style.display = 'none';

  const btn = document.querySelector('.btn-gold');
  btn.textContent = '⏳ Generating...';
  btn.disabled = true;

  try {
    const r = await fetch(`${PY_API}/storyboard/create`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        prompt,
        style: document.getElementById('sb-style').value,
        num_scenes: parseInt(document.getElementById('sb-scenes').value) || 4,
        aspect_ratio: document.getElementById('sb-aspect').value,
      }),
    });
    const data = await r.json();

    document.getElementById('sb-loading').style.display = 'none';

    if (data.success && data.scenes) {
      // Meta info
      document.getElementById('sb-meta').textContent =
        `${data.total_scenes} scenes · ${data.total_duration_seconds}s total · ${data.style} style · ${data.aspect_ratio}`;

      // Scene cards
      const container = document.getElementById('sb-scenes');
      container.innerHTML = data.scenes.map(scene => {
        const imgSrc = scene.image_path ? `${PY_API}/storyboard/image/${scene.image_path}` : '';
        return `<div class="scene-card">
          ${imgSrc ? `<img class="scene-img" src="${imgSrc}" alt="${scene.title}" onerror="this.style.display='none'">` : ''}
          <div class="scene-body">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
              <div class="scene-title">${scene.scene_number}. ${scene.title}</div>
              <span class="scene-tag" style="font-size:11px;">${scene.duration_seconds || '?'}s</span>
            </div>
            <div class="scene-desc">${scene.description || ''}</div>
            <div class="scene-tags">
              ${scene.camera ? `<span class="scene-tag">📷 ${scene.camera}</span>` : ''}
              ${scene.transition ? `<span class="scene-tag">➡️ ${scene.transition}</span>` : ''}
              ${scene.narration ? `<span class="scene-tag">🎙️ ${scene.narration.substring(0, 40)}${scene.narration.length > 40 ? '...' : ''}</span>` : ''}
            </div>
            ${scene.notes ? `<div class="scene-notes">📝 ${scene.notes}</div>` : ''}
            ${scene.image_prompt ? `<div style="margin-top:8px;font-size:11px;color:var(--muted);padding:8px;background:var(--bg);border-radius:6px;font-family:monospace;">${scene.image_prompt}</div>` : ''}
          </div>
        </div>`;
      }).join('');

      document.getElementById('sb-result').style.display = 'block';
      showToast('✅ Storyboard created!');
    } else {
      document.getElementById('sb-error').style.display = 'block';
      document.getElementById('sb-error-msg').textContent = '❌ ' + (data.error || 'Generation failed');
      showToast('❌ ' + (data.error || 'Failed'), 'error');
    }
  } catch (e) {
    document.getElementById('sb-loading').style.display = 'none';
    document.getElementById('sb-error').style.display = 'block';
    document.getElementById('sb-error-msg').textContent = '❌ ' + e.message;
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '🎬 Generate Storyboard';
  btn.disabled = false;
}
</script>
