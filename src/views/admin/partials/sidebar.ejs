<%
  // activePage: 'dashboard' | 'playground' | 'providers' | 'settings' | 'medias' | 'prompts' | 'dynamic-pricing'
  const _ap = typeof activePage !== 'undefined' ? activePage : 'dashboard';
  function _nav(page) { return _ap === page ? 'nav-item active' : 'nav-item'; }
%>
<button class="hamburger" onclick="document.getElementById('sidebar').classList.toggle('open')">&#9776;</button>
<div class="sidebar" id="sidebar">
  <nav style="flex: 1; padding: 12px 0; overflow-y: auto;">
    <div style="padding: 20px; border-bottom: 1px solid var(--border);">
      <div style="font-size: 16px; font-weight: 700; color: var(--gold);">⚡ Vilona Content</div>
      <div style="font-size: 11px; color: var(--muted); margin-top: 2px;">Admin Dashboard</div>
    </div>
    <div class="nav-category" onclick="toggleCategory(this)">
      <span class="nav-category-icon">📊</span>
      <span class="nav-category-label">Business</span>
      <span class="nav-category-arrow">▶</span>
    </div>
    <div class="nav-category-items" id="cat-business">
      <div class="<%= _nav('dashboard') %>" id="nav-dashboard" onclick="window.location='/admin/dashboard'">📊 Overview</div>
      <div class="nav-item" id="nav-users" onclick="window.location='/admin/dashboard#users'">👥 Users</div>
      <div class="nav-item" id="nav-transactions" onclick="window.location='/admin/dashboard#transactions'">💳 Transactions</div>
      <div class="nav-item" id="nav-analytics" onclick="window.location='/admin/dashboard#analytics'">📈 Analytics</div>
      <div class="nav-item" id="nav-profit" onclick="window.location='/admin/dashboard#profit'">💹 Revenue</div>
      <div class="nav-item" id="nav-tokens" onclick="window.location='/admin/dashboard#tokens'">🪙 Token Usage</div>
    </div>

    <!-- 💰 Pricing & Monetization -->
    <div class="nav-category" onclick="toggleCategory(this)">
      <span class="nav-category-icon">💰</span>
      <span class="nav-category-label">Monetization</span>
      <span class="nav-category-arrow">▶</span>
    </div>
    <div class="nav-category-items" id="cat-monetization">
      <div class="nav-item" id="nav-pricing" onclick="window.location='/admin/dashboard#pricing'">💰 Pricing</div>
      <div class="<%= _nav('dynamic-pricing') %>" onclick="window.location='/admin/dynamic-pricing'">💵 Dynamic Pricing</div>
      <div class="nav-item" id="nav-niches" onclick="window.location='/admin/dashboard#niches'">🏷️ Niches</div>
      <div class="nav-item" id="nav-landing-page" onclick="window.location='/admin/dashboard#landing-page'">🌐 Landing Page</div>
    </div>

    <!-- 🎬 Content & Creative -->
    <div class="nav-category" onclick="toggleCategory(this)">
      <span class="nav-category-icon">🎬</span>
      <span class="nav-category-label">Content</span>
      <span class="nav-category-arrow">▶</span>
    </div>
    <div class="nav-category-items" id="cat-content">
      <div class="<%= _nav('medias') %>" onclick="window.location='/admin/medias'">🎬 Media Gallery</div>
      <div class="<%= _nav('prompts') %>" onclick="window.location='/admin/prompts'">✍️ Prompts</div>
      <div class="<%= _nav('personas') %>" onclick="window.location='/admin/personas'">🎭 Personas</div>
      <div class="<%= _nav('playground') %>" onclick="window.location='/admin/playground'">🧪 Playground</div>
    </div>

    <!-- 🤖 Content Automation -->
    <div class="nav-category" onclick="toggleCategory(this)">
      <span class="nav-category-icon">🤖</span>
      <span class="nav-category-label">Automation</span>
      <span class="nav-category-arrow">▶</span>
    </div>
    <div class="nav-category-items" id="cat-automation">
      <div class="nav-item" id="nav-content-calendar" onclick="window.location='/admin/calendar'">📅 Content Calendar</div>
      <div class="nav-item" id="nav-trending" onclick="window.location='/admin/trending'">🔥 Trending Scanner</div>
      <div class="nav-item" id="nav-ab-tests" onclick="window.location='/admin/ab-tests'">🧪 A/B Tests</div>
      <div class="nav-item" id="nav-carousel" onclick="window.location='https://content.aitradepulse.com/app/mini'">🖼️ Carousels (MiniApp)</div>
      <div class="nav-item" id="nav-remeta" onclick="window.location='https://content.aitradepulse.com/app/mini'">🔄 Re-Metadata (MiniApp)</div>
      <div class="nav-item" id="nav-repurpose" onclick="window.location='https://content.aitradepulse.com/app/mini'">🔀 Repurpose (MiniApp)</div>
    </div>

    <!-- 🔌 Technical -->
    <div class="nav-category" onclick="toggleCategory(this)">
      <span class="nav-category-icon">🔌</span>
      <span class="nav-category-label">Technical</span>
      <span class="nav-category-arrow">▶</span>
    </div>
    <div class="nav-category-items" id="cat-technical">
      <div class="<%= _nav('providers') %>" onclick="window.location='/admin/providers'">🔌 Providers</div>
      <div class="<%= _nav('ai-config') %>" onclick="window.location='/admin/ai-config'">🤖 AI Config</div>
      <div class="<%= _nav('interceptions') %>" onclick="window.location='/admin/interceptions'">🎯 Interceptions</div>
    </div>

    <!-- ⚙️ System -->
    <div class="nav-category" onclick="toggleCategory(this)">
      <span class="nav-category-icon">⚙️</span>
      <span class="nav-category-label">System</span>
      <span class="nav-category-arrow">▶</span>
    </div>
    <div class="nav-category-items" id="cat-system">
      <div class="<%= _nav('settings') %>" onclick="window.location='/admin/settings'">⚙️ Settings</div>
      <div class="nav-item" onclick="window.location='/admin/dashboard#ai-assistant'">🤖 AI Assistant</div>
    </div>

  </nav>
  <div style="padding: 16px 20px; border-top: 1px solid var(--border);">
    <div id="live-clock" style="font-size: 12px; color: var(--muted); font-family: monospace;"></div>
    <button class="btn btn-ghost btn-sm" style="margin-top: 8px; width: 100%; justify-content: center;" onclick="logout ? logout() : (localStorage.removeItem('admin_password'), document.cookie='admin_token=; Max-Age=0; Path=/;', location.href='/admin/login')">🚪 Logout</button>
  </div>
</div>

<style>
  .nav-category {
    display: flex;
    align-items: center;
    padding: 8px 16px;
    margin: 4px 8px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    user-select: none;
  }
  .nav-category:hover {
    background: rgba(255,255,255,0.05);
  }
  .nav-category-icon {
    font-size: 14px;
    margin-right: 8px;
  }
  .nav-category-label {
    flex: 1;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .nav-category-arrow {
    font-size: 10px;
    color: var(--muted);
    transition: transform 0.2s;
  }
  .nav-category.open .nav-category-arrow {
    transform: rotate(90deg);
  }
  .nav-category-items {
    display: none;
    padding: 0 0 4px 0;
  }
  .nav-category-items.open {
    display: block;
  }
  .nav-category-items .nav-item {
    padding-left: 36px;
  }
</style>

<script>
// Toggle category expand/collapse
function toggleCategory(el) {
  const items = el.nextElementSibling;
  const isOpen = items.classList.contains('open');
  
  // Close all categories
  document.querySelectorAll('.nav-category-items').forEach(item => {
    item.classList.remove('open');
  });
  document.querySelectorAll('.nav-category').forEach(cat => {
    cat.classList.remove('open');
  });
  
  // Toggle clicked category
  if (!isOpen) {
    items.classList.add('open');
    el.classList.add('open');
    // Save state
    localStorage.setItem('nav_cat_' + items.id, 'open');
  } else {
    localStorage.removeItem('nav_cat_' + items.id);
  }
}

// Restore category states on load
function restoreCategoryStates() {
  document.querySelectorAll('.nav-category-items').forEach(items => {
    if (localStorage.getItem('nav_cat_' + items.id) === 'open') {
      items.classList.add('open');
      items.previousElementSibling.classList.add('open');
    }
  });
}

// Auto-expand category containing active item
function expandActiveCategory() {
  const activeItem = document.querySelector('.nav-item.active');
  if (activeItem) {
    const categoryItems = activeItem.closest('.nav-category-items');
    if (categoryItems) {
      categoryItems.classList.add('open');
      categoryItems.previousElementSibling.classList.add('open');
    }
  }
}

// Handle hash-based active states for dashboard subsections
function updateDashboardNav() {
  const hash = window.location.hash.replace('#', '');
  const isDashboard = window.location.pathname === '/admin/dashboard';

  // Handle Overview active state (only active when NO hash)
  const overviewEl = document.getElementById('nav-dashboard');
  if (overviewEl) {
    if (isDashboard && !hash) {
      overviewEl.classList.add('active');
    } else {
      overviewEl.classList.remove('active');
    }
  }

  // Remove active class from all dashboard subsections
  const subsections = ['users', 'transactions', 'analytics', 'pricing', 'tokens', 'profit', 'niches', 'landing-page', 'content-calendar', 'carousel', 'remeta', 'repurpose', 'trending', 'ab-tests'];
  subsections.forEach(section => {
    const el = document.getElementById(`nav-${section}`);
    if (el) el.classList.remove('active');
  });

  // Add active class to current subsection
  if (hash && subsections.includes(hash)) {
    const activeEl = document.getElementById(`nav-${hash}`);
    if (activeEl) activeEl.classList.add('active');
  }
  
  // Expand category containing active item
  expandActiveCategory();
}

// Initialize
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    restoreCategoryStates();
    updateDashboardNav();
  });
} else {
  restoreCategoryStates();
  updateDashboardNav();
}
window.addEventListener('hashchange', updateDashboardNav);
</script>
