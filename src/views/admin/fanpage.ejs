<% /* Fanpage Manager — CRUD for Facebook Page tokens */ %>
<div class="admin-header">
  <h1>📘 Fanpage Manager</h1>
  <p class="text-muted">Manage Facebook Page access tokens for content distribution</p>
</div>

<div class="card" style="margin-bottom: 24px;">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
    <div>
      <strong>Registered Pages</strong>
      <span class="badge" id="page-count-badge" style="margin-left: 8px;">0</span>
    </div>
    <button class="btn btn-primary btn-sm" onclick="openAddModal()">+ Add Page</button>
  </div>
  <div class="card-body">
    <div style="overflow-x: auto;">
      <table class="data-table" id="fanpage-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Page Name</th>
            <th>Page ID</th>
            <th>User ID</th>
            <th>Category</th>
            <th>Fans</th>
            <th>Status</th>
            <th>Last Used</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="fanpage-tbody">
          <tr><td colspan="9" class="text-muted" style="text-align:center; padding: 32px;">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add/Edit Modal -->
<div class="modal-overlay" id="page-modal" style="display: none;" onclick="if(event.target===this)closeModal()">
  <div class="modal" style="max-width: 520px;">
    <div class="modal-header">
      <h3 id="modal-title">Add Facebook Page</h3>
      <button class="btn btn-ghost btn-sm" onclick="closeModal()">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="edit-id" value="">
      <div class="form-group">
        <label>User ID</label>
        <input class="form-control" id="field-userId" placeholder="e.g. telegram_123456" required>
      </div>
      <div class="form-group">
        <label>Page ID</label>
        <input class="form-control" id="field-pageId" placeholder="Facebook Page ID" required>
      </div>
      <div class="form-group">
        <label>Page Name</label>
        <input class="form-control" id="field-pageName" placeholder="My Facebook Page" required>
      </div>
      <div class="form-group">
        <label>Access Token</label>
        <textarea class="form-control" id="field-accessToken" rows="3" placeholder="EAAx..." style="font-family: monospace; font-size: 12px;" required></textarea>
      </div>
      <div class="form-row" style="display: flex; gap: 12px;">
        <div class="form-group" style="flex: 1;">
          <label>Category (optional)</label>
          <input class="form-control" id="field-category" placeholder="e.g. Business">
        </div>
        <div class="form-group" style="flex: 1;">
          <label>Fan Count</label>
          <input class="form-control" id="field-fanCount" type="number" min="0" placeholder="0">
        </div>
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" id="field-isActive" checked> Active
        </label>
      </div>
    </div>
    <div class="modal-footer" style="display: flex; gap: 8px; justify-content: flex-end;">
      <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" id="modal-save-btn" onclick="savePage()">Save</button>
    </div>
  </div>
</div>

<!-- Delete Confirm Modal -->
<div class="modal-overlay" id="delete-modal" style="display: none;" onclick="if(event.target===this)closeDeleteModal()">
  <div class="modal" style="max-width: 400px;">
    <div class="modal-header">
      <h3>Confirm Delete</h3>
      <button class="btn btn-ghost btn-sm" onclick="closeDeleteModal()">&times;</button>
    </div>
    <div class="modal-body">
      <p>Delete page <strong id="delete-page-name"></strong>?</p>
      <p class="text-muted" style="font-size: 13px;">This will remove the access token. Content distribution workflows that use this page may fail.</p>
    </div>
    <div class="modal-footer" style="display: flex; gap: 8px; justify-content: flex-end;">
      <button class="btn btn-ghost" onclick="closeDeleteModal()">Cancel</button>
      <button class="btn btn-danger" id="delete-confirm-btn" onclick="confirmDelete()">Delete</button>
    </div>
  </div>
</div>

<style>
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .data-table th, .data-table td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--border); }
  .data-table th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--muted); font-weight: 600; }
  .data-table tr:hover { background: rgba(255,255,255,0.03); }
  .status-badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .status-active { background: #10b98120; color: #10b981; }
  .status-inactive { background: #6b728020; color: #9ca3af; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 12px; font-weight: 600; background: var(--gold); color: #000; }
  .action-btn { padding: 4px 10px; font-size: 12px; cursor: pointer; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: var(--text); }
  .action-btn:hover { background: rgba(255,255,255,0.08); }
  .action-btn.danger:hover { background: #ef444420; border-color: #ef4444; color: #ef4444; }
  .text-muted { color: var(--muted); }
  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; }
  .card-header { padding: 16px 20px; border-bottom: 1px solid var(--border); }
  .card-body { padding: 16px 20px; }
  .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 1000; display: flex; align-items: center; justify-content: center; }
  .modal { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; width: 100%; max-height: 90vh; overflow-y: auto; }
  .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--border); }
  .modal-body { padding: 20px; }
  .modal-footer { padding: 12px 20px; border-top: 1px solid var(--border); }
  .form-group { margin-bottom: 14px; }
  .form-group label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 4px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .form-control { width: 100%; padding: 8px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font-size: 14px; }
  .form-control:focus { outline: none; border-color: var(--gold); }
  .checkbox-label { display: flex; align-items: center; gap: 8px; font-size: 13px; cursor: pointer; }
  .checkbox-label input[type="checkbox"] { width: 16px; height: 16px; }
  .btn { padding: 8px 16px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 13px; transition: all 0.15s; }
  .btn-primary { background: var(--gold); color: #000; }
  .btn-primary:hover { opacity: 0.9; }
  .btn-danger { background: #ef4444; color: #fff; }
  .btn-danger:hover { opacity: 0.9; }
  .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
  .btn-ghost:hover { background: rgba(255,255,255,0.08); }
  .btn-sm { padding: 4px 12px; font-size: 12px; }
  .admin-header { margin-bottom: 24px; }
  .admin-header h1 { margin: 0 0 4px; font-size: 24px; }
  .toast { position: fixed; bottom: 24px; right: 24px; padding: 12px 20px; border-radius: 8px; color: #fff; font-size: 13px; z-index: 2000; opacity: 0; transition: opacity 0.3s; }
  .toast.show { opacity: 1; }
  .toast.success { background: #10b981; }
  .toast.error { background: #ef4444; }
</style>

<div class="toast" id="toast"></div>

<script>
const API = window.location.origin + '/api/fanpages';
let deleteId = null;

// ── Load ─────────────────────────────────────────────────────
async function loadPages() {
  const tbody = document.getElementById('fanpage-tbody');
  tbody.innerHTML = '<tr><td colspan="9" class="text-muted" style="text-align:center; padding: 32px;">Loading...</td></tr>';
  try {
    const res = await fetch(API);
    if (!res.ok) throw new Error('Failed to load');
    const pages = await res.json();
    document.getElementById('page-count-badge').textContent = pages.length;
    if (pages.length === 0) {
      tbody.innerHTML = '<tr><td colspan="9" class="text-muted" style="text-align:center; padding: 32px;">No pages registered yet.</td></tr>';
      return;
    }
    tbody.innerHTML = pages.map(p => {
      const statusClass = p.isActive ? 'status-active' : 'status-inactive';
      const statusText = p.isActive ? 'Active' : 'Inactive';
      const lastUsed = p.lastUsedAt ? new Date(p.lastUsedAt).toLocaleDateString() : '—';
      return `<tr>
        <td style="font-family:monospace;font-size:11px;">${p.id}</td>
        <td><strong>${esc(p.pageName)}</strong></td>
        <td style="font-family:monospace;font-size:11px;">${esc(p.pageId)}</td>
        <td style="font-family:monospace;font-size:11px;">${esc(p.userId)}</td>
        <td>${esc(p.category || '—')}</td>
        <td>${p.fanCount?.toLocaleString() || '—'}</td>
        <td><span class="status-badge ${statusClass}">${statusText}</span></td>
        <td>${lastUsed}</td>
        <td style="white-space:nowrap;">
          <button class="action-btn" onclick="openEditModal(${p.id})">Edit</button>
          <button class="action-btn danger" onclick="openDeleteModal(${p.id}, '${esc(p.pageName)}')">Del</button>
        </td>
      </tr>`;
    }).join('');
  } catch (e) {
    tbody.innerHTML = '<tr><td colspan="9" class="text-muted" style="text-align:center; padding: 32px; color:#ef4444;">Failed to load pages.</td></tr>';
    showToast('Failed to load pages: ' + e.message, 'error');
  }
}

// ── Create / Update ──────────────────────────────────────────
async function savePage() {
  const editId = document.getElementById('edit-id').value;
  const body = {
    userId: document.getElementById('field-userId').value.trim(),
    pageId: document.getElementById('field-pageId').value.trim(),
    pageName: document.getElementById('field-pageName').value.trim(),
    accessToken: document.getElementById('field-accessToken').value.trim(),
    category: document.getElementById('field-category').value.trim() || undefined,
    fanCount: parseInt(document.getElementById('field-fanCount').value) || 0,
    isActive: document.getElementById('field-isActive').checked,
  };
  if (!body.userId || !body.pageId || !body.pageName || !body.accessToken) {
    showToast('Please fill all required fields.', 'error');
    return;
  }
  const btn = document.getElementById('modal-save-btn');
  btn.disabled = true; btn.textContent = 'Saving...';
  try {
    const url = editId ? `${API}/${editId}` : API;
    const method = editId ? 'PUT' : 'POST';
    const res = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.error || (editId ? 'Update failed' : 'Create failed'));
    }
    closeModal();
    showToast(editId ? 'Page updated' : 'Page added', 'success');
    loadPages();
  } catch (e) {
    showToast(e.message, 'error');
  } finally {
    btn.disabled = false; btn.textContent = 'Save';
  }
}

// ── Delete ───────────────────────────────────────────────────
function openDeleteModal(id, name) {
  deleteId = id;
  document.getElementById('delete-page-name').textContent = name;
  document.getElementById('delete-modal').style.display = 'flex';
}
function closeDeleteModal() {
  deleteId = null;
  document.getElementById('delete-modal').style.display = 'none';
}
async function confirmDelete() {
  if (!deleteId) return;
  const btn = document.getElementById('delete-confirm-btn');
  btn.disabled = true; btn.textContent = 'Deleting...';
  try {
    const res = await fetch(`${API}/${deleteId}`, { method: 'DELETE' });
    if (!res.ok) throw new Error('Delete failed');
    closeDeleteModal();
    showToast('Page deleted', 'success');
    loadPages();
  } catch (e) {
    showToast(e.message, 'error');
  } finally {
    btn.disabled = false; btn.textContent = 'Delete';
  }
}

// ── Modal helpers ────────────────────────────────────────────
function openAddModal() {
  document.getElementById('modal-title').textContent = 'Add Facebook Page';
  document.getElementById('edit-id').value = '';
  ['field-userId','field-pageId','field-pageName','field-accessToken','field-category','field-fanCount'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('field-isActive').checked = true;
  document.getElementById('page-modal').style.display = 'flex';
}
async function openEditModal(id) {
  document.getElementById('modal-title').textContent = 'Edit Facebook Page';
  document.getElementById('edit-id').value = id;
  try {
    const res = await fetch(`${API}/${id}`);
    if (!res.ok) throw new Error('Not found');
    const p = await res.json();
    document.getElementById('field-userId').value = p.userId;
    document.getElementById('field-pageId').value = p.pageId;
    document.getElementById('field-pageName').value = p.pageName;
    document.getElementById('field-accessToken').value = p.accessToken;
    document.getElementById('field-category').value = p.category || '';
    document.getElementById('field-fanCount').value = p.fanCount || 0;
    document.getElementById('field-isActive').checked = p.isActive;
    document.getElementById('page-modal').style.display = 'flex';
  } catch (e) {
    showToast('Failed to load page details: ' + e.message, 'error');
  }
}
function closeModal() {
  document.getElementById('page-modal').style.display = 'none';
}

// ── Utilities ────────────────────────────────────────────────
function showToast(msg, type) {
  const el = document.getElementById('toast');
  el.textContent = msg; el.className = 'toast ' + type + ' show';
  setTimeout(() => el.classList.remove('show'), 3500);
}

// ── Init ─────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', loadPages);
</script>
