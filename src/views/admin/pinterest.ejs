<!-- Pinterest → Facebook Pipeline Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">📌 Pinterest → Facebook</h1>
    <p class="section-sub">Search Pinterest images and post directly to HOMELIVING fanpages</p>
  </div>
</div>

<!-- Search form -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">🔍 Search Pinterest</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Search Query</label>
      <input class="input" id="pin-query" type="text" value="home living decor" placeholder="E.g., minimalis living room, rak dinding aesthetic..." style="width:100%;">
    </div>
    <div class="form-group">
      <label>Results Limit</label>
      <input class="input" id="pin-limit" type="number" value="12" min="1" max="50" style="width:100%;">
    </div>
  </div>
  <button class="btn btn-gold" style="margin-top:20px;" onclick="searchPinterest()">🔍 Search Pinterest</button>
</div>

<!-- Loading -->
<div id="pin-loading" style="display:none;text-align:center;padding:40px;">
  <div style="font-size:18px;margin-bottom:12px;">🔍 Searching Pinterest...</div>
  <div class="loading-spinner" style="width:32px;height:32px;border:3px solid var(--border);border-top-color:var(--gold);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto;"></div>
</div>

<!-- Results grid -->
<div id="pin-results" style="display:none;">
  <div class="card" style="margin-bottom:20px;">
    <div style="display:flex;justify-content:space-between;align-items:center;">
      <div>
        <h3 style="font-size:16px;font-weight:700;">📸 Search Results</h3>
        <div id="pin-meta" style="font-size:13px;color:var(--muted);margin-top:4px;"></div>
      </div>
      <button class="btn btn-ghost" onclick="document.getElementById('pin-results').style.display='none';document.getElementById('pin-results').innerHTML='<div id=\\'pin-meta\\'></div>';">✕ Clear</button>
    </div>
  </div>
  <div id="pin-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;"></div>
</div>

<!-- Error -->
<div id="pin-error" class="card" style="display:none;margin-bottom:20px;border-color:var(--red);">
  <div id="pin-error-msg" style="color:var(--red);"></div>
</div>

<!-- Post dialog -->
<div id="pin-post-modal" class="modal-overlay" style="display:none;">
  <div class="modal" style="max-width:500px;">
    <h3 style="margin-bottom:16px;">📤 Post to Facebook</h3>
      <img id="post-preview" style="width:80px;height:80px;object-fit:cover;border-radius:8px;background:var(--bg);">
      <div style="font-size:13px;color:var(--muted);flex:1;">
        <div>Posting to:</div>
        <select class="input" id="post-page" style="width:100%;margin-top:4px;">
          <option value="">— Select a Facebook page —</option>
          <option value="1228320850362715">🏢 Gaya Ngantor Katalog</option>
          <option value="1180497218477425">🛋️ Sudut Nyaman Go</option>
          <option value="1091128494093952">🛏️ Kamar Estetik Space</option>
          <option value="1212341095288340">🍳 Dapur Minimalis Hub</option>
          <option value="1076073462253318">👕 Berkah Karya Laundry</option>
        </select>
</div>
    <div class="form-group">
      <label>Caption</label>
      <textarea class="input" id="post-caption" rows="3" placeholder="Write your caption..." style="width:100%;resize:vertical;">Checkout this amazing home living product! 🏠✨</textarea>
    </div>
    <div class="form-group">
      <label>Link (optional — Shopee affiliate link)</label>
      <input class="input" id="post-link" type="text" placeholder="https://shopee.co.id/..." style="width:100%;">
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:20px;">
      <button class="btn btn-ghost" onclick="closePostModal()">Cancel</button>
      <button class="btn btn-primary" onclick="confirmPost()">📤 Post Now</button>
    </div>
  </div>
<!-- Post loading -->
<div id="pin-posting" style="display:none;text-align:center;padding:40px;">
  <div style="font-size:18px;margin-bottom:12px;">📤 Posting to Facebook...</div>
  <div class="loading-spinner" style="width:32px;height:32px;border:3px solid var(--border);border-top-color:var(--gold);border-radius:50%;animation:spin 1s linear infinite;margin:0 auto;"></div>
  <div style="font-size:13px;color:var(--muted);margin-top:12px;">Downloading image & posting via Facebook Graph API</div>
</div>

<style>
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 24px;
  width: 90%;
  max-width: 500px;
}
@keyframes spin { to { transform: rotate(360deg); } }
</style>
<script>
const PY_API = window.location.origin + '/api/py';
let selectedImageUrl = '';

const FB_PAGES = [
  { id: '1228320850362715', name: '🏢 Gaya Ngantor Katalog' },
  { id: '1180497218477425', name: '🛋️ Sudut Nyaman Go' },
  { id: '1091128494093952', name: '🛏️ Kamar Estetik Space' },
  { id: '1212341095288340', name: '🍳 Dapur Minimalis Hub' },
  { id: '1076073462253318', name: '👕 Berkah Karya Laundry' },
];

function showToast(msg, type) {
  const t = document.createElement('div');
  t.className = 'toast toast-' + (type === 'error' ? 'error' : 'success');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function searchPinterest() {
  const query = document.getElementById('pin-query').value.trim();
  if (!query) return showToast('Enter a search query', 'error');
  const limit = parseInt(document.getElementById('pin-limit').value) || 12;
  const btn = document.querySelector('.btn-gold');
  btn.textContent = '🔍 Searching...';
  btn.disabled = true;
  document.getElementById('pin-loading').style.display = 'block';
  document.getElementById('pin-error').style.display = 'none';
  document.getElementById('pin-results').style.display = 'none';
  try {
    const res = await fetch(PY_API + '/pinterest/search', {
      method: 'POST', headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({keyword: query, limit})
    });
    const data = await res.json();
    const results = data.results || data;
    if (!Array.isArray(results) || results.length === 0) {
      showToast('No results found', 'error');
      document.getElementById('pin-loading').style.display = 'none';
      btn.textContent = '🔍 Search Pinterest';
      btn.disabled = false;
      return;
    }
    const meta = document.getElementById('pin-meta');
    if (meta) meta.textContent = results.length + ' results for "' + query + '"';
    const grid = document.getElementById('pin-grid');
    grid.innerHTML = results.map(function(pin, i) {
      const imgUrl = pin.image || pin.images?.orig?.url || '';
      const desc = (pin.title || pin.description || '').substring(0, 80);
      return '<div class="card" style="display:flex;flex-direction:column;overflow:hidden;">' +
        (imgUrl ? '<img src="' + imgUrl + '" style="width:100%;aspect-ratio:1;object-fit:cover;background:var(--bg);" onerror="this.style.display=\'none\'">' : '') +
        '<div style="padding:12px;flex:1;display:flex;flex-direction:column;">' +
        '<div style="font-size:13px;font-weight:500;margin-bottom:4px;flex:1;">' + desc + '</div>' +
        (imgUrl ? '<button class="btn btn-sm btn-primary" onclick="openPostModal(\'' + imgUrl.replace(/'/g, "\\'") + '\')" style="width:100%;">📤 Post to FB</button>' : '') +
        '</div></div>';
    }).join('');
    document.getElementById('pin-results').style.display = 'block';
    showToast('✅ Found ' + results.length + ' results');
  } catch (e) {
    document.getElementById('pin-error').style.display = 'block';
    document.getElementById('pin-error-msg').textContent = '❌ ' + (e.message || e);
    showToast('❌ Search failed: ' + (e.message || e), 'error');
  } finally {
    document.getElementById('pin-loading').style.display = 'none';
    btn.textContent = '🔍 Search Pinterest';
    btn.disabled = false;
  }
}

function openPostModal(imgUrl) {
  selectedImageUrl = imgUrl;
  document.getElementById('post-preview').src = imgUrl;
  document.getElementById('pin-post-modal').style.display = 'flex';
}

function closePostModal() {
  document.getElementById('pin-post-modal').style.display = 'none';
  selectedImageUrl = '';
}

async function confirmPost() {
  const message = document.getElementById('post-caption').value.trim();
  if (!message) return showToast('Enter a caption', 'error');
  const pageId = document.getElementById('post-page').value;
  if (!pageId) return showToast('Select a Facebook page', 'error');
  const affiliateLink = document.getElementById('post-link').value.trim() || '';

  closePostModal();
  document.getElementById('pin-posting').style.display = 'block';

  try {
    const r = await fetch(PY_API + '/publish-to-facebook', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        image_url: selectedImageUrl,
        page_id: pageId,
        message: message,
        affiliate_link: affiliateLink,
      }),
    });
    const data = await r.json();
    document.getElementById('pin-posting').style.display = 'none';

    if (data.success) {
      const sel = document.getElementById('post-page');
      const pageName = sel.options[sel.selectedIndex].text;
      showToast('✅ Posted successfully to ' + pageName + '!');
    } else {
      showToast('❌ ' + (data.detail || 'Post failed'), 'error');
    }
  } catch (e) {
    document.getElementById('pin-posting').style.display = 'none';
    showToast('❌ ' + e.message, 'error');
  }
}
</script>
