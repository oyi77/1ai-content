<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Config \u2014 BerkahKarya Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/public/design-system.css">
  <style>
    :root {
      /* Admin color overrides (base tokens in design-system.css) */
      --color-bg: #0d0d14;
      --color-bg-elevated: #111118;
      --color-card: #1a1a24;
      --color-card-hover: rgba(255,255,255,0.08);
      --color-border: #2a2a3a;
      --color-border-strong: rgba(255,255,255,0.15);
      --color-text: #e0e0f0;
      --color-muted: #888899;
      --color-green: #4ade80;
      --color-red: #f87171;
      --color-blue: #3b82f6;
      --color-yellow: #fbbf24;
    }
    
    /* Surface-specific overrides only */
    .input {
      background: #0d0d14;
      border-color: var(--color-border);
    }
    .input:focus {
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px rgba(168,85,247,0.15);
    }
    
    .chip {
      background: var(--color-card);
      border-color: var(--color-border);
      color: var(--color-muted);
    }
    .chip:hover {
      border-color: var(--color-accent);
      background: rgba(168,85,247,0.1);
      color: var(--color-accent);
    }
    .chip.active {
      background: var(--color-accent);
      color: #fff;
      border-color: var(--color-accent);
    }
    
    .card {
      background: var(--color-card);
      border-color: var(--color-border);
      border-radius: var(--radius);
    }
    .card:active {
      background: var(--color-card-hover);
      transform: scale(0.98);
    }
    
    .stat { background: var(--color-card); border-color: var(--color-border); }
    .stat .value { 
      background: var(--color-grad); 
      -webkit-background-clip: text; 
      background-clip: text; 
      -webkit-text-fill-color: transparent; 
    }
    
    .action-btn { background: var(--color-card); border-color: var(--color-border); }
    .action-btn:active { transform: scale(0.95); background: var(--color-card-hover); }
    
    .nav-item.active { color: var(--color-accent); }
    
    .progress-bar .fill { background: var(--color-grad); }
    
    .empty .title { color: var(--color-text); }
    .empty .desc { color: var(--color-muted); }
    
    .modal { background: var(--color-card); border-color: var(--color-border); }
    .modal-handle { background: var(--color-border); }
    .modal-close:hover { background: var(--color-card); color: var(--color-text); }
    
    /* Version badge */
    #version-badge { z-index: 999; }
  </style>
</head>
<body>

<!-- Config page uses layout.ejs via reply.view with layout: 'admin/layout.ejs' -->
<div class="page-header">
  <div>
    <h1 class="page-title">Environment Config</h1>
    <p class="page-sub">All 72 environment variables grouped by concern. Secrets are masked. Green = configured, yellow = using default, red = not set.</p>
  </div>
</div>

<!-- Toolbar -->
<div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
  <input class="input" id="search" placeholder="Filter by key name..." style="max-width: 320px;" oninput="filterRows(this.value)" />
  <button class="btn btn-ghost btn-sm" onclick="expandAll()">Expand All</button>
  <button class="btn btn-ghost btn-sm" onclick="collapseAll()">Collapse All</button>
  <button class="btn btn-primary btn-sm" onclick="loadConfig()">&#8635; Refresh</button>
  <span id="summary" style="font-size: 12px; color: var(--muted);"></span>
</div>

<div id="config-container">
  <div style="text-align: center; padding: 40px; color: var(--muted);">Loading configuration...</div>
</div>

<script>
  let configData = {};

  async function loadConfig() {
    document.getElementById('config-container').innerHTML =
      '<div style="text-align: center; padding: 40px; color: var(--muted);">Loading...</div>';
    try {
      const res = await fetch('/api/config');
      if (!res.ok) throw new Error('HTTP ' + res.status);
      configData = await res.json();
      renderConfig(configData);
    } catch (e) {
      document.getElementById('config-container').innerHTML =
        '<div style="text-align: center; padding: 40px; color: #f87171;">Failed to load config: ' + e.message + '</div>';
    }
  }

  function renderConfig(data, filterText) {
    const groups = {};
    for (const [key, entry] of Object.entries(data)) {
      if (!groups[entry.group]) groups[entry.group] = [];
      groups[entry.group].push({ key, ...entry });
    }

    const ft = (filterText || '').toLowerCase();
    let totalSet = 0, totalUnset = 0, totalDefault = 0;

    let html = '';
    for (const [group, entries] of Object.entries(groups)) {
      const filtered = ft ? entries.filter(e => e.key.toLowerCase().includes(ft)) : entries;
      if (filtered.length === 0) continue;

      const groupId = 'group-' + group.replace(/[^a-z0-9]/gi, '-').toLowerCase();

      let rowsHtml = '';
      for (const entry of filtered) {
        const isUnset = entry.value === '(not set)';
        const isDefault = !isUnset && !entry.sensitive && isDefaultValue(entry.key, entry.value);
        let badgeClass, badgeLabel;
        if (isUnset) {
          badgeClass = 'badge-inactive'; badgeLabel = 'not set';
          totalUnset++;
        } else if (isDefault) {
          badgeClass = 'badge-warning'; badgeLabel = 'default';
          totalDefault++;
        } else {
          badgeClass = 'badge-active'; badgeLabel = 'set';
          totalSet++;
        }

        rowsHtml += `
          <article class="data-card" data-key="${entry.key}">
            <div class="data-card-header">
              <div class="data-card-title">${entry.key}</div>
              <span class="badge ${badgeClass}">${badgeLabel}</span>
            </div>
            <div class="data-card-meta">
              <div class="meta-row">
                <span class="meta-label">Value</span>
                <span class="meta-value" style="font-family:monospace;font-size:12px;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(entry.value)}</span>
              </div>
              ${entry.sensitive ? '<div class="meta-row"><span class="meta-label">Type</span><span class="meta-value" style="color:var(--color-yellow)">Secret (masked)</span></div>' : ''}
            </div>
          </article>`;
      }

      html += `
        <section class="group-wrapper" id="${groupId}-wrapper">
          <div class="group-header" onclick="toggleGroup('${groupId}')" style="display:flex;justify-content:space-between;align-items:center;padding:12px 0;cursor:pointer;">
            <h2 class="section-title">${group} <span style="font-weight:400;font-size:12px;color:var(--muted);">(${filtered.length})</span></h2>
            <span id="${groupId}-arrow" style="transition:transform 0.2s;">&#9660;</span>
          </div>
          <div class="card-grid" id="${groupId}-body" style="display:grid;">
            ${rowsHtml}
          </div>
        </section>`;
    }

    document.getElementById('config-container').innerHTML = html || '<div class="empty-state"><div class="empty-icon">&#128269;</div><div class="empty-title">No matching variables</div><div class="empty-desc">Try adjusting your filter</div></div>';

    if (!ft) {
      document.getElementById('summary').textContent =
        `${totalSet} set \u00b7 ${totalDefault} default \u00b7 ${totalUnset} not set`;
    } else {
      document.getElementById('summary').textContent = '';
    }
  }

  const DEFAULTS = {
    NODE_ENV: 'development',
    PORT: '3000',
    LOG_LEVEL: 'info',
    FORCE_POLLING: 'false',
    DEMO_MODE: 'false',
    VIDEO_DIR: '/tmp/videos',
    AUDIO_DIR: '/tmp/audio',
    MIDTRANS_ENVIRONMENT: 'sandbox',
    TRIPAY_ENVIRONMENT: 'sandbox',
    DUITKU_ENVIRONMENT: 'sandbox',
    USD_TO_IDR_RATE: '16000',
    FEATURE_PAYMENT: 'false',
    FEATURE_REFERRAL: 'false',
    FEATURE_VIDEO_GENERATION: 'false',
    REDIS_URL: 'redis://localhost:6379',
  };

  function isDefaultValue(key, val) {
    return DEFAULTS[key] !== undefined && val === DEFAULTS[key];
  }

  function filterRows(text) {
    renderConfig(configData, text);
  }

  function toggleGroup(id) {
    const body = document.getElementById(id + '-body');
    const arrow = document.getElementById(id + '-arrow');
    if (!body) return;
    const isHidden = body.style.display === 'none';
    body.style.display = isHidden ? 'grid' : 'none';
    if (arrow) arrow.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(-90deg)';
  }

  function expandAll() {
    document.querySelectorAll('.card-grid').forEach(el => { el.style.display = 'grid'; });
    document.querySelectorAll('[id$="-arrow"]').forEach(el => { el.style.transform = 'rotate(0deg)'; });
  }

  function collapseAll() {
    document.querySelectorAll('.card-grid').forEach(el => { el.style.display = 'none'; });
    document.querySelectorAll('[id$="-arrow"]').forEach(el => { el.style.transform = 'rotate(-90deg)'; });
  }

  function logout() {
    document.cookie = 'admin_token=; Max-Age=0; Path=/';
    window.location.href = '/admin/login';
  }

  loadConfig();
</script>

<script>
console.info("1ai-content UI v4 \u2014 Suno-inspired theme");
</script>

<div id="version-badge">v4</div>
</body>
</html>