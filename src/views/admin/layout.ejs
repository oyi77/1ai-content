<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' \u2014 Vilona Admin' : 'Vilona Content Admin' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/public/design-system.css">
  <style>
    :root {
      /* Design system tokens for design-system.css */
      --color-bg: #0d0d14;
      --color-bg-elevated: #111118;
      --color-card: #1a1a24;
      --color-card-hover: rgba(255,255,255,0.08);
      --color-border: #2a2a3a;
      --color-border-strong: rgba(255,255,255,0.15);
      --color-accent: #a855f7;
      --color-accent-dim: #7c3aed;
      --color-accent-glow: rgba(168,85,247,0.15);
      --color-grad: linear-gradient(135deg, #a855f7, #6366f1);
      --color-grad-hover: linear-gradient(135deg, #9333ea, #4f46e5);
      --color-text: #e0e0f0;
      --color-muted: #888899;
      --color-green: #4ade80;
      --color-red: #f87171;
      --color-blue: #3b82f6;
      --color-yellow: #fbbf24;
      --radius: 14px;
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      
      /* Legacy aliases */
      --bg: var(--color-bg);
      --sidebar: #111118;
      --card: #1a1a24;
      --border: #2a2a3a;
      --accent: var(--color-accent);
      --accent-dim: var(--color-accent-dim);
      --grad: var(--color-grad);
      --text: var(--color-text);
      --muted: var(--color-muted);
      --green: var(--color-green);
      --red: var(--color-red);
      --blue: var(--color-blue);
      --yellow: var(--color-yellow);
      --gold: var(--color-accent);
      --gold-dim: var(--color-accent-dim);
    }

    /* ========== LAYOUT - Collapsible sidebar rail ========== */
    * { box-sizing: border-box; }
    body { 
      background: var(--bg); 
      color: var(--text); 
      font-family: 'Inter', system-ui, sans-serif; 
      margin: 0; 
      min-height: 100vh; 
    }
    
    /* Slim sidebar rail (64px) - expands on hover */
    .sidebar { 
      background: var(--sidebar); 
      border-right: 1px solid var(--border); 
      width: 64px; 
      min-height: 100vh; 
      position: fixed; 
      top: 0; 
      left: 0; 
      z-index: 50; 
      display: flex; 
      flex-direction: column; 
      transition: width 0.25s ease, padding 0.25s ease;
      overflow: hidden;
    }
    .sidebar:hover { width: 240px; }
    
    .sidebar-header { 
      padding: 16px; 
      border-bottom: 1px solid var(--border); 
      display: flex; 
      align-items: center; 
      gap: 12px; 
      min-height: 64px;
    }
    .sidebar:hover .sidebar-header { justify-content: flex-start; }
    .brand-icon { 
      font-size: 24px; 
      flex-shrink: 0; 
    }
    .brand-text { 
      font-size: 16px; 
      font-weight: 700; 
      color: var(--accent); 
      white-space: nowrap; 
      opacity: 0; 
      transform: translateX(-10px); 
      transition: opacity 0.15s ease, transform 0.15s ease; 
    }
    .sidebar:hover .brand-text { opacity: 1; transform: translateX(0); }
    .brand-version { 
      font-size: 11px; 
      color: var(--muted); 
      margin-top: 2px; 
      opacity: 0; 
      white-space: nowrap; 
    }
    .sidebar:hover .brand-version { opacity: 1; }
    
    .sidebar-nav { 
      flex: 1; 
      padding: 12px 0; 
      overflow-y: auto; 
    }
    .nav-item { 
      display: flex; 
      align-items: center; 
      gap: 12px; 
      padding: 12px 16px; 
      cursor: pointer; 
      border-left: 3px solid transparent; 
      transition: all 0.15s; 
      color: var(--muted); 
      font-size: 14px; 
      text-decoration: none; 
      position: relative;
    }
    .nav-item::before { 
      content: attr(data-label); 
      opacity: 0; 
      white-space: nowrap; 
      transform: translateX(-10px); 
      transition: opacity 0.15s ease, transform 0.15s ease; 
    }
    .sidebar:hover .nav-item::before { opacity: 1; transform: translateX(0); }
    .nav-item:hover { 
      background: rgba(168,85,247,0.08); 
      color: var(--text); 
    }
    .nav-item.active { 
      border-left-color: var(--accent); 
      color: var(--accent); 
      background: rgba(168,85,247,0.1); 
    }
    .nav-icon { 
      font-size: 18px; 
      flex-shrink: 0; 
      width: 24px; 
      text-align: center; 
    }
    
    .sidebar-footer { 
      padding: 16px; 
      border-top: 1px solid var(--border); 
    }
    .btn-logout { 
      width: 100%; 
      justify-content: center; 
    }
    .btn-logout span { opacity: 0; }
    .sidebar:hover .btn-logout span { opacity: 1; }
    
    /* Main content - shifts with sidebar */
    .main { 
      margin-left: 64px; 
      padding: 24px; 
      min-height: 100vh; 
      overflow-y: auto; 
      transition: margin-left 0.25s ease;
    }
    .sidebar:hover + .main { margin-left: 240px; }
    
    /* Mobile: sidebar off-canvas */
    @media (max-width: 768px) {
      .sidebar { 
        transform: translateX(-100%); 
        width: 240px; 
        box-shadow: 0 0 40px rgba(0,0,0,0.4); 
      }
      .sidebar.open { transform: translateX(0); }
      .main { margin-left: 0; }
      .hamburger { display: block; }
    }

    /* ========== HAMBURGER (mobile only) ========== */
    .hamburger { 
      display: none; 
      position: fixed; 
      top: 12px; 
      left: 12px; 
      z-index: 200; 
      background: var(--accent); 
      border: none; 
      border-radius: 8px; 
      padding: 8px 10px; 
      cursor: pointer; 
      font-size: 18px; 
      color: #000; 
    }
    @media (max-width: 768px) {
      .hamburger { display: block; }
    }

    /* ========== PAGE HEADER ========== */
    .page-header { 
      display: flex; 
      justify-content: space-between; 
      align-items: center; 
      margin-bottom: 24px; 
      flex-wrap: wrap; 
      gap: 16px; 
    }
    .page-title { 
      font-size: 24px; 
      font-weight: 800; 
      background: var(--grad); 
      -webkit-background-clip: text; 
      background-clip: text; 
      -webkit-text-fill-color: transparent; 
    }
    .page-sub { 
      font-size: 14px; 
      color: var(--muted); 
      margin-top: 4px; 
    }

    /* ========== CARD GRID (replaces tables) ========== */
    .card-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); 
      gap: 16px; 
    }
    @media (max-width: 768px) {
      .card-grid { grid-template-columns: 1fr; }
    }
    
    .data-card { 
      background: var(--card); 
      border: 1px solid var(--border); 
      border-radius: var(--radius); 
      padding: 20px; 
      transition: all 0.2s ease; 
    }
    .data-card:hover { 
      border-color: rgba(168,85,247,0.25); 
      transform: translateY(-2px); 
      box-shadow: 0 8px 24px rgba(0,0,0,0.2); 
    }
    .data-card-header { 
      display: flex; 
      justify-content: space-between; 
      align-items: flex-start; 
      margin-bottom: 16px; 
      gap: 12px; 
    }
    .data-card-title { 
      font-weight: 700; 
      font-size: 16px; 
    }
    .data-card-meta { 
      display: flex; 
      flex-direction: column; 
      gap: 8px; 
    }
    .meta-row { 
      display: flex; 
      align-items: center; 
      gap: 8px; 
      font-size: 13px; 
      color: var(--muted); 
    }
    .meta-label { 
      text-transform: uppercase; 
      letter-spacing: 0.5px; 
      font-size: 10px; 
      color: var(--muted); 
    }
    .meta-value { 
      font-weight: 600; 
      color: var(--text); 
    }
    .data-card-actions { 
      display: flex; 
      gap: 8px; 
      margin-top: 16px; 
      padding-top: 16px; 
      border-top: 1px solid var(--border); 
    }

    /* ========== STAT CARDS ========== */
    .kpi-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); 
      gap: 16px; 
      margin-bottom: 24px; 
    }
    .stat-card { 
      background: var(--card); 
      border: 1px solid var(--border); 
      border-radius: var(--radius); 
      padding: 20px; 
      transition: all 0.2s; 
    }
    .stat-card:hover { 
      border-color: rgba(168,85,247,0.25); 
      transform: translateY(-2px); 
    }
    .stat-label { 
      font-size: 12px; 
      color: var(--muted); 
      text-transform: uppercase; 
      letter-spacing: 0.5px; 
      margin-bottom: 8px; 
    }
    .stat-value { 
      font-size: 28px; 
      font-weight: 800; 
      background: var(--grad); 
      -webkit-background-clip: text; 
      background-clip: text; 
      -webkit-text-fill-color: transparent; 
      line-height: 1.1; 
    }
    .stat-sub { 
      font-size: 12px; 
      color: var(--muted); 
      margin-top: 4px; 
    }

    /* ========== ACTION CARDS ========== */
    .action-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); 
      gap: 16px; 
      margin-bottom: 24px; 
    }
    .action-card { 
      background: var(--card); 
      border: 1px solid var(--border); 
      border-radius: var(--radius); 
      padding: 24px; 
      text-align: center; 
      cursor: pointer; 
      transition: all 0.25s ease; 
    }
    .action-card:hover { 
      background: rgba(255,255,255,0.05); 
      border-color: rgba(168,85,247,0.25); 
      transform: translateY(-4px); 
      box-shadow: 0 12px 32px rgba(0,0,0,0.2); 
    }
    .action-icon { 
      font-size: 32px; 
      margin-bottom: 12px; 
    }
    .action-title { 
      font-size: 15px; 
      font-weight: 600; 
    }

    /* ========== WIZARD STEPPER ========== */
    .wizard-stepper { 
      display: flex; 
      gap: 8px; 
      margin-bottom: 32px; 
      overflow-x: auto; 
      padding-bottom: 8px; 
    }
    .step { 
      flex-shrink: 0; 
      display: flex; 
      align-items: center; 
      gap: 8px; 
      white-space: nowrap; 
    }
    .step-line { 
      flex: 1; 
      height: 3px; 
      background: var(--border); 
      border-radius: 9999px; 
      position: relative; 
      max-width: 80px; 
    }
    .step-line::before { 
      content: ''; 
      position: absolute; 
      top: 0; 
      left: 0; 
      height: 100%; 
      background: var(--grad); 
      border-radius: 9999px; 
      width: 0%; 
      transition: width 0.4s ease; 
    }
    .step-dot { 
      width: 32px; 
      height: 32px; 
      border-radius: 50%; 
      background: var(--border); 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      font-size: 14px; 
      font-weight: 700; 
      color: var(--muted); 
      transition: all 0.3s ease; 
      z-index: 1; 
    }
    .step-dot.active { 
      background: var(--grad); 
      color: #fff; 
      box-shadow: 0 0 20px rgba(168,85,247,0.4); 
    }
    .step-dot.done { 
      background: var(--accent); 
      color: #fff; 
    }
    .step-label { 
      display: none; 
      font-size: 12px; 
      color: var(--muted); 
      max-width: 120px; 
    }
    .wizard-stepper:hover .step-label { display: block; }

    /* ========== SECTION TITLES ========== */
    .section-title { 
      font-size: 18px; 
      font-weight: 700; 
      margin-bottom: 4px; 
    }
    .section-sub { 
      color: var(--muted); 
      font-size: 14px; 
      margin-bottom: 20px; 
    }

    /* ========== BADGES ========== */
    .badge { 
      display: inline-flex; 
      align-items: center; 
      padding: 4px 10px; 
      border-radius: 9999px; 
      font-size: 11px; 
      font-weight: 600; 
      white-space: nowrap; 
    }
    .badge-active { background: rgba(34,197,94,0.15); color: var(--green); }
    .badge-inactive { background: rgba(107,114,128,0.15); color: #9ca3af; }
    .badge-pending { background: rgba(234,179,8,0.15); color: #eab308; }
    .badge-processing { background: rgba(59,130,246,0.15); color: var(--blue); }
    .badge-completed { background: rgba(34,197,94,0.15); color: var(--green); }
    .badge-failed { background: rgba(239,68,68,0.15); color: var(--red); }

    /* ========== EMPTY STATE ========== */
    .empty-state { 
      text-align: center; 
      padding: 48px 24px; 
      color: var(--muted); 
    }
    .empty-icon { 
      font-size: 48px; 
      margin-bottom: 16px; 
      opacity: 0.5; 
    }
    .empty-title { 
      font-size: 18px; 
      font-weight: 700; 
      margin-bottom: 8px; 
      color: var(--text); 
    }
    .empty-desc { 
      font-size: 14px; 
      max-width: 300px; 
      margin: 0 auto 24px; 
      line-height: 1.6; 
    }

    /* ========== MODAL ========== */
    .modal-overlay { 
      position: fixed; 
      inset: 0; 
      z-index: 400; 
      background: rgba(0,0,0,0.6); 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      padding: 16px; 
      opacity: 0; 
      visibility: hidden; 
      transition: all 0.2s ease; 
    }
    .modal-overlay.open { opacity: 1; visibility: visible; }
    .modal { 
      background: var(--color-modal, #161620); 
      border: 1px solid var(--color-border); 
      border-radius: 20px; 
      width: 100%; 
      max-width: 560px; 
      max-height: 85vh; 
      overflow-y: auto; 
      transform: translateY(20px) scale(0.95); 
      transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55); 
    }
    .modal-overlay.open .modal { transform: translateY(0) scale(1); }
    .modal-handle { width: 36px; height: 4px; background: var(--color-border); border-radius: 9999px; margin: 12px auto 20px; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--color-border); }
    .modal-title { font-size: 20px; font-weight: 700; }
    .modal-close { background: transparent; border: none; color: var(--muted); font-size: 24px; cursor: pointer; padding: 8px; line-height: 1; border-radius: 8px; }
    .modal-close:hover { background: var(--color-card); color: var(--text); }
    .modal-body { padding: 20px; }
    .modal-footer { display: flex; justify-content: flex-end; gap: 12px; padding: 16px 20px; border-top: 1px solid var(--color-border); }

    /* ========== TOAST ========== */
    .toast-container { 
      position: fixed; 
      bottom: 24px; 
      right: 24px; 
      z-index: 800; 
      display: flex; 
      flex-direction: column; 
      gap: 8px; 
      pointer-events: none; 
    }
    .toast { 
      background: var(--color-card); 
      border: 1px solid var(--color-border); 
      border-radius: 12px; 
      padding: 12px 16px; 
      font-size: 13px; 
      font-weight: 500; 
      max-width: 320px; 
      animation: slideIn 0.2s ease-out; 
      pointer-events: auto; 
      display: flex; 
      align-items: center; 
      gap: 8px; 
    }
    .toast-success { border-color: var(--color-success); color: var(--color-success); }
    .toast-error { border-color: var(--color-danger); color: var(--color-danger); }
    .toast-info { border-color: var(--color-accent); color: var(--color-accent); }
    @keyframes slideIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }

    /* ========== FOCUS RING ========== */
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* ========== REDUCED MOTION ========== */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { 
        animation-duration: 0.01ms !important; 
        animation-iteration-count: 1 !important; 
        transition-duration: 0.01ms !important; 
      }
      .generating { animation: none; }
    }

    /* ========== VERSION BADGE ========== */
    #version-badge { 
      position: fixed; 
      bottom: 12px; 
      right: 12px; 
      font-size: 10px; 
      color: var(--muted); 
      z-index: 999; 
      background: var(--color-card); 
      border: 1px solid var(--color-border); 
      padding: 4px 8px; 
      border-radius: 6px; 
    }

    /* ========== SCROLLBAR ========== */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--color-border-strong); }

    ::selection { background: rgba(168,85,247,0.15); color: var(--color-accent); }
  </style>
</head>
<body>

<button class="hamburger" onclick="document.querySelector('.sidebar').classList.toggle('open')">&#9776;</button>

<!-- Sidebar Rail -->
<div class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <span class="brand-icon">&#9889;</span>
    <div>
      <span class="brand-text">BerkahKarya</span>
      <div class="brand-version">Admin Dashboard v4</div>
    </div>
  </div>
  <nav class="sidebar-nav" id="sidebar-nav">
    <a href="/admin/dashboard" class="nav-item" data-label="Overview">&#128202;</a>
    <a href="/admin/pricing" class="nav-item" data-label="Pricing">&#128176;</a>
    <a href="/admin/prompts" class="nav-item" data-label="Prompts">&#9997;&#65039;</a>
    <a href="/admin/config" class="nav-item" data-label="Config">&#9881;&#65039;</a>
    <a href="/admin/system" class="nav-item" data-label="System">&#9881;</a>
    <a href="/admin/fanpage" class="nav-item" data-label="Fanpages">&#128247;</a>
    <a href="/admin/bookshelf" class="nav-item" data-label="Bookshelf">&#128218;</a>
    <a href="/admin/comic" class="nav-item" data-label="Comics">&#128248;</a>
    <a href="/admin/medias" class="nav-item" data-label="Medias">&#128396;</a>
    <a href="/admin/ab-tests" class="nav-item" data-label="A/B Tests">&#128293;</a>
    <a href="/admin/calendar" class="nav-item" data-label="Calendar">&#128197;</a>
    <a href="/admin/trending" class="nav-item" data-label="Trending">&#128293;</a>
  </nav>
  <div class="sidebar-footer">
    <button class="btn btn-ghost btn-sm btn-logout" onclick="logout()"><span class="nav-icon">&#128682;</span><span>Logout</span></button>
  </div>
</div>

<!-- Main Content -->
<div class="main">
  <%- body %>
</div>

<script>
// ==================== CLOCK ====================
function updateClock() {
  const el = document.getElementById('live-clock');
  if (el) el.textContent = new Date().toLocaleString('id-ID', { weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', second: '2-digit' });
}
setInterval(updateClock, 1000);
updateClock();

// ==================== SHARED HTML ESCAPING HELPERS ====================
function esc(s) {
  if (s == null) return '';
  var d = document.createElement('div');
  d.textContent = String(s);
  return d.innerHTML;
}
window.esc = esc;
window.escHtml = esc;
window.escAttr = function(str) {
  return String(str).replace(/'/g, "\\'").replace(/"/g, '"');
};

// ==================== SIDEBAR TOGGLE (mobile) ====================
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
}

// ==================== SET ACTIVE NAV ====================
(function() {
  const path = window.location.pathname;
  document.querySelectorAll('.nav-item').forEach(item => {
    if (item.getAttribute('href') === path) {
      item.classList.add('active');
    }
  });
})();

// ==================== TOAST ====================
function showToast(msg, type = 'info') {
  let container = document.querySelector('.toast-container');
  if (!container) {
    container = document.createElement('div');
    container.className = 'toast-container';
    document.body.appendChild(container);
  }
  const t = document.createElement('div');
  t.className = 'toast ' + (type === 'success' ? 'toast-success' : type === 'error' ? 'toast-error' : 'toast-info');
  t.textContent = msg;
  container.appendChild(t);
  setTimeout(() => t.remove(), 3500);
}
window.showToast = showToast;

// ==================== LOGOUT ====================
function logout() {
  document.cookie = 'admin_token=; Max-Age=0; Path=/';
  window.location.href = '/admin/login';
}

// ==================== VERSION LOG ====================
console.info("1ai-content UI v4 \u2014 Suno-inspired theme");
</script>

<div id="version-badge">v4</div>

</body>
</html>