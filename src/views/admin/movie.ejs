<!-- Movie / Short-Film Generator Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">🎬 Movie / Short-Film Generator</h1>
    <p class="section-sub">Generate complete short films: script → scenes → audio → video</p>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
  <!-- Generate Form -->
  <div class="card" style="grid-column:1/3;">
    <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generate Movie</h3>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
      <div class="form-group" style="grid-column:1/3;">
        <label>Story Prompt / Concept</label>
        <textarea class="input" id="m-prompt" rows="3" placeholder="e.g. A lone astronaut discovers an ancient alien artifact on Mars that rewrites the history of the solar system" style="width:100%;"></textarea>
      </div>
      <div class="form-group">
        <label>Genre</label>
        <select class="input" id="m-genre" style="width:100%;">
          <option value="short_film" selected>Short Film</option>
          <option value="documentary">Documentary</option>
          <option value="music_video">Music Video</option>
        </select>
      </div>
      <div class="form-group">
        <label>Language</label>
        <select class="input" id="m-lang" style="width:100%;">
          <option value="en" selected>English</option>
          <option value="id">Indonesian</option>
          <option value="ja">Japanese</option>
          <option value="zh">Chinese</option>
        </select>
      </div>
      <div class="form-group">
        <label>Number of Scenes</label>
        <input class="input" id="m-scenes" type="number" value="8" min="3" max="30" style="width:100%;">
      </div>
      <div class="form-group">
        <label>Visual Style</label>
        <select class="input" id="m-style" style="width:100%;">
          <option value="slideshow">Slideshow (images + audio)</option>
          <option value="full">Full Movie (images + audio + video)</option>
          <option value="script_only">Script Only</option>
        </select>
      </div>
    </div>
    <button class="btn btn-primary" style="margin-top:16px;" onclick="generateMovie()">🎬 Generate Movie</button>
  </div>

  <!-- Progress -->
  <div id="m-progress-section" class="card" style="display:none;grid-column:1/3;">
    <h3 style="margin-bottom:12px;font-size:14px;font-weight:600;">⏳ Generating...</h3>
    <div id="m-progress-msg" style="font-size:13px;color:var(--muted);margin-bottom:8px;">Starting...</div>
    <div style="height:6px;background:var(--border);border-radius:3px;overflow:hidden;">
      <div id="m-progress-bar" style="height:100%;width:0%;background:var(--grad);border-radius:3px;transition:width 0.3s;"></div>
    </div>
    <div id="m-scene-progress" style="font-size:11px;color:var(--muted);margin-top:6px;"></div>
  </div>
</div>

<!-- Script Preview -->
<div id="m-script-section" class="card" style="display:none;margin-bottom:20px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
    <h3 style="font-size:16px;font-weight:700;">📝 Script Preview</h3>
    <button class="btn btn-ghost btn-sm" onclick="toggleMovieScriptJson()">📄 Show/Hide JSON</button>
  </div>
  <div id="m-script-summary" style="font-size:13px;color:var(--muted);margin-bottom:12px;"></div>
  <div id="m-script-json" style="display:none;">
    <pre id="m-json-viewer" style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:16px;font-size:11px;max-height:300px;overflow-y:auto;white-space:pre-wrap;"></pre>
  </div>
  <div id="m-script-scenes"></div>
</div>

<!-- Cover -->
<div id="m-cover-section" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="font-size:16px;font-weight:700;margin-bottom:12px;">📽️ Cover Image</h3>
  <div id="m-cover-display"></div>
</div>

<!-- Video -->
<div id="m-video-section" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="font-size:16px;font-weight:700;margin-bottom:12px;">🎬 Generated Video</h3>
  <div id="m-video-display"></div>
</div>

<!-- Stats -->
<div id="m-stats-section" class="card" style="display:none;margin-bottom:20px;">
  <div id="m-stats" style="font-size:13px;color:var(--muted);"></div>
</div>

<!-- Error -->
<div id="m-error" class="card" style="display:none;background:var(--red-bg);border:1px solid var(--red);margin-bottom:20px;">
  <div style="display:flex;align-items:center;gap:12px;">
    <span style="font-size:24px;">❌</span>
    <div>
      <div style="font-weight:600;margin-bottom:4px;">Generation Failed</div>
      <div id="m-error-msg" style="font-size:13px;color:var(--muted);"></div>
    </div>
  </div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';
let lastScript = null;
let lastCoverPath = null;
let lastVideoPath = null;
let lastStats = null;

function showToast(msg, type) {
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'error' ? 'error' : 'success'}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function generateMovie() {
  const prompt = document.getElementById('m-prompt').value.trim();
  if (!prompt) return showToast('Enter a story prompt', 'error');

  const btn = document.querySelector('.btn-primary');
  const origText = btn.textContent;
  btn.textContent = '⏳ Generating...';
  btn.disabled = true;

  // Reset UI
  document.getElementById('m-script-section').style.display = 'none';
  document.getElementById('m-cover-section').style.display = 'none';
  document.getElementById('m-video-section').style.display = 'none';
  document.getElementById('m-stats-section').style.display = 'none';
  document.getElementById('m-error').style.display = 'none';

  const progSection = document.getElementById('m-progress-section');
  const progMsg = document.getElementById('m-progress-msg');
  const progBar = document.getElementById('m-progress-bar');
  const sceneProg = document.getElementById('m-scene-progress');
  progSection.style.display = 'block';
  progMsg.textContent = 'Starting generation...';
  progBar.style.width = '0%';
  sceneProg.textContent = '';

  try {
    const body = {
      prompt,
      genre: document.getElementById('m-genre').value,
      language: document.getElementById('m-lang').value,
      num_scenes: parseInt(document.getElementById('m-scenes').value) || 8,
      style: document.getElementById('m-style').value,
    };

    const r = await fetch(PY_API + '/movie/generate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (!r.ok) {
      const err = await r.json().catch(() => ({ detail: 'HTTP ' + r.status }));
      throw new Error(err.detail || 'HTTP ' + r.status);
    }

    // Parse SSE stream from POST response
    const reader = r.body.getReader();
    const decoder = new TextDecoder();
    let buf = '';

    while (true) {
      const { done, value } = await reader.read();
      if (done) break;

      buf += decoder.decode(value, { stream: true });
      const parts = buf.split('\n');
      buf = parts.pop() || '';

      for (const line of parts) {
        if (line.startsWith('data: ')) {
          try {
            const event = JSON.parse(line.slice(6));
            handleMovieEvent(event, body);
          } catch (e) {
            console.warn('SSE parse error:', e);
          }
        }
      }
    }

    // Handle any remaining buffered data
    if (buf.startsWith('data: ')) {
      try {
        handleMovieEvent(JSON.parse(buf.slice(6)), body);
      } catch (e) {}
    }

  } catch (e) {
    console.error('Movie generation error:', e);
    progSection.style.display = 'none';
    document.getElementById('m-error').style.display = 'block';
    document.getElementById('m-error-msg').textContent = e.message;
    showToast('❌ ' + e.message, 'error');
  } finally {
    btn.textContent = origText;
    btn.disabled = false;
  }
}

function handleMovieEvent(event, reqBody) {
  const progMsg = document.getElementById('m-progress-msg');
  const progBar = document.getElementById('m-progress-bar');
  const sceneProg = document.getElementById('m-scene-progress');

  if (event.progress !== undefined) {
    progBar.style.width = Math.round(event.progress * 100) + '%';
  }

  const type = event.type || event.status;
  progMsg.textContent = event.message || type;

  switch (type) {
    case 'script_ready': {
      const script = event.data ? event.data.script || event.data : event.script;
      if (!script) return;
      lastScript = script;

      // Show script section
      document.getElementById('m-script-section').style.display = 'block';
      document.getElementById('m-json-viewer').textContent = JSON.stringify(script, null, 2);

      // Build summary
      const scenes = script.scenes || [];
      document.getElementById('m-script-summary').textContent =
        'Title: ' + esc(script.title || 'Untitled') + ' \u00b7 ' + scenes.length + ' scene(s)';

      // Build scene list
      if (scenes.length) {
        let html = '';
        scenes.forEach(function(scene, i) {
          html += '<div style="border:1px solid var(--border);border-radius:8px;margin-bottom:8px;overflow:hidden;">';
          html += '<div onclick="toggleScene(this)" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;cursor:pointer;background:var(--bg);">';
          html += '<span style="font-weight:600;font-size:13px;">Scene ' + (i + 1) + ': ' + esc(scene.title || 'Untitled') + '</span>';
          html += '<span style="font-size:10px;color:var(--muted);">\u25B6</span></div>';
          html += '<div class="m-scene-body" style="display:none;padding:10px 14px;font-size:12px;border-top:1px solid var(--border);">';
          if (scene.description) html += '<div style="margin-bottom:6px;">' + esc(scene.description) + '</div>';
          if (scene.narration) html += '<div style="margin-bottom:6px;font-style:italic;color:var(--muted);">\uD83D\uDDE3\uFE0F ' + esc(scene.narration) + '</div>';
          if (scene.location) html += '<div style="margin-bottom:4px;font-size:11px;color:var(--muted);">\uD83D\uDCCD ' + esc(scene.location) + '</div>';
          if (scene.shots && scene.shots.length) {
            html += '<div style="font-size:11px;color:var(--muted);margin-top:6px;">' + scene.shots.length + ' shot(s)</div>';
          }
          html += '</div></div>';
        });
        document.getElementById('m-script-scenes').innerHTML = html;
      }
      break;
    }

    case 'scene_rendering': {
      const sid = event.scene_id || 0;
      const total = event.total || 0;
      const pct = total ? Math.round((sid / total) * 100) : 0;
      progBar.style.width = pct + '%';
      sceneProg.textContent = 'Rendering scene ' + sid + ' of ' + total + '...';
      break;
    }

    case 'scene_rendered': {
      const sid = event.scene_id || 0;
      sceneProg.textContent = 'Scene ' + sid + ' rendered';
      break;
    }

    case 'audio_rendering': {
      sceneProg.textContent = 'Generating audio: "' + (event.text || '').slice(0, 60) + '..."';
      break;
    }

    case 'audio_rendered': {
      sceneProg.textContent = 'Audio rendered for scene ' + (event.scene_id || '');
      break;
    }

    case 'video_assembling': {
      sceneProg.textContent = 'Assembling video segments...';
      break;
    }

    case 'complete': {
      const data = event.data || event;
      lastStats = data.stats || {};
      lastVideoPath = data.video_path || '';
      lastCoverPath = data.cover_path || '';

      // Show stats
      document.getElementById('m-stats-section').style.display = 'block';
      var statParts = [];
      if (data.title) statParts.push('Title: ' + data.title);
      if (data.duration_seconds) statParts.push('Duration: ' + Number(data.duration_seconds).toFixed(1) + 's');
      if (data.total_scenes) statParts.push('Scenes: ' + data.total_scenes);
      if (data.stats && data.stats.output_dir) statParts.push('Output: ' + esc(data.stats.output_dir));
      document.getElementById('m-stats').textContent = statParts.join(' \u00b7 ') || 'Complete';

      // Show video
      if (data.video_path) {
        document.getElementById('m-video-section').style.display = 'block';
        var vpath = data.video_path.replace(/^.*\/media\/movies\//, '');
        var vurl = PY_API + '/movie/media/' + vpath;
        document.getElementById('m-video-display').innerHTML =
          '<video controls style="width:100%;border-radius:8px;max-height:500px;background:#000;">' +
          '<source src="' + vurl + '" type="video/mp4"></video>';
      }


      // Show cover
      if (lastCoverPath) {
        document.getElementById('m-cover-section').style.display = 'block';
        var cpath = lastCoverPath.replace(/^.*\/media\/movies\//, '');
        var curl = PY_API + '/movie/media/' + cpath;
        document.getElementById('m-cover-display').innerHTML =
          '<img src="' + curl + '" style="max-width:300px;border-radius:8px;border:1px solid var(--border);" onerror="this.style.display=\'none\'">';
      }
      showToast('✅ Movie generated!');
      // Save to gallery DB
      var saveBody = {
        title: data.title || (lastScript && lastScript.title) || reqBody.prompt.slice(0, 80),
        language: reqBody.language || 'en',
        prompt: reqBody.prompt,
        script: lastScript,
        num_scenes: data.total_scenes || 0,
        duration: Math.round(data.duration_seconds || 0),
        genre: reqBody.genre || 'short_film',
        video_path: data.video_path || '',
        output_dir: (data.stats && data.stats.output_dir) || '',
        stats: lastStats || {},
        status: 'completed',
      };
      fetch('/api/movies', {
        method: 'POST',
        body: JSON.stringify(saveBody),
        credentials: 'include',
      }).then(function(r) {
        if (r.ok) showToast('✅ Saved to gallery!');
        else console.warn('Save movie failed:', r.statusText);
      }).catch(function(e) {
        console.warn('Save movie error:', e);
      });
      break;
    }

    case 'error':
    case 'error_event': {
      document.getElementById('m-progress-section').style.display = 'none';
      document.getElementById('m-error').style.display = 'block';
      document.getElementById('m-error-msg').textContent = event.message || 'Unknown error';
      break;
    }
  }
}

function toggleMovieScriptJson() {
  var el = document.getElementById('m-script-json');
  el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

function toggleScene(el) {
  var body = el.nextElementSibling;
  var arrow = el.querySelector('span:last-child');
  if (body.style.display === 'none') {
    body.style.display = 'block';
    arrow.textContent = '\u25BC';
  } else {
    body.style.display = 'none';
    arrow.textContent = '\u25B6';
  }
}
</script>
