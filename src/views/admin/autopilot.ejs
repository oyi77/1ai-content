<!-- AutoPilot Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">🤖 AutoPilot</h1>
    <p class="section-sub">Create, manage, and run autopilot content jobs</p>
  </div>
  <div style="display:flex;gap:8px;">
    <button class="btn btn-ghost" onclick="loadStatus()">📊 Refresh Status</button>
  </div>
</div>

<!-- Create Job -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">➕ Create Autopilot Job</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Job Name</label>
      <input class="input" id="job-name" placeholder="e.g. Daily Beauty Tips" style="width:100%;">
    </div>
    <div class="form-group" style="grid-column:1/3;">
      <label>Niche</label>
      <input class="input" id="job-niche" placeholder="e.g. kecantikan, teknologi, kesehatan" style="width:100%;">
    </div>
    <div class="form-group" style="grid-column:1/3;">
      <label>Platforms</label>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:4px;">
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;">
          <input type="checkbox" class="platform-cb" value="tiktok" checked> 🎵 TikTok
        </label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;">
          <input type="checkbox" class="platform-cb" value="instagram"> 📸 Instagram
        </label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;">
          <input type="checkbox" class="platform-cb" value="youtube"> ▶️ YouTube
        </label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;">
          <input type="checkbox" class="platform-cb" value="facebook"> 📘 Facebook
        </label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;">
          <input type="checkbox" class="platform-cb" value="twitter"> 🐦 Twitter / X
        </label>
      </div>
    </div>
  </div>
  <button class="btn btn-primary" id="job-btn" style="margin-top:20px;" onclick="createJob()">➕ Create Autopilot Job</button>
</div>

<!-- Jobs Status -->
<div class="card" style="margin-bottom:20px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
    <h3 style="font-size:16px;font-weight:700;">📋 Jobs Status</h3>
    <div style="display:flex;gap:8px;">
      <button class="btn btn-secondary" id="status-btn" onclick="loadStatus()">📊 Refresh Status</button>
      <button class="btn btn-primary" id="run-btn" onclick="runReady()">▶️ Run Ready Jobs</button>
    </div>
  </div>
  <div id="autopilot-jobs">
    <div style="text-align:center;padding:40px;color:var(--muted);font-size:14px;">Loading jobs...</div>
  </div>
</div>

<!-- Quick Actions -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">⚡ Quick Actions</h3>
  <div style="display:flex;gap:12px;flex-wrap:wrap;">
    <button class="btn btn-primary" id="run-ready-btn" onclick="runReady()">▶️ Run All Ready Jobs</button>
  </div>
</div>

<div id="result-section" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Result</h3>
  <div id="result-content"></div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type) {
  if (typeof type === 'undefined') type = 'success';
  const t = document.createElement('div');
  t.className = 'toast toast-' + (type === 'success' ? 'success' : 'error');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function () { t.remove(); }, 3000);
}

function esc(str) {
  if (typeof str !== 'string' && typeof str !== 'number') return '';
  var d = document.createElement('div');
  d.appendChild(document.createTextNode(String(str)));
  return d.innerHTML;
}

function getSelectedPlatforms() {
  var cbs = document.querySelectorAll('.platform-cb:checked');
  var platforms = [];
  cbs.forEach(function (cb) { platforms.push(cb.value); });
  return platforms;
}

function statusBadge(s) {
  var st = (s || '').toLowerCase();
  if (st === 'active' || st === 'running') return '<span class="badge badge-green">Active</span>';
  if (st === 'error' || st === 'failed') return '<span class="badge badge-red">Error</span>';
  if (st === 'completed') return '<span class="badge badge-blue">Completed</span>';
  return '<span class="badge badge-gray">' + esc(s) + '</span>';
}

// ── Create Job ─────────────────────────────────────────────

async function createJob() {
  var name = document.getElementById('job-name').value.trim();
  var niche = document.getElementById('job-niche').value.trim();
  var platforms = getSelectedPlatforms();

  if (!name) { showToast('Please enter a job name', 'error'); return; }
  if (!niche) { showToast('Please enter a niche', 'error'); return; }
  if (platforms.length === 0) { showToast('Please select at least one platform', 'error'); return; }

  var btn = document.getElementById('job-btn');
  btn.textContent = '⏳ Creating...';
  btn.disabled = true;

  try {
    var r = await fetch(PY_API + '/autopilot/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({
        name: name,
        niche: niche,
        platforms: platforms,
      }),
    });
    var data = await r.json();

    var section = document.getElementById('result-section');
    var content = document.getElementById('result-content');
    section.style.display = 'block';

    if (data.success || data.job_id) {
      content.innerHTML =
        '<div style="padding:16px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:10px;">' +
          '<div style="font-weight:700;margin-bottom:4px;">✅ Job Created</div>' +
          '<div style="font-size:13px;color:var(--muted);">' +
            'Name: <strong>' + esc(name) + '</strong> &middot; ' +
            'Niche: <strong>' + esc(niche) + '</strong> &middot; ' +
            'Platforms: ' + platforms.map(function (p) { return '<strong>' + esc(p) + '</strong>'; }).join(', ') +
          '</div>' +
        '</div>';
      document.getElementById('job-name').value = '';
      document.getElementById('job-niche').value = '';
      showToast('✅ Job created!');
      setTimeout(loadStatus, 500);
    } else {
      content.innerHTML = '<div style="color:var(--red);">❌ ' + esc(data.error || 'Creation failed') + '</div>';
      showToast('❌ ' + (data.error || 'Failed'), 'error');
    }
  } catch (e) {
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '➕ Create Autopilot Job';
  btn.disabled = false;
}

// ── Load Status ────────────────────────────────────────────

async function loadStatus() {
  var container = document.getElementById('autopilot-jobs');
  var btn = document.getElementById('status-btn');
  btn.textContent = '⏳ Loading...';
  btn.disabled = true;

  try {
    var r = await fetch(PY_API + '/autopilot/status', { credentials: 'include' });
    var data = await r.json();

    var jobs = data.jobs || data.data || [];
    var activeCount = data.active_jobs || 0;
    var totalCount = data.total_jobs || jobs.length;
    var lastRun = data.last_run || '—';

    if (jobs.length === 0) {
      container.innerHTML =
        '<div style="text-align:center;padding:40px;color:var(--muted);font-size:14px;">' +
          '📭 No autopilot jobs yet. Create one above.' +
        '</div>';
      btn.textContent = '📊 Refresh Status';
      btn.disabled = false;
      return;
    }

    var html =
      '<div style="margin-bottom:16px;display:flex;gap:16px;flex-wrap:wrap;">' +
        '<span class="badge badge-blue">📊 Total: ' + totalCount + '</span>' +
        '<span class="badge badge-green">✅ Active: ' + activeCount + '</span>' +
        '<span style="font-size:12px;color:var(--muted);">🕐 Last Run: ' + esc(lastRun) + '</span>' +
      '</div>' +
      '<div style="overflow-x:auto;">' +
      '<table style="width:100%;border-collapse:collapse;font-size:13px;">' +
        '<thead>' +
          '<tr style="border-bottom:1px solid var(--border);">' +
            '<th style="text-align:left;padding:10px 12px;color:var(--muted);font-size:11px;text-transform:uppercase;">Name</th>' +
            '<th style="text-align:left;padding:10px 12px;color:var(--muted);font-size:11px;text-transform:uppercase;">Niche</th>' +
            '<th style="text-align:left;padding:10px 12px;color:var(--muted);font-size:11px;text-transform:uppercase;">Platforms</th>' +
            '<th style="text-align:left;padding:10px 12px;color:var(--muted);font-size:11px;text-transform:uppercase;">Status</th>' +
            '<th style="text-align:left;padding:10px 12px;color:var(--muted);font-size:11px;text-transform:uppercase;">Created</th>' +
            '<th style="text-align:left;padding:10px 12px;color:var(--muted);font-size:11px;text-transform:uppercase;">Actions</th>' +
          '</tr>' +
        '</thead>' +
        '<tbody>';

    for (var i = 0; i < jobs.length; i++) {
      var j = jobs[i];
      var created = j.created_at || j.created || j.createdAt || '—';
      var platformsStr = (j.platforms || []).join(', ') || '—';

      html +=
        '<tr style="border-bottom:1px solid rgba(42,42,58,0.4);">' +
          '<td style="padding:10px 12px;font-weight:600;">' + esc(j.name || 'Unnamed') + '</td>' +
          '<td style="padding:10px 12px;">' + esc(j.niche || '—') + '</td>' +
          '<td style="padding:10px 12px;">' + esc(platformsStr) + '</td>' +
          '<td style="padding:10px 12px;">' + statusBadge(j.status) + '</td>' +
          '<td style="padding:10px 12px;font-size:12px;color:var(--muted);">' + esc(created) + '</td>' +
          '<td style="padding:10px 12px;">' + (j.job_id ? '<button class="btn btn-sm btn-ghost" onclick="showJobDetail(\'' + esc(j.job_id) + '\')">🔍 View</button>' : '—') + '</td>' +
        '</tr>';
    }

    html += '</tbody></table></div>';
    container.innerHTML = html;
  } catch (e) {
    container.innerHTML = '<div style="text-align:center;padding:40px;color:var(--red);font-size:14px;">❌ Failed to load jobs: ' + esc(e.message) + '</div>';
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '📊 Refresh Status';
  btn.disabled = false;
}

// ── Run Ready Jobs ─────────────────────────────────────────

async function runReady() {
  var btn = document.getElementById('run-ready-btn');
  btn.textContent = '⏳ Running...';
  btn.disabled = true;

  try {
    var r = await fetch(PY_API + '/autopilot/run', {
      method: 'POST',
      credentials: 'include',
    });
    var data = await r.json();

    var section = document.getElementById('result-section');
    var content = document.getElementById('result-content');
    section.style.display = 'block';

    if (data.success || data.jobs_run) {
      var count = data.jobs_run || 0;
      var results = data.results || [];
      var html =
        '<div style="padding:16px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:10px;margin-bottom:12px;">' +
          '<div style="font-weight:700;margin-bottom:4px;">✅ ' + count + ' job(s) triggered</div>' +
          '<div style="font-size:13px;color:var(--muted);">' + (data.message || 'Ready jobs are now running.') + '</div>' +
        '</div>';
      if (results.length > 0) {
        html += '<div style="font-size:13px;font-weight:600;margin-bottom:8px;">Results:</div>';
        for (var i = 0; i < results.length; i++) {
          var r2 = results[i];
          html += '<div style="padding:8px 12px;background:var(--bg);border-radius:6px;margin-bottom:4px;font-size:13px;">' +
            esc(r2.name || r2.job_id || 'Job ' + (i+1)) + ': ' + statusBadge(r2.status) +
          '</div>';
        }
      }
      content.innerHTML = html;
      showToast('✅ ' + count + ' job(s) triggered!');
      setTimeout(loadStatus, 1000);
    } else {
      content.innerHTML = '<div style="color:var(--red);">❌ ' + esc(data.error || 'No jobs to run') + '</div>';
      if (data.error) showToast('❌ ' + data.error, 'error');
    }
  } catch (e) {
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '▶️ Run All Ready Jobs';
  btn.disabled = false;
}

// ── Show job detail (placeholder for future expansion) ──────

function showJobDetail(jobId) {
  showToast('🔍 Job ID: ' + jobId, 'success');
}

// ── Init ────────────────────────────────────────────────────

(function() {
  // Expand the Automation category if collapsed
  var automationCat = document.getElementById('cat-automation');
  if (automationCat) {
    automationCat.classList.add('open');
    var prev = automationCat.previousElementSibling;
    if (prev && prev.classList.contains('nav-category')) {
      prev.classList.add('open');
    }
  }
  loadStatus();
})();
</script>
