<!-- Content Calendar Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">📅 Content Calendar</h1>
    <p class="section-sub">Schedule and manage content publishing</p>
  </div>
  <div style="display:flex;gap:8px;">
    <button class="btn btn-gold" onclick="showScheduleForm()">➕ Schedule Content</button>
    <button class="btn btn-ghost" onclick="loadEntries()">🔄 Refresh</button>
  </div>
</div>

<!-- Stats -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px;">
  <div class="kpi-card"><div class="label">TOTAL</div><div class="value" id="stat-total">—</div></div>
  <div class="kpi-card"><div class="label">SCHEDULED</div><div class="value" style="color:var(--yellow);" id="stat-scheduled">—</div></div>
  <div class="kpi-card"><div class="label">PUBLISHED</div><div class="value" style="color:var(--green);" id="stat-published">—</div></div>
  <div class="kpi-card"><div class="label">FAILED</div><div class="value" style="color:var(--red);" id="stat-failed">—</div></div>
</div>

<!-- Schedule Form -->
<div id="schedule-form" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Schedule New Content</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group">
      <label>Topic</label>
      <input class="input" id="cal-topic" placeholder="Tips coding untuk pemula" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Date & Time</label>
      <input class="input" id="cal-datetime" type="datetime-local" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Platform</label>
      <select class="input" id="cal-platform" style="width:100%;">
        <option value="tiktok">🎵 TikTok</option>
        <option value="instagram">📸 Instagram</option>
        <option value="youtube">▶️ YouTube</option>
      </select>
    </div>
    <div class="form-group">
      <label>Content Type</label>
      <select class="input" id="cal-type" style="width:100%;">
        <option value="video">🎬 Video</option>
        <option value="carousel">🖼️ Carousel</option>
        <option value="remeta">🔄 Re-Metadata</option>
      </select>
    </div>
    <div class="form-group">
      <label>Niche</label>
      <input class="input" id="cal-niche" placeholder="tech tips" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Style</label>
      <select class="input" id="cal-style" style="width:100%;">
        <option value="educational">Educational</option>
        <option value="viral">Viral</option>
        <option value="storytelling">Storytelling</option>
        <option value="minimal">Minimal</option>
      </select>
    </div>
  </div>
  <div style="display:flex;gap:8px;margin-top:20px;">
    <button class="btn btn-gold" onclick="scheduleContent()">📅 Schedule</button>
    <button class="btn btn-ghost" onclick="document.getElementById('schedule-form').style.display='none'">Cancel</button>
  </div>
</div>

<!-- Calendar Table -->
<div class="card">
  <table style="width:100%;border-collapse:collapse;">
    <thead>
      <tr>
        <th style="text-align:left;padding:12px;font-size:11px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);">TOPIC</th>
        <th style="text-align:left;padding:12px;font-size:11px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);">PLATFORM</th>
        <th style="text-align:left;padding:12px;font-size:11px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);">TYPE</th>
        <th style="text-align:left;padding:12px;font-size:11px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);">SCHEDULED</th>
        <th style="text-align:left;padding:12px;font-size:11px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);">STATUS</th>
        <th style="text-align:left;padding:12px;font-size:11px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);">ACTIONS</th>
      </tr>
    </thead>
    <tbody id="cal-table">
      <tr><td colspan="6" class="empty-state">Loading...</td></tr>
    </tbody>
  </table>
</div>

<div id="toast-container"></div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type='success') {
  const container = document.getElementById('toast-container');
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'success' ? 'success' : 'error'}`;
  t.textContent = msg;
  container.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

function showScheduleForm() {
  document.getElementById('schedule-form').style.display = 'block';
  document.getElementById('schedule-form').scrollIntoView({ behavior: 'smooth' });
}

async function loadEntries() {
  try {
    const r = await fetch(`${PY_API}/calendar/list/0`);
    const data = await r.json();
    const entries = data.entries || [];
    const tbody = document.getElementById('cal-table');

    if (!entries.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty-state">No scheduled content yet. Click ➕ to add.</td></tr>';
    } else {
      tbody.innerHTML = entries.map(e => {
        const statusClass = { scheduled:'badge-yellow', generating:'badge-blue', published:'badge-green', failed:'badge-red' }[e.status] || 'badge-yellow';
        const emoji = e.content_type === 'carousel' ? '🖼️' : e.content_type === 'remeta' ? '🔄' : '🎬';
        return `<tr>
          <td style="padding:12px;border-bottom:1px solid var(--border);">${emoji} ${e.topic}</td>
          <td style="padding:12px;border-bottom:1px solid var(--border);">${e.platform}</td>
          <td style="padding:12px;border-bottom:1px solid var(--border);">${e.content_type}</td>
          <td style="padding:12px;border-bottom:1px solid var(--border);font-family:monospace;font-size:12px;">${e.scheduled_at}</td>
          <td style="padding:12px;border-bottom:1px solid var(--border);"><span class="badge ${statusClass}">${e.status}</span></td>
          <td style="padding:12px;border-bottom:1px solid var(--border);"><button class="btn btn-danger btn-xs" onclick="deleteEntry('${e.id}')">🗑️</button></td>
        </tr>`;
      }).join('');
    }

    // Stats
    document.getElementById('stat-total').textContent = entries.length;
    document.getElementById('stat-scheduled').textContent = entries.filter(e => e.status === 'scheduled').length;
    document.getElementById('stat-published').textContent = entries.filter(e => e.status === 'published').length;
    document.getElementById('stat-failed').textContent = entries.filter(e => e.status === 'failed').length;
  } catch (e) {
    document.getElementById('cal-table').innerHTML = '<tr><td colspan="6" class="empty-state">Error loading calendar</td></tr>';
  }
}

async function scheduleContent() {
  const topic = document.getElementById('cal-topic').value.trim();
  const datetime = document.getElementById('cal-datetime').value;
  if (!topic) return showToast('Enter a topic', 'error');
  if (!datetime) return showToast('Select date & time', 'error');

  try {
    const r = await fetch(`${PY_API}/calendar/schedule`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        user_id: 0, topic,
        scheduled_at: datetime.replace('T', ' '),
        platform: document.getElementById('cal-platform').value,
        content_type: document.getElementById('cal-type').value,
        niche: document.getElementById('cal-niche').value.trim(),
        style: document.getElementById('cal-style').value,
      }),
    });
    const data = await r.json();
    if (data.id) {
      showToast('✅ Content scheduled!');
      document.getElementById('schedule-form').style.display = 'none';
      document.getElementById('cal-topic').value = '';
      loadEntries();
    } else {
      showToast('❌ ' + (data.error || 'Failed'), 'error');
    }
  } catch (e) { showToast('❌ ' + e.message, 'error'); }
}

async function deleteEntry(id) {
  if (!confirm('Delete this entry?')) return;
  try {
    await fetch(`${PY_API}/calendar/delete/${id}?user_id=0`, { method: 'DELETE' });
    showToast('🗑️ Deleted');
    loadEntries();
  } catch (e) { showToast('❌ ' + e.message, 'error'); }
}

loadEntries();
</script>
