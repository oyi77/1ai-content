<!-- Captions Manager Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">✍️ Captions Manager</h1>
    <p class="section-sub">Browse caption styles & presets, generate AI captions for content</p>
  </div>
  <button class="btn btn-ghost" onclick="loadStyles()">🔄 Refresh Styles</button>
</div>

<!-- Styles & Presets overview -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
  <div class="card">
    <h3 style="margin-bottom:12px;font-size:14px;font-weight:700;">🎨 Available Styles</h3>
    <div id="styles-list" class="loading">Loading styles...</div>
  </div>
  <div class="card">
    <h3 style="margin-bottom:12px;font-size:14px;font-weight:700;">📋 Available Presets</h3>
    <div id="presets-list" class="loading">Loading presets...</div>
  </div>
</div>

<!-- Generate caption form -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generate Caption</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Topic / Content Description</label>
      <input class="input" id="cap-topic" placeholder="Product launch, tips & tricks, storytelling..." style="width:100%;">
    </div>
    <div class="form-group">
      <label>Style</label>
      <select class="input" id="cap-style" style="width:100%;">
        <option value="educational">🎓 Educational</option>
        <option value="storytelling">📖 Storytelling</option>
        <option value="promotional">📣 Promotional</option>
        <option value="humor">😄 Humor</option>
        <option value="controversial">🔥 Controversial</option>
        <option value="emotional">💖 Emotional</option>
      </select>
    </div>
    <div class="form-group">
      <label>Language</label>
      <select class="input" id="cap-lang" style="width:100%;">
        <option value="id">🇮🇩 Indonesia</option>
        <option value="en">🇬🇧 English</option>
      </select>
    </div>
    <div class="form-group">
      <label>Hashtag Count</label>
      <input class="input" id="cap-hashtags" type="number" value="10" min="3" max="30" style="width:100%;">
    </div>
  </div>
  <button class="btn btn-gold" style="margin-top:20px;" onclick="generateCaption()">✍️ Generate Caption</button>
</div>

<!-- Result -->
<div id="caption-result" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Generated Caption</h3>
  <div id="caption-content"></div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type='success') {
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'success' ? 'success' : 'error'}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function loadStyles() {
  try {
    const r = await fetch(`${PY_API}/captions/styles`);
    const data = await r.json();
    const styles = data.styles || {};
    const entries = Object.entries(styles);
    const el = document.getElementById('styles-list');
    if (!entries.length) {
      el.innerHTML = '<div class="empty-state">No styles available</div>';
      return;
    }
    el.innerHTML = entries.map(([k, v]) =>
      `<div style="padding:8px 0;border-bottom:1px solid var(--border);">
        <div style="font-weight:600;font-size:13px;">${v.name || k}</div>
        <div style="font-size:11px;color:var(--muted);">${v.description || ''}</div>
      </div>`
    ).join('');
  } catch (e) {
    document.getElementById('styles-list').innerHTML =
      `<div style="color:var(--red);">❌ ${e.message}</div>`;
  }
}

async function loadPresets() {
  try {
    const r = await fetch(`${PY_API}/captions/presets`);
    const data = await r.json();
    const presets = data.presets || {};
    const entries = Object.entries(presets);
    const el = document.getElementById('presets-list');
    if (!entries.length) {
      el.innerHTML = '<div class="empty-state">No presets available</div>';
      return;
    }
    el.innerHTML = entries.map(([k, v]) =>
      `<div style="padding:8px 0;border-bottom:1px solid var(--border);">
        <div style="font-weight:600;font-size:13px;">${v.name || k}</div>
        <div style="font-size:11px;color:var(--muted);">${v.description || ''}</div>
      </div>`
    ).join('');
  } catch (e) {
    document.getElementById('presets-list').innerHTML =
      `<div style="color:var(--red);">❌ ${e.message}</div>`;
  }
}

async function generateCaption() {
  const topic = document.getElementById('cap-topic').value.trim();
  if (!topic) return showToast('Enter a topic', 'error');

  const btn = document.querySelector('.btn-gold');
  btn.textContent = '⏳ Generating...';
  btn.disabled = true;

  try {
    const r = await fetch(`${PY_API}/captions/generate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        topic,
        style: document.getElementById('cap-style').value,
        language: document.getElementById('cap-lang').value,
        hashtag_count: parseInt(document.getElementById('cap-hashtags').value) || 10,
      }),
    });
    const data = await r.json();

    const section = document.getElementById('caption-result');
    section.style.display = 'block';

    if (data.success) {
      document.getElementById('caption-content').innerHTML = `
        <div style="padding:16px;background:var(--bg);border-radius:10px;margin-bottom:12px;">
          <div style="white-space:pre-wrap;font-size:14px;line-height:1.6;">${data.caption || '—'}</div>
        </div>
        ${data.hashtags?.length ? `<div style="font-size:13px;color:var(--gold);">${data.hashtags.join(' ')}</div>` : ''}
        ${data.style ? `<div style="margin-top:8px;"><span class="badge badge-blue">${data.style}</span></div>` : ''}
      `;
      showToast('✅ Caption generated!');
    } else {
      document.getElementById('caption-content').innerHTML =
        `<div style="color:var(--red);">❌ ${data.error || 'Generation failed'}</div>`;
      showToast('❌ ' + (data.error || 'Failed'), 'error');
    }
  } catch (e) {
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '✍️ Generate Caption';
  btn.disabled = false;
}

// Load on page init
loadStyles();
loadPresets();
</script>
