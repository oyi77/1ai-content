<!-- Ad Renderer Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">📺 Ad Renderer</h1>
    <p class="section-sub">Render product advertisements as images or video clips</p>
  </div>
</div>

<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Render Product Ad</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Product Name</label>
      <input class="input" id="ad-product-name" placeholder="Smart Mug Pro" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Format</label>
      <select class="input" id="ad-format" style="width:100%;">
        <option value="image">🖼️ Image</option>
        <option value="video">🎬 Video</option>
      </select>
    </div>
    <div class="form-group">
      <label>Style / Theme</label>
      <select class="input" id="ad-style" style="width:100%;">
        <option value="minimal">Minimal</option>
        <option value="bold">Bold</option>
        <option value="vintage">Vintage</option>
        <option value="modern">Modern</option>
        <option value="luxury">Luxury</option>
      </select>
    </div>
    <div class="form-group">
      <label>Background Color (hex)</label>
      <input class="input" id="ad-bg" placeholder="#FFFFFF" value="#FFFFFF" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Text Color (hex)</label>
      <input class="input" id="ad-fg" placeholder="#000000" value="#000000" style="width:100%;">
    </div>
  </div>
  <div class="form-group" style="margin-top:12px;">
    <label>Product Image URL (optional)</label>
    <input class="input" id="ad-image" placeholder="https://example.com/product.png" style="width:100%;">
  </div>
  <div class="form-group">
    <label>Additional Copy / Tagline (optional)</label>
    <input class="input" id="ad-tagline" placeholder="The smarter way to drink coffee" style="width:100%;">
  </div>
  <button class="btn btn-gold" style="margin-top:20px;" onclick="renderAd()">📺 Render Ad</button>
</div>

<!-- Result -->
<div id="ad-result" style="display:none;margin-bottom:20px;">
  <div class="card">
    <h3 style="margin-bottom:12px;font-size:14px;font-weight:700;">Rendered Ad</h3>
    <div id="ad-output" style="padding:12px;background:var(--bg);border-radius:8px;font-size:13px;"></div>
  </div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type) {
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'success' ? 'success' : 'error'}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function renderAd() {
  const name = document.getElementById('ad-product-name').value.trim();
  if (!name) return showToast('Enter a product name', 'error');

  const btn = document.querySelector('button[onclick="renderAd()"]');
  btn.textContent = '⏳ Rendering...';
  btn.disabled = true;

  try {
    const r = await fetch(`${PY_API}/content/render-ad`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        product_name: name,
        format: document.getElementById('ad-format').value,
        style: document.getElementById('ad-style').value,
        background_color: document.getElementById('ad-bg').value || '#FFFFFF',
        text_color: document.getElementById('ad-fg').value || '#000000',
        image_url: document.getElementById('ad-image').value || undefined,
        tagline: document.getElementById('ad-tagline').value || undefined,
      }),
    });
    const data = await r.json();

    const section = document.getElementById('ad-result');
    section.style.display = 'block';

    if (data.success || data.url) {
      let html = '';
      if (data.url) {
        html += `<div style="margin-bottom:12px;">
          <a href="${data.url}" target="_blank" rel="noopener">
            <strong>View Ad</strong> ↗️
          </a>
        </div>`;
      }
      html += `<pre style="white-space:pre-wrap;margin:0;">${JSON.stringify(data, null, 2)}</pre>`;
      document.getElementById('ad-output').innerHTML = html;
      if (data.url) showToast('✅ Ad rendered!');
    } else {
      document.getElementById('ad-output').innerHTML =
        `<div style="color:var(--red);">❌ ${data.error || 'Rendering failed'}</div>`;
      showToast('❌ ' + (data.error || 'Rendering failed'), 'error');
    }
  } catch (e) {
    document.getElementById('ad-result').style.display = 'block';
    document.getElementById('ad-output').innerHTML = `<div style="color:var(--red);">❌ ${e.message}</div>`;
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '📺 Render Ad';
  btn.disabled = false;
}
</script>
