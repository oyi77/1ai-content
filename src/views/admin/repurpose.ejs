<!-- Repurpose Content Admin Page -->
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
  <div>
    <h1 class="section-title">🔀 Content Repurpose</h1>
    <p class="section-sub">Multi-source remix — download N videos, split, combine into new content with new metadata</p>
  </div>
</div>

<!-- How it works -->
<div class="card" style="margin-bottom:20px;background:var(--bg);">
  <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:8px;text-align:center;">
    <div><div style="font-size:20px;margin-bottom:4px;">📥</div><div style="font-size:10px;color:var(--muted);">Download Sources</div></div>
    <div><div style="font-size:20px;margin-bottom:4px;">✂️</div><div style="font-size:10px;color:var(--muted);">Scene Detect</div></div>
    <div><div style="font-size:20px;margin-bottom:4px;">📊</div><div style="font-size:10px;color:var(--muted);">Score Segments</div></div>
    <div><div style="font-size:20px;margin-bottom:4px;">🔗</div><div style="font-size:10px;color:var(--muted);">Assemble</div></div>
    <div><div style="font-size:20px;margin-bottom:4px;">🎨</div><div style="font-size:10px;color:var(--muted);">Color Grade</div></div>
    <div><div style="font-size:20px;margin-bottom:4px;">📝</div><div style="font-size:10px;color:var(--muted);">New Metadata</div></div>
  </div>
</div>

<!-- Form -->
<div class="card" style="margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Repurpose Content</h3>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="form-group" style="grid-column:1/3;">
      <label>Source URLs (one per line, minimum 2)</label>
      <textarea class="input" id="rep-urls" rows="4" placeholder="https://tiktok.com/video1&#10;https://tiktok.com/video2&#10;https://tiktok.com/video3" style="width:100%;resize:vertical;"></textarea>
    </div>
    <div class="form-group">
      <label>Target Duration (seconds)</label>
      <input class="input" id="rep-duration" type="number" value="120" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Platform</label>
      <select class="input" id="rep-platform" style="width:100%;">
        <option value="tiktok">🎵 TikTok (9:16)</option>
        <option value="instagram_reels">📸 IG Reels (9:16)</option>
        <option value="youtube_shorts">▶️ YouTube Shorts (9:16)</option>
        <option value="youtube">▶️ YouTube (16:9)</option>
      </select>
    </div>
    <div class="form-group">
      <label>Niche</label>
      <input class="input" id="rep-niche" placeholder="tech tips" value="general" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Style</label>
      <select class="input" id="rep-style" style="width:100%;">
        <option value="educational">Educational</option>
        <option value="viral">Viral</option>
        <option value="storytelling">Storytelling</option>
        <option value="minimal">Minimal</option>
      </select>
    </div>
    <div class="form-group">
      <label>Color Preset</label>
      <select class="input" id="rep-color" style="width:100%;">
        <option value="cinematic">🎬 Cinematic</option>
        <option value="warm">☀️ Warm</option>
        <option value="cool">❄️ Cool</option>
        <option value="vibrant">🌈 Vibrant</option>
        <option value="vintage">📼 Vintage</option>
        <option value="none">— None</option>
      </select>
    </div>
    <div class="form-group">
      <label>Transition Style</label>
      <select class="input" id="rep-transition" style="width:100%;">
        <option value="crossfade">🔄 Crossfade</option>
        <option value="fade_black">⬛ Fade Black</option>
        <option value="wipe_left">👈 Wipe Left</option>
        <option value="none">— None</option>
      </select>
    </div>
    <div class="form-group">
      <label>Watermark</label>
      <input class="input" id="rep-watermark" placeholder="@brandname" style="width:100%;">
    </div>
    <div class="form-group">
      <label>Subtitles</label>
      <select class="input" id="rep-subtitles" style="width:100%;">
        <option value="true">✅ Yes (karaoke style)</option>
        <option value="false">❌ No</option>
      </select>
    </div>
  </div>
  <button class="btn btn-gold" style="margin-top:20px;" onclick="startRepurpose()">🔄 Start Repurpose</button>
</div>

<!-- Result -->
<div id="rep-result" class="card" style="display:none;margin-bottom:20px;">
  <h3 style="margin-bottom:16px;font-size:16px;font-weight:700;">Result</h3>
  <div id="rep-content"></div>
</div>

<script>
const PY_API = window.location.origin + '/api/py';

function showToast(msg, type='success') {
  const t = document.createElement('div');
  t.className = `toast toast-${type === 'success' ? 'success' : 'error'}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

async function startRepurpose() {
  const urls = document.getElementById('rep-urls').value.trim().split('\n').filter(u => u.trim());
  if (urls.length < 2) return showToast('Minimum 2 source URLs', 'error');

  const btn = document.querySelector('.btn-gold');
  btn.textContent = '⏳ Processing (2-5 min)...';
  btn.disabled = true;

  try {
    const r = await fetch(`${PY_API}/repurpose`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        sources: urls,
        target_duration: parseInt(document.getElementById('rep-duration').value) || 120,
        platform: document.getElementById('rep-platform').value,
        niche: document.getElementById('rep-niche').value.trim() || 'general',
        style: document.getElementById('rep-style').value,
        color_preset: document.getElementById('rep-color').value,
        transition_style: document.getElementById('rep-transition').value,
        watermark_text: document.getElementById('rep-watermark').value.trim() || undefined,
        add_subtitles: document.getElementById('rep-subtitles').value === 'true',
      }),
    });
    const data = await r.json();

    const section = document.getElementById('rep-result');
    section.style.display = 'block';

    if (data.success) {
      const meta = data.metadata || {};
      const segments = data.segments_used || [];
      document.getElementById('rep-content').innerHTML = `
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;">
          <div class="kpi-card"><div class="label">Segments</div><div class="value">${segments.length}</div></div>
          <div class="kpi-card"><div class="label">Duration</div><div class="value">${data.duration || '—'}s</div></div>
          <div class="kpi-card"><div class="label">Platform</div><div style="font-size:16px;font-weight:700;margin-top:4px;">${data.platform || '—'}</div></div>
          <div class="kpi-card"><div class="label">Sources</div><div class="value">${data.sources_used?.length || urls.length}</div></div>
        </div>
        <div style="padding:16px;background:var(--bg);border-radius:10px;margin-bottom:12px;">
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;margin-bottom:8px;">Segments Used</div>
          ${segments.map((s, i) => `<div style="display:flex;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);font-size:13px;">
            <span style="color:var(--muted);width:20px;">${i+1}</span>
            <span>${s.type || 'content'}</span>
            <span style="color:var(--muted);">${s.start?.toFixed(1) || 0}s - ${s.end?.toFixed(1) || 0}s</span>
            <span style="color:var(--muted);">score: ${s.score || 0}</span>
            <span style="color:var(--muted);">speed: ${s.speed || 1}x</span>
          </div>`).join('')}
        </div>
        <div style="padding:16px;background:var(--bg);border-radius:10px;">
          <div style="font-size:11px;color:var(--muted);text-transform:uppercase;margin-bottom:8px;">New Metadata</div>
          <div style="font-size:16px;font-weight:600;">${meta.title || '—'}</div>
          <div style="font-size:13px;color:var(--muted);margin-top:8px;">${meta.caption?.slice(0, 200) || ''}</div>
          <div style="font-size:13px;color:var(--gold);margin-top:8px;">${(meta.hashtags||[]).join(' ')}</div>
        </div>
        <div style="margin-top:12px;font-size:12px;color:var(--muted);">📁 Output: ${data.video_path || '—'}</div>
      `;
      showToast(`✅ ${segments.length} segments remixed into new video!`);
    } else {
      document.getElementById('rep-content').innerHTML = `<div style="color:var(--red);">❌ ${data.error || 'Failed'}</div>`;
      showToast('❌ ' + (data.error || 'Failed'), 'error');
    }
  } catch (e) {
    showToast('❌ ' + e.message, 'error');
  }

  btn.textContent = '🔄 Start Repurpose';
  btn.disabled = false;
}
</script>
