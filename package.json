{
  "name": "openclaw-bot",
  "version": "3.1.0",
  "description": "AI Video Marketing SaaS Platform - Telegram Bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "start:prod": "NODE_ENV=production tsx src/index.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:e2e:api": "jest --config jest.e2e.config.js",
    "test:e2e:playwright": "playwright test",
    "test:e2e:bot": "cd tests/e2e/bot && python3 -m pytest -v --tb=short",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "setup": "bash scripts/setup.sh",
    "deploy": "bash scripts/deploy.sh",
    "health-check": "bash scripts/health-check.sh",
    "backup": "bash scripts/backup.sh",
    "docker:build": "docker build -t openclaw-bot:latest .",
    "docker:run": "docker run -d --env-file .env -p 3000:3000 openclaw-bot:latest",
    "prepare": "husky install",
    "render:ad": "cd services/remotion-ads && node --import tsx src/render.ts",
    "render:ad:studio": "cd services/remotion-ads && npx remotion studio src/index.tsx",
    "render:ad:hf": "cd services/hyperframes && node --import tsx src/render.ts",
    "render:ad:hf:studio": "cd services/hyperframes && hyperframes preview"
  },
  "keywords": [
    "telegram-bot",
    "ai-video",
    "marketing",
    "saas",
    "openclaw"
  ],
  "author": "OpenClaw Team <team@openclaw.ai>",
  "license": "PROPRIETARY",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@1ai/ai-pipeline": "file:../1ai/packages/ai-pipeline",
    "@1ai/platform-adapters": "file:../1ai/packages/platform-adapters",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/view": "^11.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.7.0",
    "@sentry/node": "^7.80.0",
    "@types/node-cron": "^3.0.11",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^4.15.0",
    "date-fns": "^2.30.0",
    "dotenv": "^17.0.0",
    "ejs": "^5.0.1",
    "fastify": "^5.9.0",
    "form-data": "^4.0.0",
    "google-auth-library": "^10.7.0",
    "googleapis": "^173.0.0",
    "ioredis": "^5.6.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mime-types": "^2.1.35",
    "node-cron": "^4.5.0",
    "rate-limiter-flexible": "^4.0.1",
    "telegraf": "^4.15.0",
    "uuid": "^11.0.0",
    "winston": "^3.17.0",
    "zod": "^3.25.0",
    "hyperframes": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/ejs": "^3.1.5",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/lodash": "^4.14.0",
    "@types/mime-types": "^2.1.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.0.0",
    "prisma": "^5.7.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/tests/"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/**/types.ts",
      "!src/**/mcp/**"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "clover"
    ]
  }
}
