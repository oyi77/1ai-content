// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS — Phase 5.3 of REFACTORING_AUDIT.md
// These enums replace 22+ string columns. Migration pending.
// =============================================================================

enum UserTier {
  free
  basic
  lite
  pro
  agency
}

enum VideoStatus {
  processing
  completed
  failed
  deleted
}

enum TransactionStatus {
  pending
  success
  failed
  expired
}

enum Platform {
  tiktok
  instagram
  youtube
  facebook
  twitter
}

enum Niche {
  fnb
  realestate
  product
  car
  beauty
  services
}

enum TransactionType {
  topup
  welcome_bonus
  refund
  subscription
}

enum PaymentGateway {
  tripay
  duitku
  nowpayments
  stars
  midtrans
  system
}

// =============================================================================
// USER MODEL
// =============================================================================
model User {
  id          String  @id @default(uuid())
  telegramId  BigInt  @unique @map("telegram_id")
  uuid        String  @unique @default(uuid()) @db.Uuid
  username    String? @db.VarChar(32)
  firstName   String  @map("first_name") @db.VarChar(64)
  lastName    String? @map("last_name") @db.VarChar(64)
  phoneNumber String? @map("phone_number") @db.VarChar(20)

  // Tier & Credits
  tier                String    @default("free") @db.VarChar(16)
  creditBalance       Decimal   @default(0) @map("credit_balance") @db.Decimal(10, 2)
  subscriptionCredits Int       @default(0) @map("subscription_credits")
  creditExpiresAt     DateTime? @map("credit_expires_at")

  // Referral
  referralCode String? @unique @map("referral_code") @db.VarChar(32)
  referredBy   String? @map("referred_by") @db.Uuid
  referralTier Int     @default(1) @map("referral_tier")

  // Settings
  language             String  @default("id") @db.VarChar(5)
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  autoRenewal          Boolean @default(false) @map("auto_renewal")

  // Free Trial
  welcomeBonusUsed Boolean   @default(false) @map("welcome_bonus_used")
  dailyFreeUsed    Boolean   @default(false) @map("daily_free_used")
  dailyFreeResetAt DateTime? @map("daily_free_reset_at")
  selectedNiche    String?   @map("selected_niche") @db.VarChar(32)
  userMode         String?   @map("user_mode") @db.VarChar(32)

  // Security
  isBanned      Boolean   @default(false) @map("is_banned")
  banReason     String?   @map("ban_reason")
  bannedAt      DateTime? @map("banned_at")
  fraudScore    Int       @default(0) @map("fraud_score")
  isIntercepted Boolean   @default(false) @map("is_intercepted")

  // Metadata
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  // UTM & Attribution Tracking (Full Funnel)
  utmSource   String? @map("utm_source") @db.VarChar(255)
  utmMedium   String? @map("utm_medium") @db.VarChar(255)
  utmCampaign String? @map("utm_campaign") @db.VarChar(255)
  utmContent  String? @map("utm_content") @db.VarChar(255)
  lpVariant   String? @map("lp_variant") @db.VarChar(50)

  // Attribution IDs (for platform matching)
  fbc    String? @map("fbc") @db.VarChar(500) // Facebook Click ID
  fbp    String? @map("fbp") @db.VarChar(500) // Facebook Pixel ID
  ttclid String? @map("ttclid") @db.VarChar(500) // TikTok Click ID

  // LTV Metrics
  daysToFirstPurchase   Int?    @map("days_to_first_purchase")
  signupToFirstVideoMin Int?    @map("signup_to_first_video_min")
  totalSpent            Decimal @default(0) @map("total_spent") @db.Decimal(12, 2)

  // Relations
  transactions   Transaction[]
  videos         Video[]
  commissions    Commission[]
  subscriptions  Subscription[]
  socialAccounts SocialAccount[]
  avatars        UserAvatar[]
  apiKeys        ApiKey[]
  videoClips     VideoClip[]
  videoReworks   VideoRework[]
  whiteLabelBots WhiteLabelBot[]
  viralScans     ViralScan[]
  carousels      Carousel[]
  contentCalendar ContentCalendar[]
  abTests        ABTest[]

  @@index([telegramId])
  @@index([referralCode])
  @@index([tier])
  @@index([lastActivityAt])
  @@map("users")
}

// =============================================================================
// API KEY MODEL (Agency tier — per-user revocable keys)
// =============================================================================
model ApiKey {
  id         String    @id @default(cuid())
  userId     BigInt    @map("user_id")
  keyHash    String    @unique @map("key_hash")
  keySuffix  String    @default("") @map("key_suffix") @db.VarChar(8)
  name       String    @default("Default")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// =============================================================================
// TRANSACTION MODEL
// =============================================================================
model Transaction {
  id      BigInt @id @default(autoincrement())
  orderId String @unique @map("order_id") @db.VarChar(64)
  userId  BigInt @map("user_id")

  // Transaction details
  type          String   @db.VarChar(32)
  packageName   String?  @map("package_name") @db.VarChar(32)
  amountIdr     Decimal  @map("amount_idr") @db.Decimal(12, 2)
  creditsAmount Decimal? @map("credits_amount") @db.Decimal(10, 2)

  // Payment details
  gateway              String  @db.VarChar(16)
  gatewayTransactionId String? @unique @map("gateway_transaction_id") @db.VarChar(128)
  paymentMethod        String? @map("payment_method") @db.VarChar(32)
  paymentChannel       String? @map("payment_channel") @db.VarChar(32)

  // Status tracking
  status        String @default("pending") @db.VarChar(16)
  statusHistory Json?  @map("status_history")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  paidAt    DateTime? @map("paid_at")
  expiredAt DateTime? @default(dbgenerated("NOW() + INTERVAL '30 minutes'")) @map("expired_at")

  // Metadata
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")
  metadata  Json?

  // UTM & Attribution (for LTV tracking)
  utmCampaign      String? @map("utm_campaign") @db.VarChar(255)
  utmContent       String? @map("utm_content") @db.VarChar(255)
  lpVariant        String? @map("lp_variant") @db.VarChar(50)
  daysToConversion Int?    @map("days_to_conversion")

  // Relations
  user User @relation(fields: [userId], references: [telegramId])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

// =============================================================================
// VIDEO MODEL
// =============================================================================
model Video {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  jobId  String @unique @map("job_id") @db.VarChar(64)

  // Video details
  title       String? @db.VarChar(255)
  description String? @db.Text

  // Generation params
  niche    String @db.VarChar(32)
  platform String @db.VarChar(32)
  duration Int
  scenes   Int

  // Output
  thumbnailUrl String? @map("thumbnail_url")
  videoUrl     String? @map("video_url")
  downloadUrl  String? @map("download_url")

  // Status
  status       String  @default("processing") @db.VarChar(16)
  progress     Int     @default(0)
  errorMessage String? @map("error_message")
  favorited    Boolean @default(false)

  // Credits
  creditsUsed Decimal @map("credits_used") @db.Decimal(10, 2)

  // Phase 1: Multi-provider & style fields
  styles             String[]
  storyboard         Json?
  providerChain      String[] @map("provider_chain")
  optimizedPrompts   Json?    @map("optimized_prompts")
  productAnalysis    Json?    @map("product_analysis")
  generationMetadata Json?    @map("generation_metadata")
  finalProvider      String?  @map("final_provider")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime? @default(dbgenerated("NOW() + INTERVAL '30 days'")) @map("expires_at")

  // Relations
  user User @relation(fields: [userId], references: [telegramId])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([niche])
  @@map("videos")
}

// =============================================================================
// COMMISSION MODEL (Affiliate)
// =============================================================================
model Commission {
  id         BigInt @id @default(autoincrement())
  referrerId BigInt @map("referrer_id")
  referredId BigInt @map("referred_id")

  // Commission details
  amount Decimal @db.Decimal(12, 2)
  tier   Int
  status String  @default("pending") @db.VarChar(16)

  // Availability
  availableAt DateTime  @map("available_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  referrer User @relation(fields: [referrerId], references: [telegramId])

  @@index([referrerId])
  @@index([status])
  @@index([availableAt])
  @@map("commissions")
}

// =============================================================================
// SUBSCRIPTION MODEL
// =============================================================================
model Subscription {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")

  plan         String @db.VarChar(16)
  billingCycle String @map("billing_cycle") @db.VarChar(16)

  status String @default("active") @db.VarChar(16)

  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")

  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt       DateTime? @map("cancelled_at")

  paymentMethodId String? @map("payment_method_id") @db.VarChar(64)

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [telegramId])

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// =============================================================================
// AUDIT LOG MODEL
// =============================================================================
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?  @map("user_id")
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(32)
  entityId   String   @map("entity_id") @db.VarChar(64)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// SOCIAL ACCOUNT MODEL (PostBridge Integration)
// =============================================================================
model SocialAccount {
  id          Int     @id @default(autoincrement())
  userId      BigInt  @map("user_id")
  platform    String  @db.VarChar(32) // tiktok, facebook, instagram, etc
  pbAccountId String  @unique @map("pb_account_id") @db.VarChar(64)
  accountName String? @map("account_name") @db.VarChar(128)
  avatarUrl   String? @map("avatar_url")
  status      String  @default("active") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [telegramId])

  @@index([userId])
  @@map("social_accounts")
}

// =============================================================================
// PAYMENT SETTINGS MODEL
// =============================================================================
model PaymentSettings {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(64)
  value       String   @db.VarChar(256)
  description String?  @db.VarChar(256)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   BigInt?  @map("updated_by")

  @@map("payment_settings")
}

// =============================================================================
// PROVIDER HEALTH MODEL (Phase 1)
// =============================================================================
model ProviderHealth {
  provider            String    @id
  status              String    @default("healthy")
  lastSuccess         DateTime? @map("last_success")
  lastFailure         DateTime? @map("last_failure")
  failureCount        Int       @default(0) @map("failure_count")
  avgResponseTime     Int?      @map("avg_response_time")
  circuitBreakerState String    @default("closed") @map("circuit_breaker_state")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("provider_health")
}

// =============================================================================
// PROMPT CACHE MODEL (Phase 1)
// =============================================================================
model PromptCache {
  id              Int       @id @default(autoincrement())
  promptHash      String    @unique @map("prompt_hash") @db.VarChar(32)
  rawPrompt       String    @map("raw_prompt") @db.Text
  provider        String    @db.VarChar(50)
  styleKey        String?   @map("style_key") @db.VarChar(100)
  optimizedPrompt String    @map("optimized_prompt") @db.Text
  tokenEstimate   Int?      @map("token_estimate")
  hitCount        Int       @default(0) @map("hit_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime? @map("expires_at")

  @@index([promptHash])
  @@index([expiresAt])
  @@map("prompt_cache")
}

// =============================================================================
// USER AVATAR MODEL (Persistent character/identity for consistent generation)
// =============================================================================
model UserAvatar {
  id          Int      @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  name        String   @db.VarChar(64)
  imageUrl    String   @map("image_url")
  localPath   String?  @map("local_path")
  description String?  @db.Text
  features    Json?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [telegramId])

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_avatars")
}

// =============================================================================
// PRICING CONFIG MODEL (Dynamic pricing — packages, subscriptions, provider costs)
// =============================================================================
model PricingConfig {
  id        Int      @id @default(autoincrement())
  category  String   @db.VarChar(32)
  key       String   @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy BigInt?  @map("updated_by")

  @@unique([category, key])
  @@index([category])
  @@map("pricing_config")
}

// =============================================================================
// SAVED PROMPTS — User custom prompt library
// =============================================================================
model SavedPrompt {
  id         Int      @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  title      String   @db.VarChar(100)
  prompt     String   @db.Text
  niche      String   @db.VarChar(32) // fnb, fashion, tech, etc
  source     String   @default("custom") @db.VarChar(16) // custom | library | daily
  sourceId   String?  @map("source_id") @db.VarChar(32) // original prompt id if from library
  usageCount Int      @default(0) @map("usage_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, niche])
  @@map("saved_prompts")
}

// =============================================================================
// GENERATION ANALYTICS MODEL (Phase 1)
// =============================================================================
model GenerationAnalytics {
  id               Int      @id @default(autoincrement())
  userId           BigInt   @map("user_id")
  jobId            String?  @map("job_id") @db.VarChar(255)
  niche            String?  @db.VarChar(50)
  styles           String[]
  providerUsed     String?  @map("provider_used") @db.VarChar(50)
  fallbackCount    Int      @default(0) @map("fallback_count")
  optimizationUsed Boolean  @default(false) @map("optimization_used")
  generationTimeMs Int?     @map("generation_time_ms")
  sceneCount       Int?     @map("scene_count")
  duration         Int?
  creditsUsed      Decimal? @map("credits_used") @db.Decimal(3, 1)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([niche])
  @@index([createdAt])
  @@map("generation_analytics")
}

// Token Usage Tracking
model TokenUsage {
  id               Int      @id @default(autoincrement())
  userId           BigInt?  @map("user_id")
  provider         String   @db.VarChar(50)
  model            String   @db.VarChar(100)
  service          String   @db.VarChar(50)
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @default(0) @map("total_tokens")
  costUsd          Float    @default(0) @map("cost_usd")
  costIdr          Float    @default(0) @map("cost_idr")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([provider])
  @@index([createdAt])
  @@map("token_usage")
}

// =============================================================================
// GAMIFICATION MODELS (v3.0)
// =============================================================================

model UserStreak {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt    @unique @map("user_id")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastGenerateDate DateTime? @map("last_generate_date") @db.Date
  streakStartDate  DateTime? @map("streak_start_date") @db.Date
  totalGenerates   Int       @default(0) @map("total_generates")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_streaks")
}

model UserBadge {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  badgeId   String   @map("badge_id") @db.VarChar(50)
  awardedAt DateTime @default(now()) @map("awarded_at")
  notified  Boolean  @default(false)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model RetentionLog {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  triggerType String   @map("trigger_type") @db.VarChar(50)
  sentAt      DateTime @default(now()) @map("sent_at")
  responded   Boolean  @default(false)

  @@index([userId])
  @@index([triggerType])
  @@index([sentAt])
  @@map("retention_logs")
}

// =============================================================================
// CHAT EVENT MODEL (Real-time event log for intercepted users)
// =============================================================================
model ChatEvent {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  eventType String   @map("event_type") @db.VarChar(32)
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("chat_events")
}

// =============================================================================
// TEMPLATE VIDEO MODEL (Pre-generated demo videos for free trial)
// =============================================================================
model TemplateVideo {
  id           BigInt   @id @default(autoincrement())
  niche        String   @db.VarChar(32)
  title        String   @db.VarChar(128)
  description  String?  @db.Text
  videoUrl     String   @map("video_url") @db.VarChar(512)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(512)
  duration     Int      @default(15)
  platform     String   @default("tiktok") @db.VarChar(16)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([niche, isActive])
  @@map("template_videos")
}

// =============================================================================
// VIDEO CLIP MODEL (Downloaded viral videos for reuse)
// =============================================================================
model VideoClip {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")

  // Source info
  sourceUrl      String  @map("source_url") @db.VarChar(1024)
  platform       String  @db.VarChar(32) // youtube, tiktok, instagram
  originalTitle  String? @map("original_title") @db.VarChar(255)
  originalAuthor String? @map("original_author") @db.VarChar(128)

  // Video details
  title       String? @db.VarChar(255)
  description String? @db.Text
  duration    Int // seconds
  width       Int?
  height      Int?

  // Storage
  localPath    String  @map("local_path") @db.VarChar(512)
  thumbnailUrl String? @map("thumbnail_url")
  fileSize     BigInt  @map("file_size")
  format       String  @default("mp4") @db.VarChar(16)

  // Metadata
  views         BigInt @default(0)
  likes         BigInt @default(0)
  viralityScore Int    @default(0) @map("virality_score")
  hashtags      Json? // string[]

  // Status
  status       String  @default("ready") @db.VarChar(16) // ready, processing, failed
  errorMessage String? @map("error_message")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expiresAt DateTime? @map("expires_at")

  // Relations
  user    User          @relation(fields: [userId], references: [telegramId])
  reworks VideoRework[]

  @@index([userId])
  @@index([platform])
  @@index([viralityScore])
  @@index([createdAt])
  @@map("video_clips")
}

// =============================================================================
// VIDEO REWORK MODEL (Anti-copyright transformations)
// =============================================================================
model VideoRework {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  clipId BigInt @map("clip_id")

  // Transform options applied
  mirror        Boolean @default(false)
  cropPercent   Int     @default(0)
  colorShift    Int     @default(0)
  brightness    Float   @default(1.0)
  contrast      Float   @default(1.0)
  saturation    Float   @default(1.0)
  speed         Float   @default(1.0)
  pitchShift    Int     @default(0)
  watermarkText String? @map("watermark_text")

  // Metadata changes
  newTitle       String? @map("new_title")
  newDescription String? @map("new_description")

  // Output
  outputPath String @map("output_path") @db.VarChar(512)
  fileSize   BigInt @map("file_size")

  // Copyright check
  copyrightRisk String @default("low") @map("copyright_risk") @db.VarChar(16)
  riskIssues    Json?  @map("risk_issues") // string[]

  // Status
  status       String  @default("completed") @db.VarChar(16)
  errorMessage String? @map("error_message")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  user User      @relation(fields: [userId], references: [telegramId])
  clip VideoClip @relation(fields: [clipId], references: [id])

  @@index([userId])
  @@index([clipId])
  @@index([createdAt])
  @@map("video_reworks")
}

// =============================================================================
// VIRAL SCAN MODEL (Cache viral video scans)
// =============================================================================
model ViralScan {
  id     BigInt @id @default(autoincrement())
  userId String @map("user_id")

  // Scan params
  query    String  @db.VarChar(255)
  platform String  @db.VarChar(32)
  niche    String? @db.VarChar(64)

  // Results
  resultCount Int   @default(0) @map("result_count")
  results     Json? // ViralVideo[]

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([query])
  @@index([createdAt])
  @@map("viral_scans")
}

// =============================================================================
// WHITELABEL BOT MODEL (Partner bots with custom branding)
// =============================================================================
model WhiteLabelBot {
  id          BigInt  @id @default(autoincrement())
  ownerId     BigInt  @map("owner_id") // telegramId of the partner
  uuid        String  @unique @default(uuid()) @db.Uuid
  botToken    String  @unique @map("bot_token") @db.VarChar(255)
  botUsername String? @map("bot_username") @db.VarChar(64)

  // Branding
  brandName   String  @map("brand_name") @db.VarChar(128)
  welcomeMsg  String? @map("welcome_msg") @db.Text
  logoUrl     String? @map("logo_url") @db.VarChar(512)

  // Commission
  commissionRate Decimal @default(0.30) @map("commission_rate") @db.Decimal(5, 4) // 30%
  totalEarned    Decimal @default(0) @map("total_earned") @db.Decimal(12, 2)
  totalWithdrawn Decimal @default(0) @map("total_withdrawn") @db.Decimal(12, 2)

  // Stats
  userCount  Int @default(0) @map("user_count")
  totalSales Decimal @default(0) @map("total_sales") @db.Decimal(12, 2)

  // Status
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  owner User @relation(fields: [ownerId], references: [telegramId])

  @@index([ownerId])
  @@index([botUsername])
  @@map("whitelabel_bots")
}

// =============================================================================
// YOUTUBE WORKFLOW MODELS (v4.0 — Multi-Niche Multi-Country Pipeline)
// =============================================================================

model YtChannel {
  id                String    @id @default(cuid())
  channelId         String    @unique @map("channel_id") @db.VarChar(64)
  gmailAccount      String?   @map("gmail_account") @db.VarChar(128)
  adsensePubId      String?   @map("adsense_pub_id") @db.VarChar(32)
  nicheVertical     String    @map("niche_vertical") @db.VarChar(32)
  nicheName         String?   @map("niche_name") @db.VarChar(128)
  productionFormat  String    @map("production_format") @db.VarChar(32)
  targetCountry     String?   @map("target_country") @db.VarChar(8)
  targetLanguage    String?   @map("target_language") @db.VarChar(8)
  cpmTier           String    @default("tier_D") @map("cpm_tier") @db.VarChar(8)
  ytOauthToken      String?   @map("yt_oauth_token") // encrypted at app layer
  tier              String    @default("tier_1_cold_start") @map("tier") @db.VarChar(32)
  totalPublished    Int       @default(0) @map("total_published")
  channelAgeDays    Int       @default(0) @map("channel_age_days")
  trafficStatus     String    @default("unproven") @map("traffic_status") @db.VarChar(16)
  isMasterChannel   Boolean   @default(false) @map("is_master_channel")
  masterChannelId   String?   @map("master_channel_id") @db.VarChar(64)
  trafficScore      Float?    @map("traffic_score")
  quarantineStarted DateTime? @map("quarantine_started")
  createdAt         DateTime  @default(now()) @map("created_at")
  setupComplete     Boolean   @default(false) @map("setup_complete")

  publishedVideos   YtPublishedVideo[]
  ideas             YtIdea[]
  quarantineLogs    YtQuarantineLog[]

  @@index([nicheVertical])
  @@index([trafficStatus])
  @@index([setupComplete])
  @@map("yt_channels")
}

model YtPublishedVideo {
  id               String    @id @default(cuid())
  videoId          String    @unique @map("video_id") @db.VarChar(64)
  channelId        String    @map("channel_id") @db.VarChar(64)
  channel          YtChannel @relation(fields: [channelId], references: [channelId])
  ideaId           String?   @map("idea_id") @db.VarChar(64)
  nicheVertical    String?   @map("niche_vertical") @db.VarChar(32)
  productionFormat String?   @map("production_format") @db.VarChar(32)
  title            String?   @db.VarChar(255)
  durationMinutes  Int?      @map("duration_minutes")
  tier             String?   @db.VarChar(16)
  toneVariant      String?   @map("tone_variant") @db.VarChar(32)
  publishedAt      DateTime? @map("published_at")
  monitoringStart  DateTime? @map("monitoring_start")
  status           String    @default("monitoring") @map("status") @db.VarChar(20)
  breakoutCluster  String?   @map("breakout_cluster")
  triageDecision   String?   @map("triage_decision") @db.VarChar(20)
  triageAt         DateTime? @map("triage_at")

  metrics          YtVideoMetrics[]

  @@index([channelId])
  @@index([status])
  @@index([publishedAt])
  @@map("yt_published_videos")
}

model YtIdea {
  id               String    @id @default(uuid())
  channelId        String    @map("channel_id") @db.VarChar(64)
  channel          YtChannel @relation(fields: [channelId], references: [channelId])
  nicheVertical    String?   @map("niche_vertical") @db.VarChar(32)
  productionFormat String?   @map("production_format") @db.VarChar(32)
  batchId          String?   @map("batch_id") @db.VarChar(64)
  titleDraft       String?   @map("title_draft") @db.VarChar(255)
  nicheCategory    String?   @map("niche_category") @db.VarChar(64)
  subNiche         String?   @map("sub_niche") @db.VarChar(64)
  hookType         String?   @map("hook_type") @db.VarChar(20)
  toneVariant      String?   @map("tone_variant") @db.VarChar(32)
  summary          String?   @db.Text
  genre            String?   @db.VarChar(64)
  mood             String?   @db.VarChar(32)
  visualStyle      String?   @map("visual_style") @db.VarChar(64)
  useCase          String?   @map("use_case") @db.VarChar(32)
  durationMinutes  Int?      @map("duration_minutes")
  potentialScore   String?   @map("potential_score") @db.VarChar(10)
  conflictVersions Boolean   @default(false) @map("conflict_versions")
  breakoutBias     Json?     @map("breakout_bias")
  priority         String    @default("NORMAL") @db.VarChar(10)
  status           String    @default("pending") @db.VarChar(16)
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([channelId])
  @@index([status])
  @@index([priority])
  @@map("yt_ideas")
}

model YtVideoMetrics {
  id          BigInt    @id @default(autoincrement())
  videoId     String    @map("video_id") @db.VarChar(64)
  video       YtPublishedVideo @relation(fields: [videoId], references: [videoId])
  checkAt     String    @map("check_at") @db.VarChar(10)
  views       Int?
  ctr         Float?
  avgViewPct  Float?    @map("avg_view_pct")
  avdSeconds  Int?      @map("avd_seconds")
  trafficSrc  Json?     @map("traffic_src")
  recordedAt  DateTime  @default(now()) @map("recorded_at")

  @@index([videoId])
  @@index([checkAt])
  @@map("yt_video_metrics")
}

model YtQuarantineLog {
  id               BigInt    @id @default(autoincrement())
  channelId        String    @map("channel_id") @db.VarChar(64)
  channel          YtChannel @relation(fields: [channelId], references: [channelId])
  action           String    @db.VarChar(16)
  triggerType      String?   @map("trigger_type") @db.VarChar(32)
  channelAgeDays   Int?      @map("channel_age_days")
  trafficDropPct   Float?    @map("traffic_drop_pct")
  recoveryPct      Float?    @map("recovery_pct")
  quarantineMonths Float?    @map("quarantine_months")
  details          Json?
  recordedAt       DateTime  @default(now()) @map("recorded_at")

  @@index([channelId])
  @@index([action])
  @@map("yt_quarantine_logs")
}

model YtNicheCpmResearch {
  id              BigInt    @id @default(autoincrement())
  researchDate    DateTime  @default(now()) @map("research_date")
  rawReport       Json?     @map("raw_report")
  cpmSnapshot     Json?     @map("cpm_snapshot")
  nicheAnalysis   Json?     @map("niche_analysis")
  crossNiche      Json?     @map("cross_niche")
  recommendations Json?
  appliedTo       String[]  @map("applied_to")

  @@index([researchDate])
  @@map("yt_niche_cpm_research")
}

model YtBreakoutCluster {
  id                   String    @id @default(uuid())
  channelId            String?   @map("channel_id") @db.VarChar(64)
  nicheVertical        String?   @map("niche_vertical") @db.VarChar(32)
  triggerVideoId       String?   @map("trigger_video_id") @db.VarChar(64)
  primaryElement       String?   @map("primary_element") @db.VarChar(128)
  secondaryElements    Json?     @map("secondary_elements")
  storyType            String?   @map("story_type") @db.VarChar(32)
  genreMood            String?   @map("genre_mood") @db.VarChar(32)
  toneVariant          String?   @map("tone_variant") @db.VarChar(32)
  trafficDriver        String?   @map("traffic_driver") @db.VarChar(16)
  bestDurationTier     String?   @map("best_duration_tier") @db.VarChar(16)
  active               Boolean   @default(true)
  revisitScheduledAt   DateTime? @map("revisit_scheduled_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([channelId])
